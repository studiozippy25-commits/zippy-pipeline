function putHistoryImageToStoryboard(img, preferredOrder) {
  if (!img || !img.b64) return false;
  if (typeof sbRefs === 'undefined' || !sbRefs || !Object.keys(sbRefs).length) return false;

  const allKeys = Object.keys(sbRefs);
  const fallbackOrder = ['char1', 'char2', 'char3', 'cos1', 'cos2', 'cos3', 'face1', 'face2', 'face3', 'loc1', 'loc2', 'loc3', 'loc4', 'obj'];
  const orderedKeys = (Array.isArray(preferredOrder) && preferredOrder.length) ? preferredOrder.concat(fallbackOrder) : fallbackOrder;

  let target = orderedKeys.find(function(k) {
    return allKeys.indexOf(k) !== -1 && !sbRefs[k];
  });
  if (!target) target = allKeys.find(function(k) { return /^((char|cos|face|loc|obj)-?|obj)/.test(k); });
  if (!target) return false;

  const mime = img.mime || 'image/png';
  const cap = target.charAt(0).toUpperCase() + target.slice(1);
  const el = document.getElementById('sbRef' + cap);

  sbRefs[target] = img.b64;
  sbRefMimes[target] = mime;
  if (el) {
    el.innerHTML = '<img src="data:' + mime + ';base64,' + img.b64 + '" style="width:100%;height:100%;object-fit:cover">';
  }
  return true;
}

