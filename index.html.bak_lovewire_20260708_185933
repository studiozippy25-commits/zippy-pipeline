  '50mm':'F1.8','85mm':'F1.8','135mm':'F4'
};
const LENS_APER_PROMPT = {
  '18mm':'f/11','24mm':'f/4','35mm':'f/2.8',
  '50mm':'f/2.0','85mm':'f/1.8','135mm':'f/2.8'
};

function pickCharCard(card) {
  document.querySelectorAll('.char-card').forEach(c => c.classList.remove('on'));
  card.classList.add('on');
  const dna = card.dataset.dna || '';
  const preview = document.getElementById('char-dna-preview');
  const dnaText = document.getElementById('char-dna-text');
  if (preview && dnaText) { dnaText.textContent = dna; preview.style.display = dna ? 'block' : 'none'; }
}
function getCharDNA() {
  const card = document.querySelector('.char-card.on');
  return card ? (card.dataset.dna || '') : '';
}
function pickSingle(el,group){
  const wasOn=el.classList.contains('on');
  document.querySelectorAll(`[data-g="${group}"]`).forEach(c=>c.classList.remove('on'));
  if(!wasOn){
    el.classList.add('on');
    if(group==='lens') autoSelectAper(el.textContent.replace('★','').trim());
    if(group==='aper'){
      const hint=document.getElementById('aperAutoHint');
      if(hint) hint.style.display='none';
    }
  }
  updateBreadcrumb();
}

function autoSelectAper(lens){
  const target=LENS_APER_MAP[lens];
  if(!target) return;
  document.querySelectorAll('[data-g="aper"]').forEach(c=>{
    c.classList.toggle('on', c.textContent.replace('★','').trim()===target);
  });
  const hint=document.getElementById('aperAutoHint');
  if(hint){ hint.style.display='block'; hint.textContent='* 렌즈 선택에 따른 권장값이 자동 선택됩니다 ('+lens+' → '+LENS_APER_PROMPT[lens]+')'; }
}
function toggleChip(el){ el.classList.toggle('on'); }
function pickType(el){
  document.querySelectorAll('.stype').forEach(c=>c.classList.remove('on'));
  el.classList.add('on');
}
function getSelected(group,multi=false){
  const chips=[...document.querySelectorAll(`[data-g="${group}"].on`)];
  if(multi) return chips.map(c=>(c.dataset.ch||c.textContent).replace('★','').trim());
  return chips.length?(chips[0].dataset.ch||chips[0].textContent).replace('★','').trim():'';
}
function updateBreadcrumb(){
  const char=getSelected('char'),loc=getSelected('loc'),shot=getSelected('shot');
  document.getElementById('breadcrumb').textContent=[char,loc,shot].filter(Boolean).join(' / ');
}

