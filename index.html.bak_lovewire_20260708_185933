          const msg = er.error || ('HTTP ' + res.status);
          if ((res.status === 404 || res.status === 405) && getGtiBridgeCandidateUrls().length > 1) {
            lastError = new Error(msg);
            continue;
          }
          throw new Error('gti 생성 실패: ' + msg);
        }
        const data = await res.json();
        if (!data.imgB64) throw new Error('gti 응답에 이미지 없음');
        rememberGtiBridgeUrl(base);
        return { imgB64: data.imgB64 };
      } catch(e) {
        if (e && (e.name === 'AbortError' || /abort/i.test(e.message || ''))) throw e;
        lastError = e;
      }
    }
