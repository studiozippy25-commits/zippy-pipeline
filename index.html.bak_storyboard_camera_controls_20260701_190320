// Ollama /api/chat (채팅 템플릿 처리, thinking 모델 대응, 이미지 멀티모달 지원)
async function callOllama({prompt, images=[], model=null, signal=null, options={}}) {
  const host = getOllamaHost();
  const mdl = model || getOllamaModel();
  const message = {role: 'user', content: prompt};
  if (images && images.length) {
    // Ollama chat: images:[base64] 형식
    message.images = images.map(img => (typeof img === 'string') ? img : img.b64);
  }
  const body = {
    model: mdl,
    messages: [message],
    stream: false,
    options: Object.assign({temperature: 0.7, num_ctx: 8192, num_predict: 2048}, options)
  };
  const fetchOpts = {method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(body)};
  if (signal) fetchOpts.signal = signal;
  const res = await fetch(host + '/api/chat', fetchOpts);
  if (!res.ok) {
    const e = await res.json().catch(()=>({}));
    throw new Error(e?.error || `Ollama HTTP ${res.status}`);
  }
  const data = await res.json();
  // gemma4 같은 thinking 모델은 message.thinking과 message.content 분리
  const content = data?.message?.content || '';
  return { textOut: content, imgB64: null, thinking: data?.message?.thinking || '' };
}
/* 통합 텍스트 호출 래퍼 — 모드에 따라 Gemini 또는 Ollama */
async function callGPTChat({images=[], prompt, signal=null, options={}}) {
  const mdl = (document.getElementById('gptLlmModel') && document.getElementById('gptLlmModel').value) || 'gpt-5.4';
  let content = prompt;
  if (images && images.length) {
    content = [{type:'text', text: prompt}];
    images.forEach(function(img){ var url = (typeof img==='string') ? img : ('data:'+(img.mime||'image/png')+';base64,'+img.b64); content.push({type:'image_url', image_url:{url: url}}); });
  }
  const fetchOpts = {method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({model: mdl, messages:[{role:'user', content: content}]})};
  if (signal) fetchOpts.signal = signal;
  const res = await fetch('https://pipeline.studiozippy25.workers.dev/proxy/openai/chat/completions', fetchOpts);
  if (!res.ok) { const e = await res.json().catch(()=>({})); throw new Error((e&&e.error&&e.error.message) || ('OpenAI HTTP ' + res.status)); }
  const data = await res.json();
  return { imgB64: null, textOut: (data && data.choices && data.choices[0] && data.choices[0].message && data.choices[0].message.content) || '' };
}
async function callLLM({images=[], prompt, signal=null, options={}}) {
  const mode = getLLMMode();
  if (mode === 'local') {
    return await callOllama({prompt, images, signal, options});
  }
  if (mode === 'gpt') {
    return await callGPTChat({images, prompt, signal, options});
  }
  // cloud: Gemini 호출 (텍스트 전용)
  return await callGemini({images, prompt, textOnly: true, signal});
}
