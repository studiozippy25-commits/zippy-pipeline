      return {
        index:i + 1,
        name:item.label || item.name || '',
        source:item.source || '',
        type:item.type,
        media:mediaNames ? mediaNames[i] : premiereClipFileName(item, i),
        start_seconds:start,
        duration_seconds:dur,
        caption:item.caption || ''
