async function generateSBSequence(shotId) {
  const shot = SB_SHOTS.find(function(s){ return s.id === shotId; });
  if (!shot) return;
  const phases = [
    'FRAME 1 of 3 — BEGINNING: the setup instant just before the main action begins. Establish the space.',
    'FRAME 2 of 3 — PEAK: the single decisive instant of the action at its height.',
    'FRAME 3 of 3 — AFTERMATH: the immediate result / reaction right after the action, same spot.'
  ];
  const _idc = shot.id.replace(/[^a-z0-9]/gi,'-');
  const emptyEl = document.querySelector('#sb-shot-' + _idc + ' .sb-shot-empty');
  const statusEl = document.getElementById('sbseq-' + _idc);
  function _setStat(m){ if(statusEl) statusEl.textContent=m; if(emptyEl){ emptyEl.textContent=m; emptyEl.style.cursor='wait'; } sbShowLoading(shotId, m); }
  _setStat('🎞 흐름 3컷 생성 시작...');
  const seq = []; let cont = [];
  try {
    for (let i = 0; i < 3; i++) {
      _setStat('🎞 흐름 ' + (i+1) + '/3 생성 중... (동일 공간 유지)');
      const b64 = await generateSBShot(shotId, { phase: phases[i], cont: cont, returnOnly: true });
      if (!b64) break;
      seq.push(b64);
      if (i === 0) cont = [{ b64: b64, mime: 'image/png', _type: 'background', _label: '이전 프레임 — 동일 공간/셋 그대로 유지' }];
    }
    if (seq.length) {
      sbSeqImages[shotId] = seq;
      sbGenImages[shotId] = seq[0];
      buildStoryboardTimeline();
    } else {
      throw new Error('생성 결과 없음');
    }
  } catch(e) {
    alert('흐름 3컷 생성 실패 (' + shotId + '): ' + e.message);
    if (emptyEl) { emptyEl.textContent = '+ 생성'; emptyEl.style.cursor='pointer'; }
    sbHideLoading(shotId);
  }
}
