function sbGroupChipLabel(num) {
  // Episode-based projects (have epTitles) → "EP01 제목"; scene-based projects (e.g. proof-of-taste) → "S1"
  var et = currentProject && currentProject.epTitles;
  if (!et) return 'S' + num;
  if (et[num] && num < 0) return et[num];
  return 'EP' + ('0'+num).slice(-2) + ' ' + (et[num] || ('EP'+num));
}

function refreshEpSelector() {
  if (!currentProject || !currentProject.storyboardShots || currentProject.storyboardShots.length === 0) return;
  var sbEpSelector = document.getElementById('sbEpSelector');
  var sbEpChips = document.getElementById('sbEpChips');
  if (!sbEpSelector || !sbEpChips) return;
  var epSet = {};
  var hasEpField = currentProject.storyboardShots.length > 0 && typeof currentProject.storyboardShots[0].ep !== 'undefined';
  currentProject.storyboardShots.forEach(function(s) {
    var key = hasEpField ? s.ep : s.scene;
    epSet[key] = (epSet[key]||0)+1;
  });
  var epNums = Object.keys(epSet).map(Number).sort(function(a,b){return a-b;});
  if (epNums.length > 6) {
    sbEpSelector.style.display = 'block';
    var html = '<button class="chip on" style="font-size:11px;padding:6px 12px" onclick="filterSBEp(0,this)">전체 (' + currentProject.storyboardShots.length + ')</button>';
    epNums.forEach(function(ep) {
      html += '<button class="chip" style="font-size:11px;padding:6px 12px" onclick="filterSBEp('+ep+',this)">'+sbGroupChipLabel(ep)+' <span style="opacity:.5;font-size:10px">('+epSet[ep]+')</span></button>';
    });
    sbEpChips.innerHTML = html;
