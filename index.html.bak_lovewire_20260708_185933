function collectStoryboardDownloadItems() {
  const items = [];
  const used = {};
  const shots = (typeof SB_SHOTS !== 'undefined' && Array.isArray(SB_SHOTS)) ? SB_SHOTS : [];
  function safe(v) {
    return (typeof premiereSafeName === 'function')
      ? premiereSafeName(v)
      : String(v || 'shot').replace(/[\\/:*?"<>|#%{}^~[\]`]+/g, '_').replace(/\s+/g, '_').slice(0, 80);
  }
  function addItem(shot, id, b64, path, kind, seqIndex) {
    if (!b64) return;
    items.push({
      id,
      path,
      kind,
      seqIndex,
      b64,
      shot: shot ? {
        id: shot.id || id,
        ep: shot.ep,
        scene: shot.scene,
        sceneName: shot.sceneName || '',
        frame: shot.frame || '',
        desc: shot.desc || '',
        func: shot.func || '',
        loc: shot.loc || '',
        time: shot.time || '',
        pri: shot.pri || ''
      } : { id }
    });
  }
  shots.forEach(function(shot, index) {
    const id = String(shot.id || ('SHOT_' + (index + 1)));
    const base = String(index + 1).padStart(3, '0') + '_' + safe(id);
    const seq = (typeof sbSeqImages !== 'undefined' && Array.isArray(sbSeqImages[id])) ? sbSeqImages[id] : null;
    used[id] = true;
    if (seq && seq.length) {
      seq.forEach(function(b64, seqIndex) {
        addItem(shot, id, b64, 'sequences/' + base + '_' + String(seqIndex + 1).padStart(2, '0') + '.png', 'sequence', seqIndex + 1);
      });
    } else if (typeof sbGenImages !== 'undefined' && sbGenImages[id]) {
      addItem(shot, id, sbGenImages[id], 'images/' + base + '.png', 'image', null);
    }
  });
  if (typeof sbGenImages !== 'undefined') {
    Object.keys(sbGenImages).sort().forEach(function(id) {
      if (used[id]) return;
      addItem(null, id, sbGenImages[id], 'images/orphans/' + safe(id) + '.png', 'image', null);
    });
  }
  if (typeof sbSeqImages !== 'undefined') {
    Object.keys(sbSeqImages).sort().forEach(function(id) {
      if (used[id] || !Array.isArray(sbSeqImages[id])) return;
      sbSeqImages[id].forEach(function(b64, seqIndex) {
        addItem(null, id, b64, 'sequences/orphans/' + safe(id) + '_' + String(seqIndex + 1).padStart(2, '0') + '.png', 'sequence', seqIndex + 1);
      });
    });
  }
  return items;
}
