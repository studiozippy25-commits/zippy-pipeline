const assetLib = { char:[], 'space-a':[], 'space-b':[], 'space-c':[], 'space-d':[], obj:[], 'obj-card':[], 'obj-menu':[], 'obj-show':[], 'obj-blot':[], 'obj-etc':[] };
function addAsset(cat, files) {
  if (!files || !files.length) return;
  [...files].forEach(f => {
    const reader = new FileReader();
    reader.onload = e => {
      const b64 = e.target.result.split(',')[1];
      const mime = f.type;
      assetLib[cat].push({b64, mime, name:f.name});
      renderAssetGrid(cat);
      updateAssetCounts();
    };
    reader.readAsDataURL(f);
  });
}
function renderAssetGrid(cat) {
  const grid = document.getElementById('asset-'+cat+'-grid');
  if (!grid) return;
  grid.innerHTML = assetLib[cat].map((a,i) => `
    <div class="titem">
      <img src="data:${a.mime};base64,${a.b64}" alt="${a.name}">
      <div class="tlbl">${a.name}</div>
      <div class="tdel" onclick="removeAsset('${cat}',${i})">×</div>
    </div>
  `).join('') || '<div class="tg-empty">—</div>';
}
function removeAsset(cat, idx) {
  assetLib[cat].splice(idx, 1);
  renderAssetGrid(cat);
  updateAssetCounts();
}
function updateAssetCounts() {
  const ce = document.getElementById('asset-char-count');
  const se = document.getElementById('asset-space-count');
  const oe = document.getElementById('asset-obj-count');
  if(ce) ce.textContent = assetLib.char.length + '개 등록';
  // Sum all space-* buckets (legacy a/b/c/d + dynamic 1..N)
  let spaceTotal = 0;
  Object.keys(assetLib).forEach(k => { if (k.indexOf('space-') === 0) spaceTotal += (assetLib[k]||[]).length; });
  if(se) se.textContent = spaceTotal + '개 등록';
  const objTotal = assetLib.obj.length + (assetLib['obj-card']||[]).length + (assetLib['obj-menu']||[]).length + (assetLib['obj-show']||[]).length + (assetLib['obj-blot']||[]).length + (assetLib['obj-etc']||[]).length;
  if(oe) oe.textContent = objTotal + '개 등록';
}
function getAssetImages(category) {
  if (category === 'space') {
    return [...assetLib['space-a'],...assetLib['space-b'],...assetLib['space-c'],...assetLib['space-d']];
  }
  return assetLib[category] || [];
}
function getMatchingSpaceAssets(locName) {
  const loc = (locName||'').toLowerCase();
  if (!loc || !currentProject) return [];
  const locNames = currentProject.spaceNames || currentProject.locations || [];
  for (let i = 0; i < locNames.length; i++) {
    const projLoc = (locNames[i]||'').toLowerCase();
    if (!projLoc) continue;
    const tokens = projLoc.replace(/\([^)]+\)/g,'').split(/[\s·,\-/]+/).filter(t=>t.length>=2);
    if (projLoc === loc || loc.includes(projLoc) || projLoc.includes(loc) || tokens.some(t=>loc.includes(t))) {
      const k = 'space-' + (i+1);
      if (assetLib[k] && assetLib[k].length > 0) return assetLib[k];
    }
  }
  return [];
}

function getMatchingSpaceSheetAssets(locName, shot) {
  if (!currentProject || !currentProject.defaultSpaceSheets) return [];
  const entries = Object.keys(currentProject.defaultSpaceSheets);
  const loc = (locName || '').toLowerCase();
  const shotId = shot && shot.id ? String(shot.id) : '';
  const ep = shot && typeof shot.ep !== 'undefined' ? Number(shot.ep) : null;
  const text = ((shot && ((shot.desc || '') + ' ' + (shot.frame || '') + ' ' + (shot.sceneName || ''))) || '').toLowerCase();
  const out = [];

  function addByLabel(label) {
    const idx = entries.indexOf(label);
    if (idx === -1) return;
    const key = 'spacesheet-' + (idx + 1);
    if (!assetLib[key] || assetLib[key].length === 0) return;
    assetLib[key].forEach(function(a) {
      out.push({b64: a.b64, mime: a.mime, name: label + ' 공간시트'});
    });
  }

  if (ep === 7 && /^SH(30[8-9]|31[0-7])$/.test(shotId)) addByLabel('EP7 VR·LAST SHOT 교차 구도');
  if (ep === 12 && /^SH(63[4-9]|64[0-7])$/.test(shotId)) addByLabel('EP12 최심부·N시 송출 구도');

  entries.forEach(function(label, idx) {
    if (out.some(function(a){ return a.name === label + ' 공간시트'; })) return;
    const normalizedLabel = label.toLowerCase().replace(/ep\d+[^\s]*/g, '');
    const tokens = normalizedLabel.split(/[\s·,\-/()]+/).filter(function(t){
      return t.length >= 2 && ['공간시트','구도','내부','방'].indexOf(t) === -1;
    });
    if (tokens.length === 0) return;
    const hitCount = tokens.filter(function(t){ return loc.indexOf(t) !== -1 || text.indexOf(t) !== -1; }).length;
    if (hitCount >= Math.min(2, tokens.length)) {
      const key = 'spacesheet-' + (idx + 1);
      if (assetLib[key] && assetLib[key].length > 0) {
        assetLib[key].forEach(function(a) {
          out.push({b64: a.b64, mime: a.mime, name: label + ' 공간시트'});
        });
      }
    }
  });
  return out.slice(0, 2);
}

