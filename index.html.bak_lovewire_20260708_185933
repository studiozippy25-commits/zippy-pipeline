    countEl.textContent = epNum === 0 ? '전체 ' + shown + '쇼트' : sbGroupChipLabel(epNum) + ' — ' + shown + '쇼트';
  }

  // Update title
  var sbTitleEl = document.getElementById('sbTitle');
  if (sbTitleEl && currentProject) {
    if (epNum === 0) {
      var maxScene = 0;
      if (currentProject.storyboardShots) currentProject.storyboardShots.forEach(function(s) {
        var unit = (typeof s.ep !== 'undefined') ? s.ep : s.scene;
        if (unit > maxScene) maxScene = unit;
