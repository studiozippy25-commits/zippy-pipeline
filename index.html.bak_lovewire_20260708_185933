    if (!clean || seen.has(clean)) return;
    seen.add(clean);
    out.push(clean);
  };
  try {
    if (typeof currentProject !== 'undefined' && currentProject) {
      if (currentProject.characterPresets) Object.keys(currentProject.characterPresets).forEach(add);
      if (Array.isArray(currentProject.characters)) currentProject.characters.forEach(function(c){ add(typeof c === 'string' ? c : (c?.name || c?.id)); });
      if (Array.isArray(currentProject.cast)) currentProject.cast.forEach(function(c){ add(typeof c === 'string' ? c : (c?.name || c?.id)); });
