async function vbGenBatch() {
  if (!vbDidInit) vbInitVoiceTab();
  const lines = (vb$('vbBatchText')?.value || '').split('\n').map(function(v){ return v.trim(); }).filter(Boolean);
  const items = [];
  lines.forEach(function(line) {
