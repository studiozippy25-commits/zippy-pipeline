    const paging = document.getElementById('googlePaging');
    let pagingHtml = '';
    if (start > 1) pagingHtml += '<button class="ca-pre" onclick="searchGoogle(' + (start - 10) + ')">← 이전</button>';
    pagingHtml += '<span style="font-family:var(--font-mono);font-size:11px;color:var(--mu);align-self:center">페이지 ' + googlePage + '</span>';
    if (start + 10 <= totalResults && googlePage < 10) pagingHtml += '<button class="ca-pre" onclick="searchGoogle(' + (start + 10) + ')">다음 →</button>';
    paging.innerHTML = pagingHtml;

  } catch(e) {
