  document.getElementById('relightOutput').textContent = '조명: ' + dirH + ' ' + dirV + ', ' + (tempLabels[tempIdx]||'중립') + ', ' + (intLabels[intensity]||'보통') + ' 강도';

  drawRelightSphere();
}

