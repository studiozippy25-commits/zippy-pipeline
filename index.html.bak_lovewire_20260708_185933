function zippyAssetEsc(v) {
  return String(v == null ? '' : v)
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;');
}

function renderProjectReferenceGallery() {
  const section = document.getElementById('projectRefAssetSection');
  const countEl = document.getElementById('asset-projectref-count');
  const container = document.getElementById('asset-projectref-container');
  if (!section || !countEl || !container) return;
  const refs = (currentProject && currentProject.allAssetRefs) || [];
  if (!refs.length) {
    section.style.display = 'none';
    countEl.textContent = '0개';
    container.innerHTML = '';
    return;
  }
  section.style.display = '';
  countEl.textContent = refs.length + '개';
  container.innerHTML = refs.map(function(ref) {
    const no = String(ref.no || '').padStart(3, '0');
    const file = ref.file || '';
    const label = (no ? no + ' · ' : '') + file.replace(/\.[^.]+$/, '');
    const category = ref.category || ref.kind || '';
    const url = ref.url || '';
    return '<div class="titem" title="' + zippyAssetEsc(file) + '">' +
      '<img src="' + zippyAssetEsc(url) + '" alt="' + zippyAssetEsc(label) + '" loading="lazy" decoding="async">' +
      '<div class="tlbl">' + zippyAssetEsc(label) + '</div>' +
      '<div class="tlbl" style="opacity:.65">' + zippyAssetEsc(category) + '</div>' +
      '</div>';
  }).join('');
}

function selectProject(key) {
