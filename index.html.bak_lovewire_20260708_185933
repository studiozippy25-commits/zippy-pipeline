// Ollama /api/chat (채팅 템플릿 처리, thinking 모델 대응, 이미지 멀티모달 지원)
async function callOllama({prompt, images=[], model=null, signal=null, options={}}) {
  const host = getOllamaHost();
  const mdl = model || getOllamaModel();
  const message = {role: 'user', content: prompt};
  if (images && images.length) {
    // Ollama chat: images:[base64] 형식
    message.images = images.map(img => (typeof img === 'string') ? img : img.b64);
  }
  const body = {
    model: mdl,
    messages: [message],
    stream: false,
    options: Object.assign({temperature: 0.7, num_ctx: 8192, num_predict: 2048}, options)
  };
  const fetchOpts = {method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(body)};
  if (signal) fetchOpts.signal = signal;
  const res = await fetch(host + '/api/chat', fetchOpts);
  if (!res.ok) {
    const e = await res.json().catch(()=>({}));
    throw new Error(e?.error || `Ollama HTTP ${res.status}`);
  }
  const data = await res.json();
  // gemma4 같은 thinking 모델은 message.thinking과 message.content 분리
  const content = data?.message?.content || '';
  return { textOut: content, imgB64: null, thinking: data?.message?.thinking || '' };
}
