  if (typeof value === 'string') return value.length > 240 && /^[A-Za-z0-9+/=]+$/.test(value.slice(0, 240)) ? '[base64 omitted: ' + value.length + ' chars]' : value;
  if (Array.isArray(value)) return value.map(function(v) { return zippyNasStripB64(v, (depth || 0) + 1); });
  if (typeof value === 'object') {
    const out = {};
    Object.keys(value).forEach(function(k) {
      if (/^(b64|imgB64|genImages|seqImages)$/i.test(k)) {
        if (typeof value[k] === 'string') out[k] = '[base64 omitted: ' + value[k].length + ' chars]';
        else if (value[k] && typeof value[k] === 'object') out[k] = Object.keys(value[k]);
