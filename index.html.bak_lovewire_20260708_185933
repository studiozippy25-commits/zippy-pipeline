const insGenImages = {};
let insCurrentFilter = 'all';

function renderInsertLibrary() {
  const grid = document.getElementById('insGrid');
  if (!grid) return;
  var _insSec = document.getElementById('insLibSection');
  var _isPoT = (typeof currentProject !== 'undefined') && currentProject && currentProject.name === '취향의 증거';
  if (_insSec) _insSec.style.display = _isPoT ? '' : 'none';
  if (!_isPoT) { grid.innerHTML = ''; return; }
  const filtered = insCurrentFilter === 'all' ? INSERT_CUTS : INSERT_CUTS.filter(i => i.cat === insCurrentFilter);
  grid.innerHTML = filtered.map(function(ins) {
    const genImg = insGenImages[ins.id];
    const srcUrl = ins.src ? 'assets/proof-of-taste/inserts/' + ins.src.split('/').map(s => encodeURIComponent(s)).join('/') : '';
    let html = '<div class="sb-shot" id="ins-' + ins.id + '">';
    html += '<div class="sb-shot-hdr"><span class="sb-shot-id">' + ins.id + '</span><span class="sb-shot-pri opt" style="background:rgba(8,145,178,.15);color:var(--cy)">' + ins.cat + '</span></div>';
    if (genImg) {
      // AI 재생성 결과
      html += '<img class="sb-shot-img" src="data:image/png;base64,' + genImg + '" onclick="openLightbox(\'' + genImg + '\')">';
      html += '<div style="display:flex;gap:4px;margin-top:6px"><button class="hist-card-btn" onclick="dlInsImg(\'' + ins.id + '\')">↓</button><button class="hist-card-btn" onclick="generateInsCut(\'' + ins.id + '\')" style="border-color:var(--cy);color:var(--cy)">↻ 재생성</button><button class="hist-card-btn" onclick="delInsImg(\'' + ins.id + '\')" style="border-color:var(--er);color:var(--er)">✕</button></div>';
    } else if (srcUrl) {
      // 원본 소스 이미지 표시 (AI 미생성 상태)
      html += '<img class="sb-shot-img" src="' + srcUrl + '" onclick="openLightbox(this.src)" style="cursor:pointer">';
      html += '<div style="display:flex;gap:4px;margin-top:6px"><button class="hist-card-btn" onclick="generateInsCut(\'' + ins.id + '\')" style="border-color:var(--cy);color:var(--cy)">✨ AI 변형</button></div>';
    } else {
      html += '<div class="sb-shot-empty" onclick="generateInsCut(\'' + ins.id + '\')">+ 생성</div>';
    }
    html += '<div class="sb-shot-info"><strong>' + ins.frame + '</strong></div>';
    html += '<div class="sb-shot-desc">' + ins.label + '</div>';
    html += '<div style="font-family:var(--font-mono);font-size:10px;color:var(--mu);margin-top:3px">' + ins.desc + '</div>';
    html += '</div>';
    return html;
  }).join('');
}

function filterInsCat(cat, btn) {
  insCurrentFilter = cat;
  document.querySelectorAll('#pIns .btn.bgh').forEach(b => b.style.background = '');
  if (btn) btn.style.background = 'rgba(8,145,178,.15)';
  renderInsertLibrary();
}

async function generateInsCut(insId) {
  const ins = INSERT_CUTS.find(i => i.id === insId);
  if (!ins) return;
  const card = document.getElementById('ins-' + insId);
  const empty = card?.querySelector('.sb-shot-empty');
  if (empty) { empty.textContent = '생성 중...'; empty.style.cursor = 'wait'; }
  try {
    // 원본 소스 이미지를 1순위 레퍼런스로 추가
    const refs = [];
    if (ins.src) {
      const srcUrl = 'assets/proof-of-taste/inserts/' + ins.src;
      const srcImg = await fetchImageAsB64(srcUrl);
      if (srcImg) refs.push({b64: srcImg.b64, mime: srcImg.mime, _type:'reference', _label: ins.label + ' 원본'});
    }
    // 인물 ref 자동 매칭 (cat 기반)
    const charNames = currentProject && currentProject.characterPresets ? Object.keys(currentProject.characterPresets) : [];
    const catCharMap = {jungwoo: '정우', hayoon: '하윤'};
    const targetChar = catCharMap[ins.cat];
    if (targetChar) {
      const idx = charNames.findIndex(n => n.startsWith(targetChar));
      if (idx >= 0 && sbRefs['char' + (idx+1)]) {
        refs.push({b64: sbRefs['char' + (idx+1)], mime: sbRefMimes['char' + (idx+1)], _type:'character', _label: targetChar});
      }
      if (idx >= 0 && sbRefs['cos' + (idx+1)]) {
        refs.push({b64: sbRefs['cos' + (idx+1)], mime: sbRefMimes['cos' + (idx+1)], _type:'costume', _label: targetChar + ' 의상'});
      }
    }
    // 소품 ref 자동 매칭 (propKey 또는 prop 카테고리)
    if (ins.propKey && sbRefs[ins.propKey]) {
      refs.push({b64: sbRefs[ins.propKey], mime: sbRefMimes[ins.propKey], _type:'prop', _label: ins.label});
    }
    // 카페 카테고리 → LP 소품 자동 매칭
    if (ins.cat === 'cafe' && sbRefs['obj-lp']) {
      refs.push({b64: sbRefs['obj-lp'], mime: sbRefMimes['obj-lp'], _type:'prop', _label: 'LP'});
    }
    // 밤 카테고리 → 우산 소품 자동 매칭
    if (ins.cat === 'night' && sbRefs['obj-umbrella']) {
      refs.push({b64: sbRefs['obj-umbrella'], mime: sbRefMimes['obj-umbrella'], _type:'prop', _label: '젖은 우산'});
    }
    const safeRefs = isProofOfTasteProject()
      ? await prepareProofOfTasteRefsForGeneration(refs, { frame: ins.frame, desc: ins.desc, func: ins.label }, { maxRefs: 3, maxSide: 640, quality: 0.74, byteBudget: 6 * 1024 * 1024, fallbackMaxSide: 480, fallbackQuality: 0.66 })
      : refs;
    const moodGuide = safeRefs.length > 0 ? 'REFERENCE HANDLING:\nReferences may include grid moodboards. Do NOT replicate grid layout. Do NOT include text/labels. Extract mood/color/material only.\n\n' : '';
    const prompt = moodGuide + 'CINEMATIC INSERT CUT — ' + ins.id + '\n\nFRAME: ' + ins.frame + '\nDETAIL: ' + ins.desc + '\n\nSTYLE: Cinematic film still, ARRI ALEXA 35, Kodak Vision3 500T, photorealistic, visible texture detail, shallow depth of field. Single complete frame, no border, no watermark, no text overlay.';
    const { imgB64 } = await callImageGen({images: safeRefs, prompt: prompt, resVal: '1K'});
    if (!imgB64) throw new Error('이미지 없음');
    insGenImages[insId] = imgB64;
    renderInsertLibrary();
  } catch(e) {
    alert('인서트 생성 실패: ' + e.message);
    if (empty) { empty.textContent = '+ 생성'; empty.style.cursor = 'pointer'; }
  }
}

function dlInsImg(insId) {
  const b64 = insGenImages[insId];
  if (!b64) return;
  const a = document.createElement('a');
  a.href = 'data:image/png;base64,' + b64;
  a.download = 'INSERT_' + insId + '_' + Date.now() + '.png';
  a.click();
}

function delInsImg(insId) {
  if (!confirm('이 인서트의 생성된 이미지를 삭제할까요?')) return;
  delete insGenImages[insId];
  renderInsertLibrary();
}

