  } else if (sbFrameHas(rawFrame, ['투샷', 'TWO SHOT', 'TWO-SHOT'])) {
    variants.push(lens + ' two-shot at chest level, 1.8m distance, subjects separated by foreground practical object');
  } else if (sbFrameHas(rawFrame, ['미디엄', 'MS'])) {
    variants.push(lens + ' at chest level, 1.5m distance, subject on right third, foreground obstruction from wall edge or doorframe');
  } else if (sbFrameHas(rawFrame, ['익스트림 와이드', '와이드', '풀샷', 'WIDE', 'WS', 'FULL SHOT', 'FS'])) {
    variants.push(lens + ' wide camera 3-6m from subject, environment fills most of frame, foreground architecture creates depth layers');
  } else if (sbFrameHas(rawFrame, ['POV'])) {
    variants.push(lens + ' first-person POV at eye-level, handheld micro-tremor, slight forward lean');
  } else {
    variants.push('Use only the camera placement implied by the storyboard frame text; no generic eye-level / 35mm fallback.');
  }

  if (sbFrameHas(rawFrame, ['로우앵글', 'LOW ANGLE'])) {
    variants.push(' + camera below subject eye line, looking up 18-30°');
  } else if (sbFrameHas(rawFrame, ['하이앵글', '부감', 'HIGH ANGLE', 'OVERHEAD'])) {
    variants.push(' + camera above subject, looking down 25-60°');
  } else if (sbFrameHas(rawFrame, ['측면', '사이드', 'SIDE'])) {
    variants.push(' + side-profile blocking, lateral composition');
  } else if (sbFrameHas(rawFrame, ['백샷', 'BACK SHOT'])) {
    variants.push(' + rear camera position, subject back facing camera');
  }

  if (desc.indexOf('손') !== -1 || desc.indexOf('hand') !== -1) {
    variants.push(' + emphasize hand action with shallow DOF f/2.0');
  }
  if (desc.indexOf('걸음') !== -1 || desc.indexOf('이동') !== -1 || desc.indexOf('지나간') !== -1) {
    variants.push(' + tracking parallel to subject motion, dolly speed matched to walk');
  }
  if (desc.indexOf('멈춤') !== -1 || desc.indexOf('정지') !== -1) {
    variants.push(' + locked tripod, no camera movement, capture micro-stillness');
  }

  return variants.join('');
}
