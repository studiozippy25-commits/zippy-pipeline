// base64 이미지를 ComfyUI input 폴더에 업로드 → 파일명 반환
async function uploadImageToComfy(b64, mime='image/png', signal=null) {
  const hosts = getComfyHostCandidates();
  const bin = atob(b64);
  const arr = new Uint8Array(bin.length);
  for (let i = 0; i < bin.length; i++) arr[i] = bin.charCodeAt(i);
  const ext = mime.includes('jpeg') ? '.jpg' : mime.includes('webp') ? '.webp' : '.png';
  const filename = 'zippy_' + Date.now() + '_' + Math.random().toString(36).slice(2, 8) + ext;
  const blob = new Blob([arr], {type: mime});
  const form = new FormData();
  form.append('image', blob, filename);
  form.append('type', 'input');
  form.append('overwrite', 'true');
  let lastError = null;
  const tried = [];
  for (const host of hosts) {
    tried.push(host);
    try {
      const res = await fetch(host + '/upload/image', {method:'POST', headers:getLocal5080GatewayHeaders(), body: form, signal});
      if (!res.ok) {
        const errText = await res.text().catch(()=>'');
        throw new Error('HTTP ' + res.status + ' @ ' + host + ' : ' + (errText || 'Upload failed'));
      }
      const data = await res.json();
      return data.name || filename;
    } catch (e) {
      if (e && e.name === 'AbortError') throw e;
      lastError = e;
    }
  }
  throw new Error('업로드 실패 (' + tried.join(' → ') + '). ' + ((lastError && lastError.message) || 'Failed to fetch'));
}

