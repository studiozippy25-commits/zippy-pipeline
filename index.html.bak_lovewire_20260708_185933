async function premiereDownloadPackage() {
  if (!premiereItems.length) { alert('먼저 컷을 추가하세요'); return; }
  const btn = document.getElementById('premierePackageBtn');
  const status = document.getElementById('premiereStatus');
  if (btn) { btn.disabled = true; btn.textContent = '패키징 중...'; }
  if (status) status.textContent = 'Premiere 패키지 생성 중...';
  try {
    const mediaNames = premiereItems.map(premiereClipFileName);
    const texts = premiereGeneratedTexts(mediaNames);
    const entries = [
      {name:'zippy_roughcut.fcpxml', data:premiereTextBytes(texts.fcpxml)},
      {name:'zippy_roughcut.edl', data:premiereTextBytes(texts.edl)},
      {name:'captions.srt', data:premiereTextBytes(texts.srt)},
      {name:'markers.csv', data:premiereTextBytes(texts.markers)},
      {name:'manifest.json', data:premiereTextBytes(texts.manifest)},
      {name:'README.md', data:premiereTextBytes(texts.readme)}
    ];
    if (premiereSettings().includeMedia) {
      for (let i = 0; i < premiereItems.length; i++) {
        try {
          const bytes = await premiereItemBytes(premiereItems[i]);
          entries.push({name:'media/' + mediaNames[i], data:bytes});
          if (status) status.textContent = '미디어 포함 중... ' + (i + 1) + ' / ' + premiereItems.length;
        } catch(e) {
          entries.push({name:'media/MISSING_' + mediaNames[i] + '.txt', data:premiereTextBytes('Could not include media: ' + (e.message || e))});
        }
      }
    }
    const zip = premiereBuildZip(entries);
    premiereDownloadBlob(new Blob([zip], {type:'application/zip'}), premiereSafeName(premiereSettings().projectName) + '_premiere_package.zip');
    if (status) status.textContent = '패키지 생성 완료 · ' + entries.length + ' files';
  } catch(e) {
    if (status) status.textContent = '패키지 실패: ' + (e.message || e);
  } finally {
    if (btn) { btn.disabled = false; btn.textContent = 'Premiere 패키지 다운로드'; }
  }
}
async function premiereItemBytes(item) {
  if (item.file) return new Uint8Array(await item.file.arrayBuffer());
  if (item.b64) return premiereBase64Bytes(item.b64);
  if (item.url) {
    const res = await fetch(item.url);
    if (!res.ok) throw new Error('fetch failed ' + res.status);
    return new Uint8Array(await res.arrayBuffer());
  }
  throw new Error('no media data');
}
function premiereBuildZip(entries) {
  const locals = [];
  const centrals = [];
  let offset = 0;
  const now = new Date();
  const dt = premiereDosDateTime(now);
  entries.forEach(function(entry) {
    const nameBytes = premiereTextBytes(entry.name);
    const data = entry.data instanceof Uint8Array ? entry.data : new Uint8Array(entry.data || []);
    const crc = premiereCrc32(data);
    const local = premiereZipHeader(0x04034b50, [
      [2,20], [2,0x0800], [2,0], [2,dt.time], [2,dt.date], [4,crc], [4,data.length], [4,data.length], [2,nameBytes.length], [2,0]
    ]);
    locals.push(local, nameBytes, data);
    const central = premiereZipHeader(0x02014b50, [
      [2,20], [2,20], [2,0x0800], [2,0], [2,dt.time], [2,dt.date], [4,crc], [4,data.length], [4,data.length], [2,nameBytes.length], [2,0], [2,0], [2,0], [2,0], [4,0], [4,offset]
    ]);
    centrals.push(central, nameBytes);
    offset += local.length + nameBytes.length + data.length;
  });
  const centralStart = offset;
  const centralSize = centrals.reduce(function(a,b){return a + b.length;}, 0);
  const end = premiereZipHeader(0x06054b50, [[2,0],[2,0],[2,entries.length],[2,entries.length],[4,centralSize],[4,centralStart],[2,0]]);
  return premiereConcat(locals.concat(centrals, [end]));
}
function premiereZipHeader(sig, fields) {
  const len = 4 + fields.reduce(function(a,f){return a + f[0];}, 0);
  const out = new Uint8Array(len);
  const dv = new DataView(out.buffer);
  let p = 0;
  dv.setUint32(p, sig, true); p += 4;
  fields.forEach(function(f) {
    if (f[0] === 2) { dv.setUint16(p, f[1] & 0xffff, true); p += 2; }
    else { dv.setUint32(p, f[1] >>> 0, true); p += 4; }
  });
  return out;
}
function premiereDosDateTime(d) {
  const year = Math.max(1980, d.getFullYear());
  return {
    time: (d.getHours() << 11) | (d.getMinutes() << 5) | Math.floor(d.getSeconds() / 2),
    date: ((year - 1980) << 9) | ((d.getMonth() + 1) << 5) | d.getDate()
  };
}
function premiereCrc32(bytes) {
  if (!premiereCrcTable) {
    premiereCrcTable = [];
    for (let n = 0; n < 256; n++) {
      let c = n;
      for (let k = 0; k < 8; k++) c = (c & 1) ? (0xedb88320 ^ (c >>> 1)) : (c >>> 1);
      premiereCrcTable[n] = c >>> 0;
    }
  }
  let crc = 0xffffffff;
  for (let i = 0; i < bytes.length; i++) crc = premiereCrcTable[(crc ^ bytes[i]) & 0xff] ^ (crc >>> 8);
  return (crc ^ 0xffffffff) >>> 0;
}
function premiereConcat(parts) {
  const total = parts.reduce(function(a,b){return a + b.length;}, 0);
  const out = new Uint8Array(total);
  let p = 0;
  parts.forEach(function(part){ out.set(part, p); p += part.length; });
  return out;
}
function premiereTextBytes(text) { return new TextEncoder().encode(String(text == null ? '' : text)); }
function premiereBase64Bytes(b64) {
  const bin = atob(String(b64).replace(/^data:[^,]+,/, ''));
  const out = new Uint8Array(bin.length);
  for (let i = 0; i < bin.length; i++) out[i] = bin.charCodeAt(i);
  return out;
}
function premiereDownloadBlob(blob, name) {
  const a = document.createElement('a');
  a.href = URL.createObjectURL(blob);
  a.download = name;
  document.body.appendChild(a);
  a.click();
  setTimeout(function(){ URL.revokeObjectURL(a.href); a.remove(); }, 200);
}
function premiereEsc(v) { return String(v == null ? '' : v).replace(/[&<>"']/g, function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[c];}); }
function premiereEscAttr(v) { return premiereEsc(v); }
function premiereXml(v) { return premiereEsc(v); }
function premiereCsv(v) { return '"' + String(v == null ? '' : v).replace(/"/g, '""').replace(/\n+/g, ' / ') + '"'; }

