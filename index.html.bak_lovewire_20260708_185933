async function generateStoryboardBatch(scope) {
  const isAll = scope === 'all';
  const sourceShots = isAll ? SB_SHOTS : SB_SHOTS.filter(s=>s.pri==='must');
  const remaining = sourceShots.filter(s=>!sbGenImages[s.id]);
  const label = isAll ? '전체 쇼트' : '필수 쇼트';
  if(remaining.length===0){alert(label + '가 이미 모두 생성되었습니다.');return;}
  const btn = document.getElementById(isAll ? 'btnSBAllShots' : 'btnSBAll');
  const otherBtn = document.getElementById(isAll ? 'btnSBAll' : 'btnSBAllShots');
  const stopBtn = document.getElementById('btnSBStop');
  const progress = document.getElementById('sbProgress');
  if (btn) btn.disabled = true;
  if (otherBtn) otherBtn.disabled = true;
  if (stopBtn) stopBtn.style.display = 'inline-block';
  window.__sbAllAborted = false;
  document.getElementById('sbLoadingWrap').style.display = 'block';
  for(let i=0; i<remaining.length; i++){
    if (window.__sbAllAborted) break;
    const msg = `${remaining[i].id} 생성 중... (${i+1}/${remaining.length}) · ${label}`;
    document.getElementById('sbLoadStatus').textContent = msg;
    if (progress) progress.textContent = `${label} ${i+1} / ${remaining.length}`;
    await generateSBShot(remaining[i].id);
    await new Promise(r=>setTimeout(r,500));
  }
  document.getElementById('sbLoadStatus').textContent = window.__sbAllAborted ? '중단됨' : label + ' 생성 완료!';
  if (btn) btn.disabled = false;
  if (otherBtn) otherBtn.disabled = false;
  if (stopBtn) stopBtn.style.display = 'none';
  window.__sbAllAborted = false;
  saveStoryboardState(isAll ? 'all-shots-generated' : 'must-shots-generated');
  setTimeout(()=>{document.getElementById('sbLoadingWrap').style.display='none';},2000);
}
