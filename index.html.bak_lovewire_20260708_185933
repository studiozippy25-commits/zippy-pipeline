  const buildPayload = function(refs, note) {
    const prefix = buildImageRefManifestForPrompt(refs);
    return {
      prompt: (note || '') + prefix + prompt,
      size: size,
      images: (refs || []).map(function(im) { return { b64: im.b64, mime: im.mime || 'image/png' }; })
    };
  };
  let body;
  try {
    body = JSON.stringify(buildPayload(bridgeImages));
  } catch(e) {
    if (!isStringLimitError(e)) throw e;
    console.warn('GTI payload hit browser string limit; retrying with one compressed reference.', e);
    bridgeImages = await prepareImageRefsForJsonBridge(sourceImages, {
      maxRefs: 1,
      maxSide: 320,
      quality: 0.56,
      byteBudget: 900 * 1024,
      singleRefMaxBytes: 900 * 1024,
      fallbackMaxSide: 256,
      fallbackQuality: 0.52,
      hardInputMaxBytes: 18 * 1024 * 1024,
      skipBelowBytes: 0
    });
    try {
      body = JSON.stringify(buildPayload(bridgeImages, 'REFERENCE PAYLOAD SAFETY MODE: image references were reduced because the browser payload was too large. Follow all textual identity, face, outfit, place, and continuity locks with maximum priority.\n\n'));
    } catch(e2) {
      if (!isStringLimitError(e2)) throw e2;
      bridgeImages = [];
      body = JSON.stringify(buildPayload([], 'REFERENCE PAYLOAD EMERGENCY MODE: image references were omitted because the browser payload was too large. Follow all textual identity, face, outfit, place, and continuity locks with maximum priority.\n\n'));
    }
  }
  let lastError = null;
  const tried = [];
  for (let attempt = 0; attempt < 2; attempt++) {
    for (const base of getGtiBridgeCandidateUrls()) {
