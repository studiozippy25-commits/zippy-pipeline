}
function ccToggle(btn) { btn.classList.toggle('on'); updateCCPreview(); }
function ccPick(btn) {
  const group = btn.dataset.cc;
  document.querySelectorAll(`[data-cc="${group}"]`).forEach(b=>b.classList.remove('on'));
  btn.classList.add('on'); updateCCPreview();
}
function getCC(group, multi) {
  const sels = [...document.querySelectorAll(`[data-cc="${group}"].on`)];
  if (!sels.length) return '';
  return multi ? sels.map(b=>b.dataset.en).join(', ') : (sels[0]?.dataset.en||'');
}
function updateCCPreview() {
  const eth=getCC('eth',true),gender=getCC('gender'),age=getCC('age'),
        height=getCC('height'),build=getCC('build'),head=getCC('head'),
        face=getCC('face'),eyes=getCC('eyes'),iris=getCC('iris'),skin=getCC('skin'),
        hcol=getCC('hcol'),hlen=getCC('hlen'),hstyle=getCC('hstyle'),
        feat=(document.getElementById('cc-feature')||{}).value||'',world=getCC('world');
  const parts=[];
  if(eth) parts.push(eth+(eth.includes(',')?' mixed heritage':''));
  if(gender) parts.push(gender);
  if(age) parts.push(age);
  if(world&&world!=='human') parts.push(world);
  if(height) parts.push(height);
  if(build) parts.push(build);
  if(head) parts.push(head);
  const fd=[face,eyes,iris,skin].filter(Boolean);
  if(fd.length) parts.push('Face: '+fd.join(', '));
  const hd=[hcol,hlen,hstyle+' hair'].filter(Boolean);
  if(hd.length) parts.push('Hair: '+hd.join(', '));
