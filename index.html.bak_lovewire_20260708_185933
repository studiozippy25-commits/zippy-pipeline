}

async function fetchImageAsB64(url) {
  try {
    // URL-encode each path segment (handles Korean filenames); preserve ?query (cache-bust)
    const _qi = url.indexOf('?');
    const _path = _qi === -1 ? url : url.slice(0, _qi);
    const _query = _qi === -1 ? '' : url.slice(_qi);
    const encoded = _path.split('/').map(s => s.indexOf(':') !== -1 ? s : encodeURIComponent(s)).join('/') + _query;
    const res = await fetch(encoded);
    if (!res.ok) { console.warn('Fetch HTTP error:', res.status, encoded); return null; }
    const blob = await res.blob();
    const mime = blob.type || 'image/png';
    return await new Promise((resolve) => {
      const fr = new FileReader();
      fr.onload = () => resolve({b64: fr.result.split(',')[1], mime: mime});
      fr.readAsDataURL(blob);
    });
  } catch(e) { console.warn('Default ref fetch failed:', url, e.message); return null; }
}

