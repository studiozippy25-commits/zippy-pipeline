var ccOpen = true;
function toggleCC() {
  ccOpen = !ccOpen;
  document.getElementById('cc-body').style.display = ccOpen ? 'block' : 'none';
  document.getElementById('cc-arrow').textContent = ccOpen ? '▲' : '▼';
