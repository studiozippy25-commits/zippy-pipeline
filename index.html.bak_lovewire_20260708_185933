  let offset = 0;
  premiereItems.forEach(function(item, i) {
    t += String(i + 1).padStart(2, '0') + '  ' + premiereTimecode(offset, s.fpsInt) + '  ' + premiereTimecode(offset + Number(item.duration || 1), s.fpsInt) + '  ' + (item.label || item.name || '') + '\n';
