async function addGoogleToMB(imageUrl, title) {
  try {
    // Try to fetch the image (may fail due to CORS)
    const res = await fetch(imageUrl, {mode: 'cors'}).catch(() => null);
    if (res && res.ok) {
      const blob = await res.blob();
      const reader = new FileReader();
      reader.onload = function(e) {
        mbImages.push({
          b64: e.target.result.split(',')[1],
          mime: blob.type || 'image/jpeg',
          name: 'google_' + (title || '').replace(/\s/g, '_').substring(0, 20),
          dataUrl: e.target.result
        });
        renderMBGrid();
        document.getElementById('mbCount').style.color = 'var(--ok)';
        setTimeout(function() { document.getElementById('mbCount').style.color = ''; }, 500);
      };
      reader.readAsDataURL(blob);
    } else {
      // CORS blocked - use proxy approach or show the image URL
      // Fallback: create an img element to load it
      const img = new Image();
      img.crossOrigin = 'anonymous';
      img.onload = function() {
        const canvas = document.createElement('canvas');
        canvas.width = img.naturalWidth;
        canvas.height = img.naturalHeight;
        const ctx = canvas.getContext('2d');
        ctx.drawImage(img, 0, 0);
        try {
          const dataUrl = canvas.toDataURL('image/jpeg', 0.85);
          mbImages.push({
            b64: dataUrl.split(',')[1],
            mime: 'image/jpeg',
            name: 'google_' + (title || '').replace(/\s/g, '_').substring(0, 20),
            dataUrl: dataUrl
          });
          renderMBGrid();
        } catch(e) {
          // Canvas tainted - open in new tab for manual save
          window.open(imageUrl, '_blank');
          alert('CORS 제한으로 직접 추가 불가. 새 탭에서 이미지를 저장 후 수동으로 업로드하세요.');
        }
      };
      img.onerror = function() {
        window.open(imageUrl, '_blank');
        alert('이미지 로드 실패. 새 탭에서 직접 저장 후 업로드하세요.');
      };
      img.src = imageUrl;
    }
  } catch(e) {
    window.open(imageUrl, '_blank');
    alert('이미지 추가 실패. 새 탭에서 저장 후 수동 업로드하세요.');
  }
}

