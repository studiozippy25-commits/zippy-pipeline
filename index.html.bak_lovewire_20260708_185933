async function loadDefaultObjRefs() {
  if (!currentProject || !currentProject.defaultObjRefs) return;
  const objAssets = currentProject.objectAssets || [];
  let loadedCount = 0;
  for (const obj of objAssets) {
    const url = currentProject.defaultObjRefs[obj.key];
    if (!url) continue;
    const img = await fetchImageAsB64(url);
    if (!img) continue;
    // 스토리보드 소품 슬롯
    if (!sbRefs[obj.key]) {
      sbRefs[obj.key] = img.b64;
      sbRefMimes[obj.key] = img.mime;
      const cap = obj.key.charAt(0).toUpperCase() + obj.key.slice(1);
      const el = document.getElementById('sbRef' + cap);
      if (el) el.innerHTML = '<img src="data:' + img.mime + ';base64,' + img.b64 + '" style="width:100%;height:100%;object-fit:cover">';
    }
    // Asset Library 소품 슬롯
    if (typeof assetLib !== 'undefined' && assetLib[obj.key]) {
      if (!assetLib[obj.key].some(a => a.name === obj.name)) {
        assetLib[obj.key].push({b64: img.b64, mime: img.mime, name: obj.name, source: 'default'});
      }
      if (typeof renderAssetGrid === 'function') renderAssetGrid(obj.key);
    }
    loadedCount++;
  }
  if (loadedCount > 0) {
    if (typeof buildStoryboardTimeline === 'function') buildStoryboardTimeline();
    if (typeof updateAssetCounts === 'function') updateAssetCounts();
  }
  console.log('[loadDefaultObjRefs] Loaded:', loadedCount);
}

