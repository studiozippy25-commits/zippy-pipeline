function filterSBEp(epNum, btn) {
  // Toggle chip active state
  var chips = document.querySelectorAll('#sbEpChips .chip');
  chips.forEach(function(c) { c.classList.remove('on'); });
  if (btn) btn.classList.add('on');

  // Filter timeline scene groups
  var timeline = document.getElementById('sbTimelineInner');
  if (!timeline) return;
  // 단일 에피소드 뷰 / 전체 뷰 레이아웃 토글
  if (epNum === 0) {
    timeline.classList.remove('single-ep-view');
  } else {
    timeline.classList.add('single-ep-view');
  }
  // data-ep 우선, 없으면 data-scene 사용 (하위 호환)
  var epGroups = timeline.querySelectorAll('.sb-scene[data-ep]');
  if (epGroups.length === 0) epGroups = timeline.querySelectorAll('.sb-scene[data-scene]');
  var shown = 0;
  epGroups.forEach(function(group) {
    var epVal = parseInt(group.getAttribute('data-ep') || group.getAttribute('data-scene'));
    if (epNum === 0 || epVal === epNum) {
      group.style.display = '';
      var shots = group.querySelectorAll('.sb-shot');
      shown += shots.length;
    } else {
      group.style.display = 'none';
    }
  });

  // Update count
  var countEl = document.getElementById('sbEpCount');
  if (countEl) {
    countEl.textContent = epNum === 0 ? '전체 ' + shown + '쇼트' : sbGroupChipLabel(epNum) + ' — ' + shown + '쇼트';
  }

  // Update title
  var sbTitleEl = document.getElementById('sbTitle');
  if (sbTitleEl && currentProject) {
    if (epNum === 0) {
      var maxScene = 0;
      if (currentProject.storyboardShots) currentProject.storyboardShots.forEach(function(s) { if (s.scene > maxScene) maxScene = s.scene; });
      sbTitleEl.textContent = 'STORYBOARD — ' + currentProject.name + ' · ' + maxScene + (currentProject.episodeLabel || '씬') + ' · ' + currentProject.storyboardShots.length + '쇼트';
    } else {
      sbTitleEl.textContent = 'STORYBOARD — ' + sbGroupChipLabel(epNum) + ' · ' + shown + '쇼트';
    }
  }
}

async function fetchImageAsB64(url) {
  try {
    // URL-encode each path segment (handles Korean filenames); preserve ?query (cache-bust)
    const _qi = url.indexOf('?');
    const _path = _qi === -1 ? url : url.slice(0, _qi);
    const _query = _qi === -1 ? '' : url.slice(_qi);
    const encoded = _path.split('/').map(s => s.indexOf(':') !== -1 ? s : encodeURIComponent(s)).join('/') + _query;
    const res = await fetch(encoded);
    if (!res.ok) { console.warn('Fetch HTTP error:', res.status, encoded); return null; }
    const blob = await res.blob();
    const mime = blob.type || 'image/png';
    return await new Promise((resolve) => {
      const fr = new FileReader();
      fr.onload = () => resolve({b64: fr.result.split(',')[1], mime: mime});
      fr.readAsDataURL(blob);
    });
  } catch(e) { console.warn('Default ref fetch failed:', url, e.message); return null; }
}

