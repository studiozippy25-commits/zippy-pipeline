async function expandSBShot(shotId) {
  const shot = SB_SHOTS.find(s => s.id === shotId);
  if (!shot) return;
  let preset = SCENE_PRESETS[String(shot.scene)] || {};
  if ((typeof shot.ep !== 'undefined' && shot.ep < 0) || shot.loc) preset = {};
  const charDNAList = currentProject && currentProject.characterDNA ? Object.keys(currentProject.characterDNA).join(', ') : '';
  const prompt = `Expand this storyboard shot into a detailed cinematic shot description for AI image generation.

CONTEXT:
- Project: ${currentProject.name}
- Scene location: ${preset.loc || ''}
- Scene time: ${preset.time || ''}
- (씬 전체 narrative 사용 안 함 — 쇼트별 디테일만)
- Available characters: ${charDNAList}

CURRENT SHOT (${shot.id}):
- Frame: ${shot.frame}
- Description: ${shot.desc}
- Function: ${shot.func || ''}

TASK: Rewrite the shot description with concrete visual details for THIS specific shot ONLY (not the entire scene). Include:
- Subject placement and posture (specific to this frame)
- Camera angle and distance details
- Foreground / midground / background composition
- Specific gestures, micro-actions, gaze direction
- Visible props or surfaces in frame
- Light direction and quality (specific to this moment)
- Atmospheric details (dust, particles, reflections)

OUTPUT: A single Korean paragraph (3-5 sentences, max 250 characters) that another AI can use as a precise visual prompt. Do NOT include scene narrative beyond this shot. Do NOT mention timing seconds. Be visually specific.`;

  const btn = document.querySelector('#sb-shot-' + shot.id.replace(/[^a-z0-9]/gi,'-') + ' .sb-expand-btn');
  if (btn) { btn.disabled = true; btn.textContent = '확장 중...'; }
  try {
    const { textOut } = await callGeminiTextOnly(prompt);
    const expanded = (textOut || '').trim();
    if (expanded) {
      shot.desc = expanded;
      buildStoryboardTimeline();
    }
  } catch(e) {
    alert('확장 실패: ' + e.message);
    if (btn) { btn.disabled = false; btn.textContent = '✨ AI 확장'; }
  }
}

function deleteSBImage(shotId) {
  if (!confirm('이 쇼트의 생성된 이미지를 삭제할까요?')) return;
  delete sbGenImages[shotId];
  buildStoryboardTimeline();
}

function renderShotCard(shot, sceneVal) {
  const imgKey = shot.id;
  const hasImg = sbGenImages[imgKey];
  const ms = getSBRefMatchSummary(shot.scene, shot.id);
  const badge = '<span title="' + ms.labels.join(' · ') + '" style="display:inline-flex;gap:4px;font-family:var(--font-mono);font-size:9px;color:var(--mu);margin-left:6px">' +
    (ms.character ? '<span style="color:var(--or)">👤'+ms.character+'</span>' : '') +
    (ms.costume ? '<span style="color:var(--pu)">👗'+ms.costume+'</span>' : '') +
    (ms.background ? '<span style="color:var(--bl)">🏞'+ms.background+'</span>' : '') +
    (ms.prop ? '<span style="color:var(--gr)">📦'+ms.prop+'</span>' : '') + '</span>';
  let html = `<div class="sb-shot" data-scene="${sceneVal}" id="sb-shot-${shot.id.replace(/[^a-z0-9]/gi,'-')}">`;
  html += `<div class="sb-shot-hdr"><span class="sb-shot-id">${shot.id}</span>${badge}<span class="sb-shot-pri ${shot.pri}">${shot.pri==='must'?'필수':'선택'}</span></div>`;
  if (typeof sbSeqImages!=='undefined' && sbSeqImages[imgKey] && sbSeqImages[imgKey].length) {
    html += seq3up(imgKey);
  } else if (hasImg) {
    html += `<img class="sb-shot-img" src="data:image/png;base64,${hasImg}" onclick="openSBLightbox('${imgKey}')">`;
    html += `<div class="refine-wrap" data-imgb64="${hasImg}" data-imgmime="image/png" style="margin-bottom:6px"><div style="display:flex;gap:4px"><input type="text" class="refine-input" placeholder="수정..." style="flex:1;padding:4px 8px;border:1px solid var(--bd);font-size:11px;border-radius:4px;outline:none;font-family:var(--font-body)"><button onclick="refineImage(this)" style="padding:4px 8px;border:1px solid var(--bl);background:rgba(14,165,233,.08);color:var(--bl);font-family:var(--font-mono);font-size:10px;border-radius:4px;cursor:pointer;white-space:nowrap">⟳</button><button class="hist-card-btn" onclick="event.stopPropagation();sendSBToVideo('${imgKey}')" style="border-color:var(--pu);color:var(--pu)">→ 영상</button><button class="hist-card-btn" onclick="event.stopPropagation();deleteSBImage('${imgKey}')" style="border-color:var(--er);color:var(--er)" title="이미지 삭제">✕</button></div></div>`;
  } else {
    html += `<div class="sb-shot-empty" onclick="generateSBShot('${imgKey}')">+ 생성</div>`;
  }
  html += `<div class="sbseq-status" id="sbseq-${shot.id.replace(/[^a-z0-9]/gi,'-')}" style="font-family:var(--font-mono);font-size:11px;color:var(--or);font-weight:700;margin:3px 0"></div>`;
  html += `<div class="sb-shot-info"><strong>${shot.frame}</strong></div>`;
  html += `<div class="sb-shot-desc">${shot.desc}</div>`;
  html += `<div style="font-family:var(--font-mono);font-size:10px;color:var(--cy);margin-top:3px">${shot.func||''}</div>`;
  html += `<div style="margin-top:5px"><div style="font-family:var(--font-mono);font-size:9px;color:var(--bl);margin-bottom:2px">📍 장소 (선택)</div><select onchange="setShotLoc('${shot.id}', this.value)" style="width:100%;padding:5px 8px;border:1px solid var(--bd);background:rgba(14,165,233,.04);color:var(--tx);font-family:var(--font-mono);font-size:10px;border-radius:4px;outline:none">${sbLocOptions(resolveShotLoc(shot))}</select></div>`;
  html += renderSBCameraControl(shot);
  html += `<button onclick="event.stopPropagation();generateSBSequence('${shot.id}')" style="margin-top:4px;width:100%;padding:5px;border:1px solid var(--or);background:rgba(245,158,11,.06);color:var(--or);font-family:var(--font-mono);font-size:10px;border-radius:4px;cursor:pointer;font-weight:600">\uD83C\uDF9E \uD750\uB984 3\uCEF7 \uC0DD\uC131 (\uB3D9\uC77C \uACF5\uAC04)</button>`;
  html += `<button class="sb-expand-btn" onclick="event.stopPropagation();expandSBShot('${shot.id}')" style="margin-top:6px;width:100%;padding:5px;border:1px solid var(--cy);background:rgba(8,145,178,.06);color:var(--cy);font-family:var(--font-mono);font-size:10px;border-radius:4px;cursor:pointer;font-weight:600">✨ AI 디테일 확장</button>`;
  html += `<button onclick="event.stopPropagation();genVideoPrompt('${shot.id}')" style="margin-top:4px;width:100%;padding:5px;border:1px solid var(--pu);background:rgba(124,58,237,.06);color:var(--pu);font-family:var(--font-mono);font-size:10px;border-radius:4px;cursor:pointer;font-weight:600">프롬프트 보기</button>`;
  html += `</div>`;
  return html;
}

