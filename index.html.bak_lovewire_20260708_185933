      if(dna) dna.textContent='인물 고정값이 여기에 표시됩니다.';
      if(out) out.innerHTML='<span>6전도 시트 대기</span>';
      setStatus('인물 레퍼런스를 삭제했습니다. 필요하면 인물 DNA/6전도 시트를 다시 생성하세요.');
    }
    renderThumbs(kind);
    saveInstagramState('ref-removed');
  };
  function resetOutfitSheet(message){
    state.outfitVersion++;
    state.outfitSheet=null;
    state.outfitSheetPromise=null;
    state.outfitDna='';
    const dna=document.getElementById('ipOutfitDna');
    if(dna) dna.textContent='의상 분석값이 여기에 표시됩니다.';
    renderOutfitSheet();
    if(message) setStatus(message);
  }
  function ipStateDBName(){
    let key='default';
    try{
      key=(typeof currentProjectKey!=='undefined'&&currentProjectKey)||window.currentProjectKey||'default';
    }catch(e){}
    key=String(key||'default').replace(/[^\w-]+/g,'_');
    return 'studioZIPPY_'+key+'_InstagramPersonaState';
  }
  function openIPStateDB(){
    return new Promise(function(resolve,reject){
      if(ipStateDB){resolve(ipStateDB);return;}
      if(!window.indexedDB){reject(new Error('IndexedDB unavailable'));return;}
      const req=indexedDB.open(ipStateDBName(),IP_STATE_DB_VER);
      req.onupgradeneeded=function(e){
        const db=e.target.result;
        if(!db.objectStoreNames.contains(IP_STATE_STORE)) db.createObjectStore(IP_STATE_STORE,{keyPath:'key'});
      };
      req.onsuccess=function(e){
        ipStateDB=e.target.result;
        ipStateDB.onversionchange=function(){try{ipStateDB.close();}catch(err){} ipStateDB=null;};
        resolve(ipStateDB);
      };
      req.onerror=function(){reject(req.error);};
    });
  }
  function ipImageForPersist(img){
    if(!img) return null;
    return {
      name:img.name||'',
      mime:img.mime||'image/png',
      b64:img.b64||'',
      url:img.url||((img.b64)?('data:'+(img.mime||'image/png')+';base64,'+img.b64):''),
      _type:img._type||'',
      _label:img._label||img.name||''
    };
  }
  function ipNormalizeImage(img){
    if(!img||!img.b64) return null;
    const mime=img.mime||'image/png';
    return {
      name:img.name||'image.png',
      mime:mime,
      b64:img.b64,
      url:img.url||('data:'+mime+';base64,'+img.b64),
      _type:img._type||'',
      _label:img._label||img.name||''
    };
  }
  function ipReadControls(){
    return {
      locMode:document.getElementById('ipLocMode')?.value||state.locMode,
      location:document.getElementById('ipLocation')?.value||'0',
      vibe:document.getElementById('ipVibe')?.value||'daily',
      outfitStrength:document.getElementById('ipOutfitStrength')?.value||'standard',
      count:document.getElementById('ipCount')?.value||'10',
      customPrompt:document.getElementById('ipCustomPrompt')?.value||''
    };
  }
  function ipApplyControls(ctrl){
    if(!ctrl) return;
    const locMode=document.getElementById('ipLocMode');
    if(locMode&&ctrl.locMode){locMode.value=ctrl.locMode;state.locMode=ctrl.locMode;renderLocs();}
    const loc=document.getElementById('ipLocation');
    if(loc&&ctrl.location!=null) loc.value=String(ctrl.location);
    const vibe=document.getElementById('ipVibe');
    if(vibe&&ctrl.vibe) vibe.value=ctrl.vibe;
    const strength=document.getElementById('ipOutfitStrength');
    if(strength&&ctrl.outfitStrength) strength.value=ctrl.outfitStrength;
    const count=document.getElementById('ipCount');
    if(count&&ctrl.count!=null) count.value=String(ctrl.count);
    const custom=document.getElementById('ipCustomPrompt');
    if(custom&&ctrl.customPrompt!=null) custom.value=ctrl.customPrompt;
  }
  function bindInstagramControlPersistence(){
    if(window.__zippyIpControlPersistBound) return;
    window.__zippyIpControlPersistBound=true;
    ['ipLocMode','ipLocation','ipVibe','ipOutfitStrength','ipCount','ipCustomPrompt'].forEach(function(id){
      const el=document.getElementById(id);
      if(!el) return;
      let timer=null;
      const ev=id==='ipCustomPrompt'?'input':'change';
      el.addEventListener(ev,function(){
        clearTimeout(timer);
        timer=setTimeout(function(){saveInstagramState('control-change');},250);
      });
    });
  }
  function ipSnapshot(){
    const results=(state.results||[]).map(function(r){
      if(r&&r.pending) return {idx:r.idx,loc:r.loc||'',prompt:r.prompt||'',error:'페이지 이동으로 생성 상태가 중단됨'};
      return {
        idx:r?.idx,
        loc:r?.loc||'',
        prompt:r?.prompt||'',
        mime:r?.mime||'image/png',
        b64:r?.b64||'',
        error:r?.error||null
      };
    });
    return {
      person:state.person.map(ipImageForPersist).filter(Boolean),
      outfit:state.outfit.map(ipImageForPersist).filter(Boolean),
      place:state.place.map(ipImageForPersist).filter(Boolean),
      identitySheet:ipImageForPersist(state.identitySheet),
      outfitSheet:ipImageForPersist(state.outfitSheet),
      identityDna:state.identityDna||'',
      outfitDna:state.outfitDna||'',
      outfitVersion:state.outfitVersion||0,
      results:results,
      locMode:state.locMode||'korea',
      sessionSeed:state.sessionSeed||'',
      controls:ipReadControls(),
      savedAt:new Date().toISOString()
    };
  }
  async function saveInstagramState(reason){
    try{
      const db=await openIPStateDB();
      const tx=db.transaction(IP_STATE_STORE,'readwrite');
      const snapshot = ipSnapshot();
      const payload = {key:'current',reason:reason||'',savedAt:new Date().toISOString(),snapshot:snapshot};
      tx.objectStore(IP_STATE_STORE).put(payload);
      zippyNasSaveJson('state_instagram', 'current', payload, {reason:reason||''});
    }catch(e){
      console.warn('Instagram state save failed:',e);
    }
  }
  async function restoreInstagramState(){
    try{
      const db=await openIPStateDB();
      const snap=await new Promise(function(resolve,reject){
        const tx=db.transaction(IP_STATE_STORE,'readonly');
        const req=tx.objectStore(IP_STATE_STORE).get('current');
        req.onsuccess=function(){resolve(req.result&&req.result.snapshot);};
        req.onerror=function(){reject(req.error);};
      });
      if(!snap) return;
      state.person=(snap.person||[]).map(ipNormalizeImage).filter(Boolean);
      state.outfit=(snap.outfit||[]).map(ipNormalizeImage).filter(Boolean);
      state.place=(snap.place||[]).map(ipNormalizeImage).filter(Boolean);
      state.identitySheet=ipNormalizeImage(snap.identitySheet);
      state.outfitSheet=ipNormalizeImage(snap.outfitSheet);
      state.identityDna=snap.identityDna||'';
      state.outfitDna=snap.outfitDna||'';
      state.outfitVersion=snap.outfitVersion||0;
      state.results=(snap.results||[]).map(function(r){return {...r,pending:false};});
      state.locMode=snap.locMode||snap.controls?.locMode||'korea';
      state.sessionSeed=snap.sessionSeed||'';
      ipApplyControls(snap.controls);
      renderThumbs('person');
      renderThumbs('outfit');
      renderThumbs('place');
      renderOutfitSheet();
      renderResults();
      const idDna=document.getElementById('ipIdentityDna');
      const outfitDna=document.getElementById('ipOutfitDna');
      const sheetOut=document.getElementById('ipSheetOutput');
      if(idDna&&state.identityDna) idDna.textContent=state.identityDna;
      if(outfitDna&&state.outfitDna) outfitDna.textContent=state.outfitDna;
      if(sheetOut&&state.identitySheet) sheetOut.innerHTML='<img src="'+state.identitySheet.url+'" alt="" onclick="ipOpenImageViewer(this.src,\'인물 6전도 시트\')">';
      if((state.results&&state.results.length)||state.person.length||state.outfit.length||state.place.length) setStatus('이전 인스타 작업을 복원했습니다 · '+(snap.savedAt||''));
    }catch(e){
      console.warn('Instagram state restore failed:',e);
    }
  }
  function renderOutfitSheet(){
    const out=document.getElementById('ipOutfitSheetOutput');
    if(!out) return;
    if(state.outfitSheet){
      out.innerHTML='<img src="'+state.outfitSheet.url+'" alt="" onclick="ipOpenImageViewer(this.src,\'의상 6전도 시트\')">';
    }else{
      out.innerHTML='<span>의상 6전도 시트 대기</span>';
    }
  }
  function renderThumbs(kind){
    const bucket=getRefBucket(kind);
    const el=document.getElementById(kind==='person'?'ipPersonGrid':kind==='outfit'?'ipOutfitGrid':'ipPlaceGrid');
    if(!bucket||!el) return;
    const meta=getRefMeta(kind);
    el.innerHTML=bucket.length?bucket.map(function(x,i){
      const del='<button class="ip-thumb-del" onclick="event.stopPropagation();ipRemoveFile(&quot;'+kind+'&quot;,'+i+')">삭제</button>';
      return '<div class="ip-thumb" data-name="'+esc(x.name)+'" onclick="ipOpenImageViewer(this.querySelector(&quot;img&quot;).src,this.dataset.name)"><img src="'+x.url+'" alt=""><small>'+esc(x.name)+'</small>'+del+'</div>';
    }).join(''):'<span>'+meta.empty+'</span>';
  }
  function renderResults(){const el=document.getElementById('ipResults'); if(!el) return; el.innerHTML=state.results.map(function(r,i){if(r.pending)return '<div class="ip-card-result"><div class="meta"><b>#'+r.idx+'</b><span>'+esc(r.loc||'생성 대기')+'</span></div><div class="ip-output" style="min-height:260px"><span>GTI 생성 중...</span></div></div>'; if(r.error)return '<div class="ip-card-result"><div class="meta"><b>#'+r.idx+'</b><span>실패</span></div><pre class="ip-pre">'+esc(r.error)+'</pre></div>'; return '<div class="ip-card-result"><div class="meta"><b>#'+r.idx+'</b><span>'+esc(r.loc)+'</span></div><img src="data:'+r.mime+';base64,'+r.b64+'" alt="" onclick="ipOpenImageViewer(this.src,\'Instagram #'+r.idx+'\')"><div class="tools"><button class="btn bgh bsm" onclick="ipDownloadOne('+i+')">저장</button><button class="btn bor bsm" onclick="ipSendToVideoTab('+i+')">영상 탭으로</button></div></div>';}).join('');}
  window.ipDownloadOne=function(i){const r=state.results[i]; if(!r||r.error)return; const a=document.createElement('a'); a.href='data:'+r.mime+';base64,'+r.b64; a.download='zippy_instagram_'+String(r.idx).padStart(2,'0')+'.png'; document.body.appendChild(a); a.click(); a.remove();};
  window.ipOpenImageViewer=function(src,title){
    if(!src) return;
    state.viewerSrc=src;
    state.viewerTitle=title||'Instagram image';
    let modal=document.getElementById('ipImageViewer');
    if(!modal){
      modal=document.createElement('div');
      modal.id='ipImageViewer';
      modal.className='hist-modal';
      modal.style.display='none';
      modal.onclick=function(e){if(e.target===modal) ipCloseImageViewer();};
      modal.innerHTML='<button class="hist-modal-close" onclick="ipCloseImageViewer()">✕</button><div id="ipImageViewerTitle" style="position:absolute;top:22px;left:24px;right:72px;color:#fff;font-family:var(--font-mono);font-size:12px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis"></div><img id="ipImageViewerImg" src="" alt=""><div class="hist-modal-actions"><button class="hist-modal-btn" onclick="ipDownloadViewer()">다운로드</button></div>';
      document.body.appendChild(modal);
    }
    const img=document.getElementById('ipImageViewerImg');
    const ttl=document.getElementById('ipImageViewerTitle');
    if(img) img.src=src;
    if(ttl) ttl.textContent=state.viewerTitle;
    modal.style.display='flex';
  };
  window.ipCloseImageViewer=function(){const modal=document.getElementById('ipImageViewer'); if(modal) modal.style.display='none';};
  window.ipDownloadViewer=function(){if(!state.viewerSrc)return; const a=document.createElement('a'); a.href=state.viewerSrc; a.download='zippy_instagram_preview_'+Date.now()+'.png'; document.body.appendChild(a); a.click(); a.remove();};
  function focusResults(){setTimeout(function(){const el=document.getElementById('ipResults'); if(el) el.scrollIntoView({behavior:'smooth',block:'start'});},60);}
  function readFile(file){return new Promise(function(res,rej){const fr=new FileReader(); fr.onload=function(){res(fr.result);}; fr.onerror=rej; fr.readAsDataURL(file);});}
  function busy(id,on,text){const el=document.getElementById(id); if(!el)return; el.disabled=on; el.textContent=text;}
  function setStatus(text){const el=document.getElementById('ipStatus'); if(el) el.textContent=text;}
  function sleep(ms){return new Promise(function(res){setTimeout(res,ms);});}
  function esc(v){return String(v==null?'':v).replace(/[&<>"']/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[c];});}
  if(document.readyState==='loading') document.addEventListener('DOMContentLoaded',init); else init();
})();
</script>
</body>
