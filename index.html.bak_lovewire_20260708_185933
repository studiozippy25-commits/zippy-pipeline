}
async function callGPTImage({images=[], prompt, signal=null}) {
  const model = document.getElementById('gptImgModel')?.value || 'gpt-image-1';
  const quality = document.getElementById('gptImgQuality')?.value || 'auto';
  const size = document.getElementById('gptImgSize')?.value || 'auto';
  const hasImages = images && images.length > 0;
  const fetchOpts = { signal };
  let url, body, imgB64 = null;
  if (hasImages) {
    // 이미지 편집 (edits endpoint) — FormData, gpt-image-2 supports up to 16 images
    const form = new FormData();
    form.append('model', model);
    // Inject reference manifest into prompt (image[] order maps to manifest)
    let manifestPrefix = '';
    if (images.some(im => im._type && im._label)) {
      manifestPrefix = 'REFERENCE IMAGES (in order):\n';
      images.forEach((im, idx) => {
        const typeLabel = im._type === 'character' ? '인물 (Character)' : im._type === 'costume' ? '의상 (Outfit)' : im._type === 'background' ? '배경 (Background)' : im._type === 'prop' ? '소품 (Prop)' : 'Reference';
        manifestPrefix += `  ${idx+1}. ${typeLabel}: ${im._label || ''}\n`;
      });
      manifestPrefix += '\n';
    }
    form.append('prompt', manifestPrefix + prompt);
    form.append('n', '1');
    if (size !== 'auto') form.append('size', size);
    // Send up to 16 images
    const maxImgs = Math.min(images.length, 16);
    for (let i = 0; i < maxImgs; i++) {
      const img = images[i];
      const mime = img.mime || 'image/png';
      const bin = atob(img.b64);
      const arr = new Uint8Array(bin.length);
      for (let j = 0; j < bin.length; j++) arr[j] = bin.charCodeAt(j);
      const blob = new Blob([arr], {type: mime});
      form.append('image[]', blob, 'input' + (i+1) + '.png');
    }
    url = 'https://pipeline.studiozippy25.workers.dev/proxy/openai/images/edits';
    fetchOpts.method = 'POST';
    fetchOpts.body = form;
  } else {
    // 텍스트→이미지 생성 (generations endpoint)
    const reqBody = { model, prompt, n: 1, output_format: 'png' };
    if (quality !== 'auto') reqBody.quality = quality;
    if (size !== 'auto') reqBody.size = size;
    url = 'https://pipeline.studiozippy25.workers.dev/proxy/openai/images/generations';
    fetchOpts.method = 'POST';
    fetchOpts.headers = { 'Content-Type': 'application/json' };
    fetchOpts.body = JSON.stringify(reqBody);
  }
  const res = await fetch(url, fetchOpts);
  if (!res.ok) {
    const e = await res.json().catch(() => ({}));
    throw new Error(e?.error?.message || `OpenAI HTTP ${res.status}`);
  }
  const data = await res.json();
  // gpt-image-1은 b64_json, dall-e-3는 url 반환 가능
  const item = data?.data?.[0];
  if (item?.b64_json) {
    imgB64 = item.b64_json;
  } else if (item?.url) {
    // URL → base64 변환
    const imgRes = await fetch(item.url);
    const blob = await imgRes.blob();
    imgB64 = await new Promise(r => { const fr = new FileReader(); fr.onload = () => r(fr.result.split(',')[1]); fr.readAsDataURL(blob); });
  }
  return { imgB64, textOut: '' };
}
