async function callGtiBridge({images=[], prompt, signal=null}) {
  const size = document.getElementById('gptImgSize')?.value || 'auto';
  // 레퍼런스 매니페스트 주입 (callGPTImage와 동일 규칙)
  let manifestPrefix = '';
  if (images.some(im => im._type && im._label)) {
    manifestPrefix = 'REFERENCE IMAGES (in order):\n';
    images.forEach((im, idx) => {
      const t = im._type === 'character' ? '\uC778\uBB3C (Character)' : im._type === 'background' ? '\uBC30\uACBD (Background)' : im._type === 'prop' ? '\uC18C\uD488 (Prop)' : 'Reference';
      manifestPrefix += `  ${idx+1}. ${t}: ${im._label || ''}\n`;
    });
    manifestPrefix += '\n';
  }
  const payload = {
    prompt: manifestPrefix + prompt,
    size: size,
    images: (images || []).slice(0, 16).map(im => ({ b64: im.b64, mime: im.mime || 'image/png' }))
  };
  let res;
  try {
    res = await fetch(GTI_BRIDGE_URL + '/generate', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(payload), signal });
  } catch(e) {
    throw new Error('gti \uBE0C\uB9AC\uC9C0 \uC5F0\uACB0 \uC2E4\uD328 (' + GTI_BRIDGE_URL + '). \uB85C\uCEEC \uBE0C\uB9AC\uC9C0 \uC11C\uBC84(npm start)\uAC00 \uCF1C\uC838 \uC788\uB098\uC694? \u00B7 ' + (e.message||e));
  }
  if (!res.ok) {
    const er = await res.json().catch(()=>({}));
    throw new Error('gti \uC0DD\uC131 \uC2E4\uD328: ' + (er.error || ('HTTP ' + res.status)));
  }
  const data = await res.json();
  if (!data.imgB64) throw new Error('gti \uC751\uB2F5\uC5D0 \uC774\uBBF8\uC9C0 \uC5C6\uC74C');
  return { imgB64: data.imgB64 };
}
async function callGPTImage({images=[], prompt, signal=null}) {
  const model = document.getElementById('gptImgModel')?.value || 'gpt-image-1';
  const quality = document.getElementById('gptImgQuality')?.value || 'auto';
  const size = document.getElementById('gptImgSize')?.value || 'auto';
  const hasImages = images && images.length > 0;
  const fetchOpts = { signal };
  let url, body, imgB64 = null;
  if (hasImages) {
    // 이미지 편집 (edits endpoint) — FormData, gpt-image-2 supports up to 16 images
    const form = new FormData();
    form.append('model', model);
    // Inject reference manifest into prompt (image[] order maps to manifest)
    let manifestPrefix = '';
    if (images.some(im => im._type && im._label)) {
      manifestPrefix = 'REFERENCE IMAGES (in order):\n';
      images.forEach((im, idx) => {
        const typeLabel = im._type === 'character' ? '인물 (Character)' : im._type === 'background' ? '배경 (Background)' : im._type === 'prop' ? '소품 (Prop)' : 'Reference';
        manifestPrefix += `  ${idx+1}. ${typeLabel}: ${im._label || ''}\n`;
      });
      manifestPrefix += '\n';
    }
    form.append('prompt', manifestPrefix + prompt);
    form.append('n', '1');
    if (size !== 'auto') form.append('size', size);
    // Send up to 16 images
    const maxImgs = Math.min(images.length, 16);
    for (let i = 0; i < maxImgs; i++) {
      const img = images[i];
      const mime = img.mime || 'image/png';
      const bin = atob(img.b64);
      const arr = new Uint8Array(bin.length);
      for (let j = 0; j < bin.length; j++) arr[j] = bin.charCodeAt(j);
      const blob = new Blob([arr], {type: mime});
      form.append('image[]', blob, 'input' + (i+1) + '.png');
    }
    url = 'https://pipeline.studiozippy25.workers.dev/proxy/openai/images/edits';
    fetchOpts.method = 'POST';
    fetchOpts.body = form;
  } else {
    // 텍스트→이미지 생성 (generations endpoint)
    const reqBody = { model, prompt, n: 1, output_format: 'png' };
    if (quality !== 'auto') reqBody.quality = quality;
    if (size !== 'auto') reqBody.size = size;
    url = 'https://pipeline.studiozippy25.workers.dev/proxy/openai/images/generations';
    fetchOpts.method = 'POST';
    fetchOpts.headers = { 'Content-Type': 'application/json' };
    fetchOpts.body = JSON.stringify(reqBody);
  }
  const res = await fetch(url, fetchOpts);
  if (!res.ok) {
    const e = await res.json().catch(() => ({}));
    throw new Error(e?.error?.message || `OpenAI HTTP ${res.status}`);
  }
  const data = await res.json();
  // gpt-image-1은 b64_json, dall-e-3는 url 반환 가능
  const item = data?.data?.[0];
  if (item?.b64_json) {
    imgB64 = item.b64_json;
  } else if (item?.url) {
    // URL → base64 변환
    const imgRes = await fetch(item.url);
    const blob = await imgRes.blob();
    imgB64 = await new Promise(r => { const fr = new FileReader(); fr.onload = () => r(fr.result.split(',')[1]); fr.readAsDataURL(blob); });
  }
  return { imgB64, textOut: '' };
}
async function checkComfy() {
  const host = getComfyHost();
  const statEl = document.getElementById('comfyStat');
  if (!statEl) return;
  statEl.className = 'ast sno';
  statEl.textContent = '확인 중...';
  try {
    const res = await fetch(host + '/system_stats', {method:'GET'});
    if (!res.ok) throw new Error('HTTP ' + res.status);
    const data = await res.json();
    const vram = ((data?.devices?.[0]?.vram_total || 0) / 1e9).toFixed(1);
    const vramFree = ((data?.devices?.[0]?.vram_free || 0) / 1e9).toFixed(1);
    statEl.className = 'ast sok';
    statEl.textContent = '✓ VRAM ' + vramFree + '/' + vram + 'GB';
    if (!window.comfyClientId) window.comfyClientId = 'zippy_' + Date.now() + '_' + Math.random().toString(36).slice(2,8);
  } catch (e) {
    statEl.className = 'ast sno';
    const isCors = e.message.includes('Failed to fetch') || e.message.includes('NetworkError');
    const isFromHttp = location.protocol === 'http:' || location.protocol === 'https:';
    if (isCors && isFromHttp) {
      statEl.textContent = 'CORS 차단 — file://로 열어야 함';
      statEl.title = 'ComfyUI 데스크톱은 localhost Origin을 차단합니다.\n\n해결:\n1. HTML을 파일 더블클릭으로 열기 (file://)\n   또는\n2. ComfyUI 실행 시 --enable-cors-header "*" 인자 추가';
    } else if (isCors) {
      statEl.textContent = 'ComfyUI 실행 확인 필요';
      statEl.title = 'ComfyUI 데스크톱 앱이 실행되고 있는지 확인하세요.';
    } else {
      statEl.textContent = '연결 실패: ' + e.message.substring(0, 40);
    }
  }
}
// base64 이미지를 ComfyUI input 폴더에 업로드 → 파일명 반환
async function uploadImageToComfy(b64, mime='image/png', signal=null) {
  const host = getComfyHost();
  const bin = atob(b64);
  const arr = new Uint8Array(bin.length);
  for (let i = 0; i < bin.length; i++) arr[i] = bin.charCodeAt(i);
  const ext = mime.includes('jpeg') ? '.jpg' : mime.includes('webp') ? '.webp' : '.png';
  const filename = 'zippy_' + Date.now() + '_' + Math.random().toString(36).slice(2, 8) + ext;
  const blob = new Blob([arr], {type: mime});
  const form = new FormData();
  form.append('image', blob, filename);
  form.append('type', 'input');
  form.append('overwrite', 'true');
  const res = await fetch(host + '/upload/image', {method:'POST', body: form, signal});
  if (!res.ok) throw new Error('업로드 실패');
  const data = await res.json();
  return data.name || filename;
}

