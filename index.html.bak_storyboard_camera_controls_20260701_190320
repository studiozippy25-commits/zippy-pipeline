// 구 캔버스 — 클릭 토글 + 선택된 점 드래그 이동
(function(){
  var canvas = document.getElementById('posCanvas');
  if (!canvas) return;
  canvas.style.cursor = 'pointer';

  var isDragging = false;
  var dragSourceKey = null;  // 드래그 중인 원래 조합 키 "elevKey:az"
  var dragCurrentKey = null; // 현재 위치한 조합 키
  var didMove = false;       // 실제로 이동했는지 (클릭과 드래그 구분)

  function getMousePos(e) {
    var rect = canvas.getBoundingClientRect();
    return {
      x: (e.clientX - rect.left) * (canvas.width  / rect.width),
      y: (e.clientY - rect.top)  * (canvas.height / rect.height)
    };
  }

  function findNearestDot(mx, my, selectedOnly) {
    var best = null, bestDist = selectedOnly ? 30 : 22;
    drawnDotPositions.forEach(function(d) {
      if (d.depth < -0.08) return;
      if (selectedOnly) {
        var k = d.elevKey + ':' + d.az;
        if (!selectedCombinations.has(k)) return;
      }
      var dist = Math.sqrt((d.sx-mx)*(d.sx-mx)+(d.sy-my)*(d.sy-my));
      if (dist < bestDist) { bestDist = dist; best = d; }
    });
    return best;
  }

  function findNearestAnyDot(mx, my) {
    var best = null, bestDist = 30;
    drawnDotPositions.forEach(function(d) {
      if (d.depth < -0.08) return;
      var dist = Math.sqrt((d.sx-mx)*(d.sx-mx)+(d.sy-my)*(d.sy-my));
      if (dist < bestDist) { bestDist = dist; best = d; }
    });
    return best;
  }

  canvas.addEventListener('mousedown', function(e) {
    e.preventDefault();
    var pos = getMousePos(e);
    // 선택된 점 위에서 시작하면 드래그 모드
    var selDot = findNearestDot(pos.x, pos.y, true);
    if (selDot) {
      isDragging = true;
      didMove = false;
      dragSourceKey = selDot.elevKey + ':' + selDot.az;
      dragCurrentKey = dragSourceKey;
      canvas.style.cursor = 'grabbing';
      return;
    }
    // 비선택 점 클릭 → 토글
    var anyDot = findNearestAnyDot(pos.x, pos.y);
    if (anyDot) toggleCombination(anyDot.elevKey, anyDot.az);
  });

  canvas.addEventListener('mousemove', function(e) {
    if (!isDragging) {
      // 호버 시 커서 변경
      var pos = getMousePos(e);
      var selDot = findNearestDot(pos.x, pos.y, true);
      canvas.style.cursor = selDot ? 'grab' : 'pointer';
      return;
    }
    var pos = getMousePos(e);
    var target = findNearestAnyDot(pos.x, pos.y);
    if (!target) return;
    var newKey = target.elevKey + ':' + target.az;
    if (newKey === dragCurrentKey) return;
    didMove = true;
    // 이전 위치 제거, 새 위치 추가
    selectedCombinations.delete(dragCurrentKey);
    if (selectedCombinations.size === 0 && newKey !== dragCurrentKey) selectedCombinations.add('eye:0');
    selectedCombinations.add(newKey);
    dragCurrentKey = newKey;
    drawSphere(); updateCombUI(); updateVarCount();
  });

  function endDrag() {
    if (isDragging && !didMove) {
      // 이동 없이 놓으면 → 토글 (선택 해제)
      toggleCombination(dragSourceKey.split(':')[0], parseInt(dragSourceKey.split(':')[1]));
    }
    isDragging = false;
    dragSourceKey = null;
    dragCurrentKey = null;
    didMove = false;
    canvas.style.cursor = 'pointer';
  }
  canvas.addEventListener('mouseup', endDrag);
  canvas.addEventListener('mouseleave', function() {
    if (isDragging) { isDragging = false; dragSourceKey = null; dragCurrentKey = null; didMove = false; canvas.style.cursor = 'pointer'; }
  });

  // 터치 지원
  canvas.addEventListener('touchstart', function(e) {
    e.preventDefault();
    var t = e.touches[0];
    var pos = getMousePos(t);
    var selDot = findNearestDot(pos.x, pos.y, true);
    if (selDot) {
      isDragging = true;
      didMove = false;
      dragSourceKey = selDot.elevKey + ':' + selDot.az;
      dragCurrentKey = dragSourceKey;
      return;
    }
    var anyDot = findNearestAnyDot(pos.x, pos.y);
    if (anyDot) toggleCombination(anyDot.elevKey, anyDot.az);
  }, {passive:false});

  canvas.addEventListener('touchmove', function(e) {
    if (!isDragging) return;
    e.preventDefault();
    var t = e.touches[0];
    var pos = getMousePos(t);
    var target = findNearestAnyDot(pos.x, pos.y);
    if (!target) return;
    var newKey = target.elevKey + ':' + target.az;
    if (newKey === dragCurrentKey) return;
    didMove = true;
    selectedCombinations.delete(dragCurrentKey);
    if (selectedCombinations.size === 0) selectedCombinations.add('eye:0');
    selectedCombinations.add(newKey);
    dragCurrentKey = newKey;
    drawSphere(); updateCombUI(); updateVarCount();
  }, {passive:false});

  canvas.addEventListener('touchend', function() {
    if (isDragging && !didMove) {
      toggleCombination(dragSourceKey.split(':')[0], parseInt(dragSourceKey.split(':')[1]));
    }
    isDragging = false; dragSourceKey = null; dragCurrentKey = null; didMove = false;
  });
  canvas.addEventListener('touchcancel', function() {
    isDragging = false; dragSourceKey = null; dragCurrentKey = null; didMove = false;
  });
})();

function updatePromptPreview() {
  const parts = [];
  const loc = getSelected('loc'); if(loc) parts.push('장소: ' + loc);
  const spaceDna = (typeof SPACE_DNA!=='undefined'&&SPACE_DNA[loc])?SPACE_DNA[loc]:''; if(spaceDna) parts.push('Space DNA: ' + spaceDna);
  const time = getSelected('time'); if(time) parts.push('시간: ' + time);
  const weather = getSelected('weather',true); if(weather.length) parts.push('날씨: ' + weather.join(', '));
  const emo = getSelected('emo',true); if(emo.length) parts.push('감정: ' + emo.join(', '));
  const light = getSelected('light',true); if(light.length) parts.push('광원: ' + light.join(', '));
  const costume = getSelected('costume'); if(costume) parts.push('의상: ' + costume);
  const costumeDna = (typeof COSTUME_DNA!=='undefined'&&COSTUME_DNA[costume])?COSTUME_DNA[costume]:''; if(costumeDna) parts.push('Costume DNA: ' + costumeDna);
  const shot = getSelected('shot'); if(shot) parts.push('샷: ' + shot);
  const lens = getSelected('lens'); if(lens) parts.push('렌즈: ' + lens);
  const look = (typeof getLookPrompt==='function')?getLookPrompt():''; if(look) parts.push('Look: ' + look);
  const cuts = (typeof getEnabledCuts==='function')?getEnabledCuts():[]; if(cuts.length) parts.push('멀티컷: ' + cuts.map((c,i)=>'Cut'+(i+1)+': '+c.shot+' '+c.anglePrompt).join(' | '));
  ['custom-loc','custom-time','custom-weather','custom-emo','custom-light','custom-costume'].forEach(id=>{const v=document.getElementById(id)?.value?.trim();if(v)parts.push('커스텀('+id.replace('custom-','')+'): '+v);});
  const scene = document.getElementById('ta-scene')?.value?.trim(); if(scene) parts.push('씬 설명: ' + scene);
  const _prevQ = (currentProject && currentProject.quality) || (typeof POT_QUALITY!=='undefined' ? POT_QUALITY : '');
  const _prevN = (currentProject && currentProject.negative) || (typeof POT_NEGATIVE!=='undefined' ? POT_NEGATIVE : '');
  if(_prevQ) parts.push('품질: ' + _prevQ);
  if(_prevN) parts.push('네거티브: ' + _prevN);
  parts.push('ANTI-CG: Visible pores, follicle micro-shadows, natural skin oils, surface material age, lens vignetting');
  document.getElementById('promptPreviewBody').textContent = parts.join('\n\n') || '설정이 없습니다.';
  document.getElementById('promptPreviewBody').style.display = 'block';
}
