    return vbJoin(base, '/audio?path=' + encodeURIComponent(raw));
  }
  if (/^[a-zA-Z]:[\\/]/.test(raw) || raw.includes('\\')) return vbJoin(base, '/audio?path=' + encodeURIComponent(raw));
  if (/^(audio|file|download|output|outputs|static|media|voice|generated)\//i.test(raw)) return vbJoin(base, '/' + raw);
  return vbJoin(base, '/audio?path=' + encodeURIComponent(raw));
}
async function vbResolveAudioFromJson(base, data) {
  if (data?.audio_base64 || data?.audio) return 'data:audio/wav;base64,' + (data.audio_base64 || data.audio);
  const audioUrl = vbExtractAudioUrl(data);
  if (audioUrl) return vbJoin(base, audioUrl);
  const path = vbExtractAudioPath(data);
  if (path) return vbAudioUrlFromPath(base, path);
  return '';
}
async function vbTryJobAudio(base, jobId) {
  const id = String(jobId || '').trim();
  if (!id) return '';
  const directPaths = [
    '/audio?id=' + encodeURIComponent(id),
    '/audio?generation_id=' + encodeURIComponent(id),
    '/audio?job_id=' + encodeURIComponent(id),
    '/audio/' + encodeURIComponent(id),
    '/download/' + encodeURIComponent(id)
  ];
  const jsonPaths = [
    '/generate/' + encodeURIComponent(id),
    '/generation/' + encodeURIComponent(id),
    '/generations/' + encodeURIComponent(id),
    '/jobs/' + encodeURIComponent(id),
    '/status/' + encodeURIComponent(id),
    '/tasks/' + encodeURIComponent(id)
  ];
  for (let attempt = 0; attempt < 4; attempt++) {
    const paths = attempt === 0 ? directPaths.concat(jsonPaths) : jsonPaths.concat(directPaths);
    for (const path of paths) {
      try {
        const res = await fetch(vbJoin(base, path), { headers:vbHeaders(base), signal:vbTimeoutSignal(2200), cache:'no-store' });
        if (!res.ok) continue;
        const type = res.headers.get('content-type') || '';
        if (type.includes('audio')) return URL.createObjectURL(await res.blob());
        if (type.includes('json')) {
          const data = await res.json();
          vbSetLastResponse('Voicebox job lookup ' + path, data);
          const src = await vbResolveAudioFromJson(base, data);
          if (src) return src;
        }
      } catch(e) {}
    }
    await vbSleep(900);
  }
  return '';
}
async function vbTTS(charName, text, instruct) {
  const profileId = vbMap()[charName];
  if (!profileId) throw new Error('"' + charName + '" 프로필 미연결');
  const body = { text:text, profile_id:profileId };
  const language = vbLanguage();
  if (language && language !== 'auto') body.language = language;
  if (instruct) body.instruct = instruct;
  const base = vbApiBase();
  const res = await fetch(vbJoin(base, '/generate'), {
    method:'POST',
    headers:vbHeaders(base, {json:true}),
    body:JSON.stringify(body)
  });
  if (!res.ok) throw new Error('HTTP ' + res.status + ' · ' + (await res.text()).slice(0, 180));
  const type = res.headers.get('content-type') || '';
  if (type.includes('audio')) return URL.createObjectURL(await res.blob());
  const data = await res.json();
  vbSetLastResponse('Voicebox POST /generate response', data);
  const src = await vbResolveAudioFromJson(base, data);
  if (src) return src;
  const jobId = data.id || data.job_id || data.task_id || data.request_id || data.generation_id;
  const jobSrc = await vbTryJobAudio(base, jobId);
  if (jobSrc) return jobSrc;
  throw new Error('오디오 경로 없음 · 최근 응답 박스에서 전체 JSON 확인');
}
