    const clipEnd = premiereTimecode(dur, s.fpsInt);
    out += String(i + 1).padStart(3, '0') + '  AX       V     C        00:00:00:00 ' + clipEnd + ' ' + start + ' ' + end + '\n';
    out += '* FROM CLIP NAME: media/' + (mediaNames ? mediaNames[i] : premiereClipFileName(item, i)) + '\n';
