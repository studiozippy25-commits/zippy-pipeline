:root{
  --font-body: 'Carmen Sans', 'Pretendard', -apple-system, sans-serif;
  --font-mono: 'IBM Plex Mono', 'SF Mono', monospace;
  --bg:#0F1419;
  --sf:#1A1F26;
  --s2:#252B33;
  --bd:#353D47;
  --or:#F59E0B;
  --bl:#60A5FA;
  --cy:#22D3EE;
  --tx:#E5E7EB;
  --mu:#9CA3AF;
  --ok:#34D399;
  --wn:#FBBF24;
  --pu:#A78BFA;
  --er:#F87171;
  --card:#1A1F26;
  --radius:12px;
  --shadow-sm:0 1px 2px rgba(0,0,0,.05);
  --shadow-md:0 4px 12px rgba(0,0,0,.08);
  --shadow-lg:0 12px 36px rgba(0,0,0,.12);
  --transition:all .2s cubic-bezier(.4,0,.2,1)
}
*{box-sizing:border-box;margin:0;padding:0}
body{background:var(--bg);color:var(--tx);font-family:var(--font-body);min-height:100vh;font-size:16px;line-height:1.7;-webkit-font-smoothing:antialiased}
.gbg{display:none}
.app{position:relative;z-index:1;max-width:1120px;margin:0 auto;padding:28px 22px 100px}

/* Header */
.hdr{display:flex;align-items:center;gap:14px;margin-bottom:22px;padding-bottom:18px;border-bottom:1px solid var(--bd)}
.logo{width:44px;height:44px;border:2px solid var(--or);display:flex;align-items:center;justify-content:center;font-family:var(--font-mono);font-size:14px;color:var(--or);flex-shrink:0}
.hdr h1{font-family:var(--font-mono);font-size:20px;letter-spacing:2px;text-transform:uppercase}
.hdr p{font-size:15px;color:var(--mu);font-family:var(--font-mono);margin-top:3px}
.vb{margin-left:auto;font-family:var(--font-mono);font-size:13px;padding:3px 9px;border:1px solid var(--bd);color:var(--mu);border-radius:2px;flex-shrink:0}

/* API Bar */
.api-bar{background:var(--sf);border:1px solid var(--bd);border-radius:2px;padding:14px 18px;margin-bottom:22px}
.ar{display:flex;align-items:center;gap:10px;flex-wrap:wrap}
.al{font-family:var(--font-mono);font-size:14px;color:var(--tx);letter-spacing:1.5px;white-space:nowrap;font-weight:700}
.api-inp{flex:1;min-width:200px;padding:10px 14px;background:var(--s2);border:1px solid var(--bd);color:var(--tx);font-family:var(--font-mono);font-size:15px;border-radius:2px;outline:none}
.api-inp:focus{border-color:var(--or)}
.msel{padding:8px 11px;background:var(--s2);border:1px solid var(--bd);color:var(--tx);font-family:var(--font-mono);font-size:14px;border-radius:2px;outline:none;cursor:pointer}
.msel option{background:#e8eaf2}
.ast{font-family:var(--font-mono);font-size:14px;padding:4px 10px;border-radius:2px;white-space:nowrap}
.sok{background:rgba(0,200,150,.1);border:1px solid rgba(0,200,150,.3);color:var(--ok)}
.sno{background:rgba(232,93,4,.08);border:1px solid rgba(232,93,4,.2);color:var(--or)}
.an{margin-top:9px;font-size:15px;color:var(--mu);font-family:var(--font-mono);line-height:1.6;padding-top:9px;border-top:1px solid var(--bd)}
.an strong{color:var(--wn)} .an a{color:var(--cy)}

/* Step Nav */
.snav{display:flex;margin-bottom:26px;border:1px solid var(--bd);border-radius:2px;overflow:hidden}
.stab{flex:1;padding:13px 16px;cursor:pointer;background:var(--sf);border:none;font-family:var(--font-mono);font-size:15px;color:var(--mu);letter-spacing:1px;text-align:left;transition:all .2s}
.stab+.stab{border-left:1px solid var(--bd)}
.snum{display:inline-flex;width:18px;height:18px;border:1px solid currentColor;border-radius:50%;align-items:center;justify-content:center;margin-right:6px;font-size:13px}
.stab.a1{background:rgba(232,93,4,.08);color:var(--or);border-bottom:2px solid var(--or)}
.stab.a2{background:rgba(0,102,204,.08);color:var(--bl);border-bottom:2px solid var(--bl)}
.stab.a3{background:rgba(153,102,204,.08);color:var(--pu);border-bottom:2px solid var(--pu)}
.stab.done{color:var(--ok)}
.panel{display:none;animation:fi .3s ease}
.panel.active{display:block}
@keyframes fi{from{opacity:0;transform:translateY(5px)}to{opacity:1;transform:translateY(0)}}

.slbl{font-family:var(--font-mono);font-size:15px;letter-spacing:2px;text-transform:uppercase;margin-bottom:13px;display:flex;align-items:center;gap:10px}
.slbl::after{content:'';flex:1;height:1px;background:var(--bd)}

/* Upload */
.muz{border:1.5px dashed var(--bd);background:var(--sf);border-radius:2px;padding:28px 18px;text-align:center;cursor:pointer;transition:all .25s;position:relative;overflow:hidden}
.muz:hover,.muz.drag{border-color:var(--or);background:#ecedf5}
.muz.s2:hover,.muz.s2.drag{border-color:var(--bl)}
.muz::before{content:'';position:absolute;top:0;left:-60%;width:60%;height:1.5px;background:linear-gradient(90deg,transparent,var(--or),transparent);animation:sc 4s infinite linear}
.muz.s2::before{background:linear-gradient(90deg,transparent,var(--bl),transparent)}
@keyframes sc{0%{left:-60%}100%{left:160%}}
.uico{font-size:20px;margin-bottom:6px;color:var(--s2);font-weight:300}
.ulbl{font-size:15px;color:var(--mu)} .ulbl strong{color:var(--or)}
.muz.s2 .ulbl strong{color:var(--bl)}
.uhnt{font-size:15px;color:var(--mu);margin-top:4px;font-family:var(--font-mono)}
input[type=file]{display:none}

/* Thumb grid */
.tgrid{display:flex;flex-wrap:wrap;gap:8px;margin-top:12px;padding:12px;background:var(--s2);border:1px solid var(--bd);border-radius:2px;min-height:52px}
.tg-empty{font-family:var(--font-mono);font-size:14px;color:var(--mu);text-align:center;width:100%;padding:10px 0}
.titem{position:relative;width:82px;flex-shrink:0}
.titem img{width:82px;height:100px;object-fit:cover;border:1px solid var(--bd);border-radius:2px;display:block}
.tlbl{font-family:var(--font-mono);font-size:11px;color:var(--mu);margin-top:2px;text-align:center;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.tdel{position:absolute;top:3px;right:3px;width:16px;height:16px;background:rgba(255,255,255,.9);border:1px solid var(--or);color:var(--or);border-radius:50%;cursor:pointer;font-size:15px;display:flex;align-items:center;justify-content:center;transition:all .15s}
.tdel:hover{background:var(--or);color:#fff}
.primary-img{padding:2px;border:2px solid var(--or);border-radius:4px}
.pbadge{position:absolute;bottom:18px;left:0;right:0;text-align:center;font-family:var(--font-mono);font-size:11px;color:var(--or);background:rgba(255,255,255,.9);padding:2px 0}
.add-btn{width:82px;height:100px;border:1.5px dashed var(--bd);background:transparent;color:var(--mu);border-radius:2px;cursor:pointer;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:4px;font-family:var(--font-mono);font-size:13px;transition:all .2s;flex-shrink:0}
.add-btn:hover{border-color:var(--or);color:var(--or)}
.cnt{font-family:var(--font-mono);font-size:13px;color:var(--cy);margin-top:7px}
.cnt span{color:var(--wn)}

/* Buttons */
.ci{width:100%;padding:10px 14px;background:var(--s2);border:1px solid var(--bd);color:var(--tx);font-family:var(--font-body);font-size:15px;border-radius:2px;margin-bottom:11px;outline:none;transition:border-color .2s}
.ci:focus{border-color:var(--or)} .ci::placeholder{color:var(--mu)}
.btn{padding:10px 20px;border:none;cursor:pointer;font-family:var(--font-mono);font-size:15px;font-weight:600;letter-spacing:1px;text-transform:uppercase;transition:all .2s;border-radius:2px;display:inline-flex;align-items:center;gap:5px}
.bor{background:var(--or);color:#fff} .bor:hover{background:#A86008;transform:translateY(-1px)} .bor:disabled{background:#D1CEC8;color:#A09D98;cursor:not-allowed;transform:none}
.bbl{background:var(--bl);color:#fff} .bbl:hover{background:#2A4A6F;transform:translateY(-1px)} .bbl:disabled{background:#D1CEC8;color:#A09D98;cursor:not-allowed;transform:none}
.bpu{background:var(--pu);color:#fff} .bpu:hover{background:#5B21B6;transform:translateY(-1px)} .bpu:disabled{background:#D1CEC8;color:#A09D98;cursor:not-allowed;transform:none}
.bgh{background:transparent;color:var(--mu);border:1px solid var(--bd)} .bgh:hover{border-color:var(--mu);color:var(--tx)}
.bsm{font-size:14px;padding:7px 14px}
.brow{display:flex;gap:7px;flex-wrap:wrap;margin-top:11px}

/* Loading */
.ldw{margin-top:14px}
.lbar{height:2px;background:var(--bd);overflow:hidden;margin:7px 0}
.lbi{height:100%;width:40%;animation:ld 1.4s ease-in-out infinite}
.lor{background:linear-gradient(90deg,var(--or),var(--cy))}
.lbl-g{background:linear-gradient(90deg,var(--bl),var(--cy))}
.lpu-g{background:linear-gradient(90deg,var(--pu),var(--cy))}
@keyframes ld{0%{transform:translateX(-120%)}100%{transform:translateX(400%)}}
.lst{font-family:var(--font-mono);font-size:15px;color:var(--cy)}
.psteps{margin-top:9px;display:flex;flex-direction:column;gap:5px}
.ps{display:flex;align-items:center;gap:9px;font-family:var(--font-mono);font-size:14px;color:var(--mu);transition:color .3s}
.ps.cur{color:var(--cy)} .ps.fin{color:var(--ok)}
.dot{width:5px;height:5px;border-radius:50%;background:var(--bd);flex-shrink:0;transition:all .3s}
.ps.cur .dot{background:var(--cy);box-shadow:0 0 7px var(--cy)}
.ps.fin .dot{background:var(--ok)}

/* Output */
.ob{background:var(--sf);border:1px solid var(--bd);border-radius:2px;overflow:hidden;margin-top:13px;animation:fi .35s ease}
.ohd{padding:10px 16px;background:var(--s2);border-bottom:1px solid var(--bd);display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:7px}
.olb{font-family:var(--font-mono);font-size:14px;letter-spacing:1.5px;color:var(--or)}
.olb.bl{color:var(--bl)} .olb.pu{color:var(--pu)}
.otx{padding:14px;font-family:var(--font-mono);font-size:15px;line-height:1.85;color:#3a3a6a;white-space:pre-wrap;word-break:break-all;max-height:220px;overflow-y:auto}
.otx::-webkit-scrollbar{width:3px} .otx::-webkit-scrollbar-thumb{background:#c0c0d8}
.giw{padding:16px;display:flex;flex-direction:column;align-items:center;gap:12px}
.gi{max-width:100%;border-radius:2px;border:1px solid var(--bd);box-shadow:0 8px 36px rgba(0,0,0,.15)}
.cb{background:none;border:1px solid var(--bd);color:var(--mu);padding:3px 10px;font-family:var(--font-mono);font-size:13px;cursor:pointer;border-radius:2px;transition:all .15s;letter-spacing:1px}
.cb:hover{border-color:var(--or);color:var(--or)} .cb.bl:hover{border-color:var(--bl);color:var(--bl)} .cb.pu:hover{border-color:var(--pu);color:var(--pu)} .cb.cpd{border-color:var(--ok);color:var(--ok)}
.ncta{margin-top:14px;padding:13px 18px;background:rgba(153,102,204,.06);border:1px solid rgba(153,102,204,.2);border-radius:2px;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:11px}
.ncta p{font-size:16px;color:var(--mu)} .ncta strong{color:var(--pu)}
.eb{margin-top:13px;padding:13px 15px;background:rgba(232,93,4,.06);border:1px solid rgba(232,93,4,.25);border-radius:2px;font-family:var(--font-mono);font-size:15px;color:var(--or);line-height:1.7}
.et{font-weight:700;margin-bottom:5px;font-size:16px} .etip{color:var(--wn);margin-top:7px;font-size:14px}
.pill{display:inline-block;padding:2px 7px;background:rgba(0,200,150,.1);border:1px solid rgba(0,200,150,.3);color:var(--ok);font-family:var(--font-mono);font-size:13px;border-radius:2px;margin-left:7px}
.dv{font-family:var(--font-mono);font-size:13px;color:var(--mu);letter-spacing:2px;text-align:center;padding:7px 0;position:relative;margin:4px 0}
.dv::before,.dv::after{content:'';position:absolute;top:50%;width:38%;height:1px;background:var(--bd)}
.dv::before{left:0} .dv::after{right:0}
.ltabs{display:flex;gap:4px}
.lt{padding:3px 10px;background:transparent;border:1px solid var(--bd);color:var(--mu);font-family:var(--font-mono);font-size:13px;cursor:pointer;border-radius:2px;letter-spacing:1px;transition:all .15s}
.lt.active{background:var(--bl);border-color:var(--bl);color:#fff}
.dna-block{background:rgba(0,136,204,.05);border:1px solid rgba(0,136,204,.18);border-radius:2px;padding:12px 14px;margin-top:12px}
.dna-title{font-family:var(--font-mono);font-size:13px;color:var(--cy);letter-spacing:2px;margin-bottom:6px}
.dna-text{font-family:var(--font-mono);font-size:14px;color:#3a6878;line-height:1.8;white-space:pre-wrap;max-height:140px;overflow-y:auto}

/* ═══ SCENE CONFIGURATOR ═══ */
.cfg-wrap{background:var(--sf);border:1px solid var(--bd);border-radius:2px;overflow:hidden;margin-bottom:18px}
.cfg-hdr{padding:11px 17px;background:var(--s2);border-bottom:1px solid var(--bd);display:flex;align-items:center;justify-content:space-between}
.cfg-hdr-title{font-family:var(--font-mono);font-size:15px;letter-spacing:1.5px;color:var(--bl)}
.cfg-bc{font-family:var(--font-mono);font-size:13px;color:var(--mu)}
.cfg-body{display:grid;grid-template-columns:1fr 1fr;gap:0}
.cfg-left{padding:16px;border-right:1px solid var(--bd)}
.cfg-right{padding:16px}
@media(max-width:720px){.cfg-body{grid-template-columns:1fr}.cfg-left{border-right:none;border-bottom:1px solid var(--bd)}}
.cfg-sec{margin-bottom:16px}
.cfg-sec:last-child{margin-bottom:0}
.cfg-lbl{font-family:var(--font-mono);font-size:14px;letter-spacing:1.5px;color:var(--mu);text-transform:uppercase;margin-bottom:7px;display:flex;align-items:center;gap:6px}
.req{font-size:12px;padding:1px 5px;background:rgba(232,93,4,.15);border:1px solid rgba(232,93,4,.3);color:var(--or);border-radius:2px}
.opt{font-size:12px;padding:1px 5px;background:rgba(90,90,112,.15);border:1px solid var(--bd);color:var(--mu);border-radius:2px}
.multi{font-size:16px;padding:1px 5px;background:rgba(0,102,204,.1);border:1px solid rgba(0,102,204,.3);color:var(--bl);border-radius:2px}
.chips{display:flex;flex-wrap:wrap;gap:5px}
.chip{padding:7px 13px;border:1px solid var(--bd);background:transparent;color:var(--mu);font-family:var(--font-body);font-size:14px;border-radius:20px;cursor:pointer;transition:all .2s;white-space:normal;user-select:none;text-align:center;line-height:1.4}
.chip:hover{border-color:var(--cy);color:var(--tx)}
.chip.on{background:rgba(0,102,204,.15);border-color:var(--bl);color:var(--tx)}
.chip.star::after{content:'★';font-size:13px;margin-left:3px;color:var(--wn)}
.stype-tabs{display:grid;grid-template-columns:repeat(3,1fr);gap:6px}
.stype{padding:9px 7px;border:1px solid var(--bd);background:var(--s2);color:var(--mu);font-family:var(--font-body);font-size:16px;border-radius:2px;cursor:pointer;text-align:center;transition:all .2s}
.stype:hover{border-color:var(--bl)}
.stype.on{background:rgba(232,93,4,.12);border-color:var(--or);color:var(--tx)}
.stype .stlbl{font-size:13px;font-weight:700;display:block;margin-bottom:2px}
.stype .stdesc{font-size:14px;color:var(--mu)}
.stype.on .stdesc{color:rgba(232,93,4,.7)}
.cfg-ta{width:100%;padding:8px 12px;background:var(--s2);border:1px solid var(--bd);color:var(--tx);font-family:var(--font-body);font-size:13px;border-radius:2px;resize:vertical;min-height:64px;outline:none;line-height:1.7;transition:border-color .2s;margin-top:2px}
.cfg-ta:focus{border-color:var(--bl)}
.cfg-ta::placeholder{color:var(--mu);font-size:16px}

/* ── 자동 작성 버튼 ── */
.auto-btn{display:inline-flex;align-items:center;gap:5px;padding:3px 10px;background:rgba(0,136,204,.08);border:1px solid rgba(0,136,204,.3);color:var(--cy);font-family:var(--font-mono);font-size:13px;border-radius:2px;cursor:pointer;transition:all .2s;letter-spacing:1px;white-space:nowrap}
.auto-btn:hover{background:rgba(0,136,204,.18);border-color:var(--cy)}
.auto-btn:disabled{opacity:.4;cursor:not-allowed}
.auto-btn.loading{animation:pulse .8s ease-in-out infinite}
@keyframes pulse{0%,100%{opacity:.6}50%{opacity:1}}
.ta-wrap{position:relative}
.ta-overlay{position:absolute;inset:0;background:rgba(242,243,248,.75);display:flex;align-items:center;justify-content:center;font-family:var(--font-mono);font-size:14px;color:var(--cy);border-radius:2px;backdrop-filter:blur(2px)}

/* ── 다듬기 버튼 ── */
.refine-btn{display:inline-flex;align-items:center;gap:5px;padding:3px 10px;background:rgba(153,102,204,.08);border:1px solid rgba(153,102,204,.3);color:var(--pu);font-family:var(--font-mono);font-size:13px;border-radius:2px;cursor:pointer;transition:all .2s;letter-spacing:1px;white-space:nowrap}
.refine-btn:hover{background:rgba(153,102,204,.18);border-color:var(--pu)}
.refine-btn:disabled{opacity:.4;cursor:not-allowed}
.refine-btn.loading{animation:pulse .8s ease-in-out infinite}

/* ── 중단 버튼 ── */
.abort-btn{padding:10px 18px;border:1px solid rgba(232,93,4,.4);background:rgba(232,93,4,.08);color:var(--or);font-family:var(--font-mono);font-size:15px;font-weight:600;letter-spacing:1px;text-transform:uppercase;cursor:pointer;border-radius:2px;transition:all .2s;display:none;align-items:center;gap:6px}
.abort-btn:hover{background:rgba(232,93,4,.18);border-color:var(--or)}
.abort-btn.visible{display:inline-flex}
.ref-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:7px}
.ref-cell{background:var(--s2);border:1px solid var(--bd);border-radius:2px;padding:7px;cursor:pointer;transition:border-color .2s}
.ref-cell:hover{border-color:var(--bl)}
.ref-cell-lbl{font-family:var(--font-mono);font-size:13px;color:var(--mu);margin-bottom:4px;display:flex;align-items:center;justify-content:space-between}
.ref-cnt{font-size:16px;padding:1px 5px;background:rgba(0,102,204,.15);border:1px solid rgba(0,102,204,.3);color:var(--bl);border-radius:2px}
.ref-add{width:100%;height:48px;display:flex;align-items:center;justify-content:center;font-family:var(--font-mono);font-size:15px;color:var(--mu);border:1.5px dashed var(--bd);border-radius:2px;cursor:pointer;transition:all .2s;background:transparent}
.ref-add:hover{border-color:var(--bl);color:var(--bl)}
.ref-thumbs{display:flex;flex-wrap:wrap;gap:3px;margin-top:3px}
.ref-th{width:22px;height:22px;object-fit:cover;border-radius:2px;border:1px solid var(--bd)}

/* ═══ OUTPUT COUNT + RESOLUTION ═══ */
.out-opts{background:var(--s2);border:1px solid var(--bd);border-radius:2px;padding:14px 16px;margin-bottom:16px;display:flex;align-items:center;gap:24px;flex-wrap:wrap}
.out-opt-group{display:flex;align-items:center;gap:10px}
.out-opt-label{font-family:var(--font-mono);font-size:14px;color:var(--tx);letter-spacing:1.5px;white-space:nowrap;font-weight:700}
.seg{display:flex;border:1px solid var(--bd);border-radius:2px;overflow:hidden}
.seg-btn{padding:7px 16px;background:transparent;border:none;color:var(--mu);font-family:var(--font-mono);font-size:15px;cursor:pointer;transition:all .2s;border-right:1px solid var(--bd)}
.seg-btn:last-child{border-right:none}
.seg-btn:hover{background:rgba(0,0,0,.05);color:var(--tx)}
.seg-btn.on{background:rgba(0,102,204,.2);color:var(--bl)}
.out-note{font-family:var(--font-mono);font-size:13px;color:var(--mu);margin-left:auto}

/* ═══ MULTI-IMAGE OUTPUT GRID ═══ */
.img-out-grid{display:grid;gap:14px;margin-top:14px}
.img-out-grid.g1{grid-template-columns:1fr}
.img-out-grid.g2{grid-template-columns:1fr 1fr}
.img-out-grid.g3{grid-template-columns:1fr 1fr 1fr}
.img-out-grid.g4{grid-template-columns:1fr 1fr;grid-template-rows:auto auto}
.img-card{background:var(--sf);border:1px solid var(--bd);border-radius:2px;overflow:hidden}
.img-card-hdr{padding:8px 12px;background:var(--s2);border-bottom:1px solid var(--bd);display:flex;align-items:center;justify-content:space-between}
.img-card-lbl{font-family:var(--font-mono);font-size:13px;color:var(--bl);letter-spacing:1px}
.img-card img{width:100%;display:block}
.img-card-actions{padding:8px 12px;display:flex;gap:6px;background:var(--s2);border-top:1px solid var(--bd)}
.img-skeleton{width:100%;aspect-ratio:16/9;background:linear-gradient(90deg,var(--s2) 25%,var(--bd) 50%,var(--s2) 75%);background-size:200% 100%;animation:skel 1.5s infinite}
@keyframes skel{0%{background-position:200% 0}100%{background-position:-200% 0}}
.gen-progress{padding:12px 14px;font-family:var(--font-mono);font-size:14px;color:var(--cy);text-align:center}

/* Sheet preview */
.sheet-row{display:flex;gap:14px;margin-top:11px;align-items:flex-start}
.sheet-th{width:160px;height:100px;object-fit:cover;border:1px solid var(--bd);border-radius:2px;flex-shrink:0}

/* ═══ STEP 3 — VARIATION MATRIX ═══ */
.var-cfg{background:var(--sf);border:1px solid var(--bd);border-radius:2px;padding:18px;margin-bottom:16px}
.var-row{display:grid;grid-template-columns:1fr 1fr;gap:20px}
@media(max-width:600px){.var-row{grid-template-columns:1fr}}
.var-section{/* each shot/angle column */}
.var-lbl{font-family:var(--font-mono);font-size:14px;letter-spacing:1.5px;color:var(--mu);text-transform:uppercase;margin-bottom:9px;display:flex;align-items:center;justify-content:space-between}
.var-lbl span{font-size:13px;color:var(--bl);cursor:pointer}
.var-lbl span:hover{color:var(--cy)}
.vchips{display:flex;flex-wrap:wrap;gap:6px}
.vchip{padding:6px 13px;border:1px solid var(--bd);background:transparent;color:var(--mu);font-family:var(--font-body);font-size:16px;border-radius:20px;cursor:pointer;transition:all .2s;user-select:none;white-space:nowrap}
.vchip:hover{border-color:var(--cy);color:var(--tx)}
.vchip.on{background:rgba(153,102,204,.15);border-color:var(--pu);color:var(--tx)}

/* ═══ STEP 1 — 시트 타입 탭 ═══ */
.s1type-tabs{display:grid;grid-template-columns:repeat(3,1fr);gap:7px;margin-bottom:14px}
.s1type{padding:11px 10px;border:1.5px solid var(--bd);background:var(--s2);color:var(--mu);font-family:var(--font-body);font-size:16px;border-radius:4px;cursor:pointer;text-align:center;transition:all .2s}
.s1type:hover{border-color:var(--or)}
.s1type.on{background:rgba(232,93,4,.1);border-color:var(--or);color:var(--tx)}
.s1type .s1ico{font-size:18px;display:block;margin-bottom:4px}
.s1type .s1lbl{font-size:13px;font-weight:700;display:block;margin-bottom:2px}
.s1type .s1desc{font-size:14px;color:var(--mu);line-height:1.4}
.s1type.on .s1desc{color:rgba(232,93,4,.75)}
.s1hint{padding:10px 13px;background:rgba(0,136,204,.05);border:1px solid rgba(0,136,204,.2);border-radius:2px;font-family:var(--font-mono);font-size:14px;color:var(--cy);line-height:1.7;margin-bottom:12px}
.s1hint strong{color:var(--or)}

/* Variation matrix grid */
.var-grid{display:grid;gap:12px;margin-top:14px}
.var-col-header{font-family:var(--font-mono);font-size:13px;color:var(--pu);letter-spacing:1.5px;text-transform:uppercase;text-align:center;padding:6px 0}
.var-card{background:var(--sf);border:1px solid var(--bd);border-radius:2px;overflow:hidden;position:relative}
.var-card-label{padding:7px 10px;background:var(--s2);border-bottom:1px solid var(--bd);font-family:var(--font-mono);font-size:13px;color:var(--pu);display:flex;align-items:center;justify-content:space-between}
.var-card img{width:100%;display:block}
.var-card-skel{width:100%;aspect-ratio:3/4;background:linear-gradient(90deg,var(--s2) 25%,var(--bd) 50%,var(--s2) 75%);background-size:200% 100%;animation:skel 1.5s infinite}
.var-card-pending{width:100%;aspect-ratio:3/4;display:flex;align-items:center;justify-content:center;font-family:var(--font-mono);font-size:14px;color:var(--mu);background:var(--s2)}
.var-card-actions{padding:6px 10px;background:var(--s2);border-top:1px solid var(--bd);display:flex;gap:5px}
.var-progress-bar{height:2px;background:var(--bd);overflow:hidden}
.var-progress-fill{height:100%;background:linear-gradient(90deg,var(--pu),var(--cy));transition:width .4s}
.var-summary{font-family:var(--font-mono);font-size:15px;color:var(--cy);padding:10px 0;text-align:center}
/* ── 렌즈 탭 선택 ── */
.lens-tabs{display:flex;gap:6px;flex-wrap:wrap}
.lens-tab{padding:7px 16px;border:1px solid var(--bd);background:var(--s2);color:var(--mu);font-family:var(--font-mono);font-size:15px;cursor:pointer;border-radius:2px;transition:all .2s;letter-spacing:1px}
.lens-tab:hover{border-color:var(--bl);color:var(--tx)}
.lens-tab.on{background:rgba(0,102,204,.18);border-color:var(--bl);color:var(--bl)}
/* ── 렌즈별 결과 탭 ── */
.lens-result-tabs{display:flex;gap:4px;margin-bottom:14px;flex-wrap:wrap;border-bottom:1px solid var(--bd);padding-bottom:12px}
.lens-result-tab{padding:6px 16px;border:1px solid var(--bd);background:var(--s2);color:var(--mu);font-family:var(--font-mono);font-size:14px;cursor:pointer;border-radius:2px;transition:all .2s;letter-spacing:1px}
.lens-result-tab:hover{border-color:var(--bl)}
.lens-result-tab.active{background:rgba(0,102,204,.2);border-color:var(--bl);color:var(--bl)}
.lens-result-tab.done::after{content:' ✓';color:var(--ok)}
.lens-panel{display:none}
.lens-panel.active{display:block}

/* ── 캐릭터 카드 ── */
.char-card{padding:14px;border:2px solid var(--bd);border-radius:12px;background:var(--card);cursor:pointer;transition:all .18s;box-shadow:0 1px 3px rgba(30,58,95,.05);}
.char-card:hover{border-color:var(--bl);box-shadow:0 4px 12px rgba(30,58,95,.1);transform:translateY(-1px);}
.char-card.on{border-color:var(--bl);background:rgba(30,58,95,.04);box-shadow:0 0 0 3px rgba(30,58,95,.1);}

/* ═══ LANDING PAGE ═══ */
.landing{min-height:90vh;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:80px 32px;background:var(--bg)}
.landing-title{font-family:var(--font-mono);font-size:24px;font-weight:800;color:var(--tx);letter-spacing:4px;text-align:center;text-transform:uppercase}
.landing-sub{font-size:13px;color:var(--mu);margin-bottom:56px;text-align:center;font-family:var(--font-mono);letter-spacing:2px}
.landing-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:20px;max-width:1080px;width:100%}
@media(max-width:900px){.landing-grid{grid-template-columns:repeat(2,1fr)}}
@media(max-width:720px){.landing-grid{grid-template-columns:1fr}}
.project-card{border:1px solid var(--bd);border-radius:12px;padding:36px 28px;cursor:pointer;transition:all .25s cubic-bezier(.4,0,.2,1);background:var(--card);text-align:center;position:relative;overflow:hidden}
.project-card::before{content:'';position:absolute;top:0;left:0;right:0;height:3px;background:linear-gradient(90deg,var(--or),var(--bl));opacity:0;transition:opacity .2s}
.project-card:hover{border-color:#2563EB;box-shadow:0 8px 30px rgba(37,99,235,.1);transform:translateY(-3px)}
.project-card:hover::before{opacity:1}
.project-card .pc-icon{font-size:40px;margin-bottom:16px;display:block}
.project-card .pc-name{font-family:var(--font-body);font-size:18px;font-weight:800;color:var(--tx);margin-bottom:6px;letter-spacing:-.5px}
.project-card .pc-name-en{font-family:var(--font-mono);font-size:10px;color:#9CA3AF;margin-bottom:14px;letter-spacing:3px;text-transform:uppercase}
.project-card .pc-desc{font-size:13px;color:#6B7280;line-height:1.7}
.project-card.new{border-style:dashed;border-color:var(--s2)}
.project-card.new:hover{border-color:var(--bl);border-style:solid}
.project-card.new .pc-icon{opacity:.3;font-size:32px}
.workspace{display:none}
.workspace.active{display:block}
.ws-back{display:inline-flex;align-items:center;gap:5px;font-family:var(--font-mono);font-size:11px;color:var(--mu);cursor:pointer;padding:6px 12px;border:1px solid var(--bd);border-radius:8px;transition:var(--transition);background:var(--card)}
.ws-back:hover{border-color:var(--or);color:var(--or);background:rgba(37,99,235,.04)}
.ws-project-name{font-family:var(--font-mono);font-size:12px;color:var(--or);font-weight:700;letter-spacing:.5px}

/* ═══ UI REFINEMENT OVERRIDE ═══════════════════════════════ */

/* 전체 레이아웃 */
.app { max-width:1200px; padding:0 32px 120px; margin:0 auto; }

/* 헤더 */
.hdr { padding:16px 0; margin-bottom:20px; border-bottom:1px solid #F3F4F6; gap:12px; }
.logo {
  width:32px; height:32px; border-radius:6px;
  border:1.5px solid #111;
  font-size:10px; font-weight:800; letter-spacing:0;
  color:var(--tx); background:transparent;
}
.hdr h1 { font-size:14px; letter-spacing:2px; font-weight:700; color:var(--tx); text-transform:uppercase; }
.hdr p  { font-size:10px; margin-top:2px; color:#9CA3AF; letter-spacing:1px; }
.vb {
  font-size:9px; padding:3px 8px;
  border-radius:4px; border:1px solid var(--bd);
  background:transparent; color:#9CA3AF; font-weight:500;
}

/* API 바 */
.api-bar {
  border-radius:12px;
  padding:16px 20px;
  box-shadow:var(--shadow-sm);
  margin-bottom:20px;
  background:var(--card);
  border:1px solid var(--s2);
}
.api-inp {
  border-radius:8px; padding:9px 14px;
  font-size:13px; border:1.5px solid var(--s2);
  background:var(--sf);
  transition:var(--transition);
}
.api-inp:focus { border-color:var(--or); box-shadow:0 0 0 3px rgba(37,99,235,.1); background:var(--card); }
.msel { border-radius:8px; padding:9px 12px; border:1.5px solid var(--s2); background:var(--sf); font-size:13px; }
.ast  { border-radius:8px; font-size:11px; padding:6px 12px; font-weight:600; }

/* 스텝 네비 */
.snav {
  border-radius:0;
  border:none;
  border-bottom:1px solid #E5E7EB;
  overflow-x:auto;
  margin-bottom:24px;
  box-shadow:none;
  background:transparent;
}
.stab {
  padding:14px 20px; font-size:14px; font-weight:600;
  border-bottom:2px solid transparent;
  letter-spacing:.3px;
  text-align:center;
  transition:all .15s;
  color:#9CA3AF;
  text-transform:uppercase;
  background:transparent;
  white-space:nowrap;
}
.stab:hover { color:var(--tx); background:transparent; }
.stab:first-child { border-radius:0; }
.stab:last-child  { border-radius:0; }
.stab.a1 { border-bottom-color:#2563EB; background:transparent; color:#2563EB; font-weight:700; }
.stab.a2 { border-bottom-color:#2563EB; background:transparent; color:#2563EB; font-weight:700; }
.stab.a3 { border-bottom-color:#7C3AED; background:transparent; color:#7C3AED; font-weight:700; }

/* 섹션 레이블 */
.slbl { font-size:18px; letter-spacing:.2px; margin-bottom:24px; font-weight:700; line-height:1.5; color:var(--tx); }
.cfg-lbl { font-size:13px; letter-spacing:.5px; font-weight:600; color:#9CA3AF; margin-bottom:10px; line-height:1.5; text-transform:uppercase; }

/* 입력창 */
.ci {
  border-radius:8px; padding:12px 16px;
  border:1px solid var(--bd); background:var(--s2);
  font-size:15px; margin-bottom:12px;
  transition:all .15s;
  line-height:1.5;
}
.ci:focus { border-color:#2563EB; box-shadow:0 0 0 3px rgba(37,99,235,.08); background:var(--card); }
.ci::placeholder { font-size:12px; color:#D1D5DB; }

/* 칩 */
.chip {
  border-radius:6px; padding:9px 16px;
  font-size:14px; border:1px solid var(--bd);
  background:var(--card); font-weight:500;
  transition:all .15s;
  line-height:1.3;
  color:#6B7280;
}
.chip:hover { border-color:#2563EB; color:#2563EB; }
.chip.on {
  background:#EFF6FF;
  border-color:#2563EB; color:#2563EB;
  font-weight:600;
}

/* 버튼 */
.btn {
  border-radius:8px;
  padding:12px 24px;
  font-size:14px; font-weight:600;
  letter-spacing:.5px;
  transition:all .15s;
  box-shadow:none;
  border:none; cursor:pointer;
}
.bor { background:#111; color:#fff; }
.bor:hover { background:#333; transform:translateY(-1px); }
.bbl { background:#2563EB; color:#fff; }
.bbl:hover { background:#1D4ED8; transform:translateY(-1px); }
.bpu { background:#7C3AED; color:#fff; }
.bpu:hover { background:#6D28D9; transform:translateY(-1px); }
.bgh {
  background:var(--card); color:var(--tx);
  border:1px solid var(--bd);
}
.bgh:hover { border-color:#2563EB; color:#2563EB; }
.bsm { font-size:13px; padding:9px 18px; border-radius:6px; }

/* 아웃풋 카드 */
.ob {
  border-radius:12px;
  border:1px solid var(--s2);
  background:var(--card);
  overflow:hidden;
  box-shadow:var(--shadow-sm);
  margin-top:16px;
}
.ohd {
  padding:12px 20px;
  background:var(--sf);
  border-bottom:1px solid var(--s2);
}
.olb { font-size:12px; letter-spacing:.5px; font-weight:700; }
.otx { font-size:12px; line-height:1.8; padding:16px 20px; }

/* 씬 컨피그 */
.cfg-wrap {
  border-radius:12px; border:1px solid var(--bd); background:var(--card);
  box-shadow:none; overflow:hidden; margin-bottom:20px;
}
.cfg-hdr { padding:14px 20px; background:var(--s2); border-bottom:1px solid #E5E7EB; }
.cfg-body { gap:0; }
.cfg-left { padding:24px; border-right:1px solid #F3F4F6; }
.cfg-right { padding:24px; }
.cfg-sec { margin-bottom:20px; }
.cfg-sec + .cfg-sec { padding-top:20px; border-top:1px solid #F3F4F6; }
.cfg-ta {
  font-size:15px; line-height:1.7;
  padding:12px 16px; border-radius:8px;
  border:1px solid var(--bd); background:var(--s2);
  transition:all .15s;
}
.cfg-ta:focus { border-color:#2563EB; background:var(--card); }
.cfg-ta::placeholder { font-size:12px; color:#D1D5DB; }

/* 업로드 존 */
.muz {
  border-radius:12px; border:2px dashed var(--s2);
  padding:28px 24px; background:var(--sf);
  transition:var(--transition);
}
.muz:hover, .muz.drag {
  border-color:var(--or); background:rgba(37,99,235,.03);
  box-shadow:0 0 0 4px rgba(37,99,235,.06);
}

/* 썸네일 그리드 */
.tgrid {
  border-radius:10px; padding:12px; gap:8px;
  border:1px solid var(--s2);
  background:var(--sf);
}

/* 이미지 카드 */
.img-card { border-radius:12px; overflow:hidden; box-shadow:var(--shadow-sm); border:1px solid var(--s2); }
.var-card { border-radius:10px; overflow:hidden; box-shadow:var(--shadow-sm); }

/* 필/배지 */
.pill { border-radius:6px; font-size:10px; padding:3px 8px; font-weight:600; }
.req  { border-radius:5px; font-size:10px; padding:2px 7px; font-weight:700; }
.opt  { border-radius:5px; font-size:10px; padding:2px 7px; }

/* 세그먼트 버튼 */
.seg { border-radius:10px; overflow:hidden; border:1.5px solid var(--s2); }
.seg-btn { font-size:12px; padding:8px 16px; font-weight:500; transition:var(--transition); }
.seg-btn.on { background:rgba(37,99,235,.08); color:var(--or); font-weight:700; }

/* 스크롤바 */
::-webkit-scrollbar { width:5px; height:5px; }
::-webkit-scrollbar-track { background:transparent; }
::-webkit-scrollbar-thumb { background:var(--s2); border-radius:4px; }
::-webkit-scrollbar-thumb:hover { background:var(--mu); }

/* 부드러운 전환 */
.panel { animation:fadeIn .25s ease; }
@keyframes fadeIn { from{opacity:0;transform:translateY(4px)} to{opacity:1;transform:translateY(0)} }
.sb-shot{position:relative}
.sb-loading-ov{position:absolute;inset:0;background:rgba(10,12,16,.80);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10px;z-index:6;border-radius:8px;backdrop-filter:blur(1px)}
.sb-spin{width:34px;height:34px;border:3px solid rgba(255,255,255,.18);border-top-color:var(--or);border-radius:50%;animation:sbspin .8s linear infinite}
@keyframes sbspin{to{transform:rotate(360deg)}}
.sb-load-txt{font-family:var(--font-mono);font-size:11px;color:#fff;font-weight:700;text-align:center;padding:0 8px}

/* ═══ STORYBOARD ═══ */
.app:has(#pSB.active){max-width:1440px}
.sb-scene{min-width:0;border:1px solid var(--bd);border-radius:8px;overflow:hidden;background:var(--card)}
.sb-scene:last-child{}
#sbTimelineInner{display:grid !important;grid-template-columns:repeat(auto-fill,minmax(320px,1fr)) !important;gap:16px !important;min-width:0 !important}
#sbTimelineInner.sb-compact{grid-template-columns:repeat(auto-fill,minmax(220px,1fr)) !important;gap:10px !important}
@media (max-width:1400px){#sbTimelineInner{grid-template-columns:repeat(auto-fill,minmax(300px,1fr)) !important}}
@media (max-width:900px){#sbTimelineInner{grid-template-columns:1fr !important}}
.sb-scene-hdr{padding:10px 14px;background:var(--s2);border-bottom:1px solid var(--bd);font-family:var(--font-mono);font-size:13px;color:var(--or);font-weight:700;letter-spacing:.8px;position:sticky;top:0;z-index:1;line-height:1.5}
/* Sub-scene header (씬 단위 구분선) — 에피소드 내부에서 씬별 분할 */
.sb-subscene-hdr{width:100%;flex:0 0 100% !important;padding:10px 14px;background:linear-gradient(90deg,rgba(8,145,178,.1),transparent);border-top:1px solid rgba(8,145,178,.2);border-bottom:1px solid rgba(8,145,178,.15);font-family:var(--font-mono);font-size:12px;color:var(--cy);font-weight:700;letter-spacing:.5px;box-sizing:border-box}
.sb-subscene-hdr .cnt{opacity:.6;font-weight:400;font-size:10px;margin-left:6px}
/* 단일 에피소드 뷰 — 라지 기본값, 필요하면 컴팩트로 축소 */
#sbTimelineInner.single-ep-view{display:block !important;min-width:0 !important;width:100%}
#sbTimelineInner.single-ep-view .sb-scene{width:100%;min-width:0;border-right:none;border-bottom:2px solid var(--bd);display:flex;flex-wrap:wrap;align-content:flex-start}
#sbTimelineInner.single-ep-view .sb-scene-hdr{width:100%;flex:0 0 100%;position:sticky;top:0;z-index:2}
#sbTimelineInner.single-ep-view .sb-shot{flex:0 0 340px;width:340px;border-right:1px solid rgba(0,0,0,.06);border-bottom:1px solid rgba(0,0,0,.06)}
#sbTimelineInner.single-ep-view.sb-compact .sb-shot{flex-basis:220px;width:220px}
#sbTimelineInner.single-ep-view .sb-subscene-hdr{position:sticky;top:52px;z-index:1}
@media (max-width:760px){#sbTimelineInner.single-ep-view .sb-shot{flex:0 0 100%;width:100%}}
.sb-shot{padding:12px 14px;border-bottom:1px solid rgba(0,0,0,.06);transition:background .15s}
.sb-shot:hover{background:rgba(0,0,0,.02)}
.sb-shot-hdr{display:flex;align-items:center;justify-content:space-between;margin-bottom:8px;gap:8px}
.sb-shot-id{font-family:var(--font-mono);font-size:12px;color:var(--bl);font-weight:700;letter-spacing:.5px}
.sb-shot-pri{font-family:var(--font-mono);font-size:11px;padding:3px 8px;border-radius:5px;font-weight:600;white-space:nowrap}
.sb-shot-pri.must{background:rgba(232,93,4,.12);color:var(--or)}
.sb-shot-pri.opt{background:rgba(100,116,139,.1);color:var(--mu)}
.sb-shot-img{width:176px;height:99px;border-radius:6px;border:1px solid var(--bd);object-fit:cover;display:block;margin-bottom:8px;box-shadow:0 1px 4px rgba(0,0,0,.08);background:#111820}
.sb-shot-empty{width:176px;height:99px;border-radius:6px;border:1.5px dashed var(--bd);display:flex;align-items:center;justify-content:center;font-family:var(--font-mono);font-size:12px;color:var(--mu);cursor:pointer;transition:all .15s;margin-bottom:8px}
#sbTimelineInner .sb-shot-img{width:100%;height:170px;min-height:0}
#sbTimelineInner .sb-shot-empty{width:100%;height:170px;min-height:0;aspect-ratio:auto}
#sbTimelineInner.single-ep-view .sb-shot-img,#sbTimelineInner.single-ep-view .sb-shot-empty{height:175px}
#sbTimelineInner.sb-compact .sb-shot-img,#sbTimelineInner.sb-compact .sb-shot-empty{height:99px!important;min-height:0!important}
.sb-shot-empty:hover{border-color:var(--or);color:var(--or);background:rgba(232,93,4,.03)}
.sb-shot-info{font-size:12px;color:var(--mu);line-height:1.6}
.sb-shot-info strong{color:var(--tx);font-weight:600}
.sb-shot-desc{font-size:12px;color:var(--tx);line-height:1.5;margin-top:5px;max-width:176px}
#sbTimelineInner .sb-shot-desc{max-width:none}
.sb-density-toggle{display:inline-flex;align-items:center;border:1px solid var(--bd);border-radius:7px;overflow:hidden;background:var(--card);align-self:center}
.sb-density-btn{border:0;border-right:1px solid var(--bd);background:transparent;color:var(--mu);font-family:var(--font-mono);font-size:11px;font-weight:700;padding:7px 10px;cursor:pointer;line-height:1}
.sb-density-btn:last-child{border-right:0}
.sb-density-btn.on{background:rgba(245,158,11,.14);color:var(--or)}
.sb-subtabs{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:16px}
.sb-subtab{padding:9px 14px;border:1px solid var(--bd);background:var(--card);color:var(--mu);border-radius:8px;font-family:var(--font-mono);font-size:12px;font-weight:800;cursor:pointer}
.sb-subtab.on{border-color:var(--wn);background:rgba(217,119,6,.12);color:var(--wn)}
.sb-video-grid{display:grid;grid-template-columns:minmax(260px,.55fr) minmax(320px,1fr);gap:14px}
.sb-video-panel{border:1px solid var(--bd);border-radius:10px;background:var(--card);padding:14px}
.sb-video-preview{aspect-ratio:16/9;border:1.5px dashed var(--bd);border-radius:8px;background:var(--s2);display:flex;align-items:center;justify-content:center;overflow:hidden;color:var(--mu);font-family:var(--font-mono);font-size:12px}
.sb-video-preview img,.sb-video-preview video{width:100%;height:100%;object-fit:cover;display:block}
@media(max-width:900px){.sb-video-grid{grid-template-columns:1fr}}

/* Camera movement reference */
.cm-toolbar{display:grid;grid-template-columns:minmax(220px,1fr) auto;gap:10px;align-items:center;margin-bottom:14px}
.cm-search{padding:11px 12px;border:1px solid var(--bd);border-radius:8px;background:var(--sf);color:var(--tx);font-family:var(--font-mono);font-size:12px;outline:none}
.cm-search:focus{border-color:var(--pu);box-shadow:0 0 0 2px rgba(124,58,237,.12)}
.cm-filters{display:flex;gap:6px;flex-wrap:wrap;justify-content:flex-end}
.cm-filter{padding:8px 10px;border:1px solid var(--bd);border-radius:8px;background:var(--card);color:var(--mu);font-family:var(--font-mono);font-size:11px;font-weight:800;cursor:pointer}
.cm-filter.on{border-color:var(--pu);background:rgba(124,58,237,.12);color:var(--pu)}
.cm-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:12px}
.cm-card{border:1px solid var(--bd);border-radius:8px;background:var(--card);overflow:hidden;display:flex;flex-direction:column;min-height:360px}
.cm-card.active{border-color:var(--pu);box-shadow:0 0 0 2px rgba(124,58,237,.16)}
.cm-preview{position:relative;height:130px;overflow:hidden;background:#101820;border-bottom:1px solid var(--bd)}
.cm-preview video{width:100%;height:100%;object-fit:cover;display:block;background:#101820}
.cm-scene{position:absolute;inset:0;transform-origin:center;will-change:transform}
.cm-horizon{position:absolute;left:0;right:0;top:45%;height:1px;background:rgba(255,255,255,.12)}
.cm-layer{position:absolute;border:1px solid rgba(255,255,255,.22);background:rgba(255,255,255,.06)}
.cm-layer.l1{left:8%;top:18%;width:24%;height:54%}
.cm-layer.l2{right:10%;top:28%;width:18%;height:42%}
.cm-subject{position:absolute;left:50%;top:50%;width:34px;height:58px;transform:translate(-50%,-42%);border-radius:18px 18px 8px 8px;background:linear-gradient(#E5E7EB,#94A3B8);box-shadow:0 10px 22px rgba(0,0,0,.25)}
.cm-frame{position:absolute;inset:12px;border:1px solid rgba(255,255,255,.24);border-radius:4px;box-shadow:inset 0 0 0 1px rgba(0,0,0,.18)}
.cm-card-body{padding:12px;display:flex;flex-direction:column;gap:8px;flex:1}
.cm-kicker{font-family:var(--font-mono);font-size:10px;color:var(--pu);font-weight:900;letter-spacing:.8px;text-transform:uppercase}
.cm-name{font-family:var(--font-body);font-size:17px;color:var(--tx);font-weight:800;line-height:1.25}
.cm-desc{font-size:12px;color:var(--mu);line-height:1.5}
.cm-prompt{font-family:var(--font-mono);font-size:10px;color:var(--tx);line-height:1.55;background:var(--s2);border:1px solid var(--bd);border-radius:6px;padding:8px;white-space:pre-wrap;max-height:92px;overflow:auto}
.cm-actions{display:flex;gap:6px;flex-wrap:wrap;margin-top:auto}
.cm-mini-row{border:1px solid rgba(124,58,237,.22);border-radius:8px;background:rgba(124,58,237,.05);padding:10px 12px;margin:10px 0;display:grid;grid-template-columns:minmax(200px,1fr) auto auto;gap:8px;align-items:end}
.cm-mini-row label{display:grid;gap:5px;font-family:var(--font-mono);font-size:11px;color:var(--mu)}
.cm-select{padding:9px 10px;border:1px solid var(--bd);border-radius:6px;background:var(--sf);color:var(--tx);font-family:var(--font-mono);font-size:12px}
.cm-note{padding:12px 16px;background:rgba(124,58,237,.06);border:1px solid rgba(124,58,237,.2);border-radius:8px;margin-bottom:18px;font-family:var(--font-mono);font-size:13px;color:var(--pu);line-height:1.7}
.cm-preview.dolly-in .cm-scene{animation:cmZoomIn 2.4s ease-out 1 forwards}
.cm-preview.dolly-out .cm-scene{animation:cmZoomOut 2.4s ease-out 1 forwards}
.cm-preview.pan-right .cm-scene{animation:cmPanRight 2.2s ease-out 1 forwards}
.cm-preview.pan-left .cm-scene{animation:cmPanLeft 2.2s ease-out 1 forwards}
.cm-preview.tilt-up .cm-scene{animation:cmTiltUp 2.2s ease-out 1 forwards}
.cm-preview.tilt-down .cm-scene{animation:cmTiltDown 2.2s ease-out 1 forwards}
.cm-preview.slider-left .cm-scene{animation:cmSliderLeft 2.4s ease-out 1 forwards}
.cm-preview.slider-right .cm-scene{animation:cmSliderRight 2.4s ease-out 1 forwards}
.cm-preview.orbit .cm-scene{animation:cmOrbit 2.8s ease-out 1 forwards}
.cm-preview.orbit-ccw .cm-scene{animation:cmOrbitCCW 2.8s ease-out 1 forwards}
.cm-preview.handheld .cm-frame{animation:cmHandheld .8s ease-out 1 forwards}
.cm-preview.chase .cm-frame{animation:cmChase .38s ease-out 1 forwards}
.cm-preview.crane-up .cm-scene{animation:cmCraneUp 2.6s ease-out 1 forwards}
.cm-preview.crane-down .cm-scene{animation:cmCraneDown 2.6s ease-out 1 forwards}
.cm-preview.drone-in .cm-scene{animation:cmDroneIn 2.8s ease-out 1 forwards}
.cm-preview.drone-out .cm-scene{animation:cmDroneOut 2.8s ease-out 1 forwards}
.cm-preview.macro .cm-scene{animation:cmMacro 2.4s ease-out 1 forwards}
.cm-preview.whip .cm-scene{animation:cmWhip 1.2s cubic-bezier(.2,.7,.2,1) 1 forwards}
.cm-preview.whip-left .cm-scene{animation:cmWhipLeft 1.2s cubic-bezier(.2,.7,.2,1) 1 forwards}
.cm-preview.pov .cm-frame{animation:cmPov 1.5s ease-out 1 forwards}
.cm-preview.timelapse .cm-scene{animation:cmTimelapse 2.4s steps(4,end) 1 forwards}
@keyframes cmZoomIn{from{transform:scale(1)}to{transform:scale(1.22)}}
@keyframes cmZoomOut{from{transform:scale(1.22)}to{transform:scale(1)}}
@keyframes cmPanRight{from{transform:translateX(-8%)}to{transform:translateX(8%)}}
@keyframes cmPanLeft{from{transform:translateX(8%)}to{transform:translateX(-8%)}}
@keyframes cmTiltUp{from{transform:translateY(8%)}to{transform:translateY(-8%)}}
@keyframes cmTiltDown{from{transform:translateY(-8%)}to{transform:translateY(8%)}}
@keyframes cmSliderLeft{from{transform:translateX(5%) scale(1.04)}to{transform:translateX(-6%) scale(1.04)}}
@keyframes cmSliderRight{from{transform:translateX(-5%) scale(1.04)}to{transform:translateX(6%) scale(1.04)}}
@keyframes cmOrbit{from{transform:perspective(420px) rotateY(-8deg) scale(1.04)}to{transform:perspective(420px) rotateY(8deg) scale(1.04)}}
@keyframes cmOrbitCCW{from{transform:perspective(420px) rotateY(8deg) scale(1.04)}to{transform:perspective(420px) rotateY(-8deg) scale(1.04)}}
@keyframes cmHandheld{from{transform:translate(-1px,1px) rotate(-.25deg)}to{transform:translate(1px,-1px) rotate(.25deg)}}
@keyframes cmChase{from{transform:translate(-4px,2px) rotate(-.6deg)}to{transform:translate(4px,-2px) rotate(.6deg)}}
@keyframes cmCraneUp{from{transform:translateY(10%) scale(1.1)}to{transform:translateY(-10%) scale(.96)}}
@keyframes cmCraneDown{from{transform:translateY(-10%) scale(.96)}to{transform:translateY(10%) scale(1.1)}}
@keyframes cmDroneIn{from{transform:scale(.92) translateY(5%)}to{transform:scale(1.16) translateY(-3%)}}
@keyframes cmDroneOut{from{transform:scale(1.16) translateY(-3%)}to{transform:scale(.92) translateY(5%)}}
@keyframes cmMacro{from{transform:scale(1.05)}to{transform:scale(1.42) translateY(4%)}}
@keyframes cmWhip{0%,35%{transform:translateX(-16%) skewX(-2deg);filter:blur(0)}50%{transform:translateX(16%) skewX(4deg);filter:blur(3px)}70%,100%{transform:translateX(16%);filter:blur(0)}}
@keyframes cmWhipLeft{0%,35%{transform:translateX(16%) skewX(2deg);filter:blur(0)}50%{transform:translateX(-16%) skewX(-4deg);filter:blur(3px)}70%,100%{transform:translateX(-16%);filter:blur(0)}}
@keyframes cmPov{from{transform:scale(1) translateY(1px)}to{transform:scale(1.03) translateY(-2px)}}
@keyframes cmTimelapse{0%{filter:brightness(.85) saturate(.9)}35%{filter:brightness(1.15) saturate(1.05)}70%{filter:brightness(.95) saturate(1.25)}100%{filter:brightness(1.25) saturate(.8)}}
@media(max-width:760px){.cm-toolbar,.cm-mini-row{grid-template-columns:1fr}.cm-filters{justify-content:flex-start}}

/* ═══ VIDEO MODE ═══ */
.vid-btn{display:inline-flex;align-items:center;gap:4px;padding:6px 12px;border:1.5px solid var(--pu);background:rgba(124,58,237,.06);color:var(--pu);font-family:var(--font-mono);font-size:11px;font-weight:700;border-radius:6px;cursor:pointer;transition:all .12s;letter-spacing:.3px}
.vid-btn:hover{background:rgba(124,58,237,.15);box-shadow:0 2px 8px rgba(124,58,237,.15)}
.vid-btn:disabled{opacity:.4;cursor:not-allowed}
.vid-overlay{position:fixed;inset:0;background:rgba(0,0,0,.92);z-index:998;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:20px}
.vid-config{background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.15);border-radius:12px;padding:20px;max-width:500px;width:100%;backdrop-filter:blur(8px)}
.vid-config-title{font-family:var(--font-mono);font-size:15px;color:#fff;font-weight:700;margin-bottom:14px;letter-spacing:1px}
.vid-config-row{display:flex;align-items:center;gap:10px;margin-bottom:12px}
.vid-config-label{font-family:var(--font-mono);font-size:12px;color:rgba(255,255,255,.6);width:80px;flex-shrink:0}
.vid-config-seg{display:flex;gap:4px;flex:1}
.vid-seg{padding:7px 14px;border:1px solid rgba(255,255,255,.2);background:transparent;color:rgba(255,255,255,.5);font-family:var(--font-mono);font-size:12px;border-radius:6px;cursor:pointer;transition:all .12s}
.vid-seg:hover{border-color:rgba(255,255,255,.4)}
.vid-seg.on{background:rgba(124,58,237,.3);border-color:var(--pu);color:#fff;font-weight:700}
.vid-prompt-input{width:100%;padding:10px 14px;border:1px solid rgba(255,255,255,.2);background:rgba(255,255,255,.08);color:#fff;font-family:var(--font-body);font-size:13px;border-radius:8px;outline:none;margin-top:4px;line-height:1.5}
.vid-prompt-input::placeholder{color:rgba(255,255,255,.3)}
.vid-prompt-input:focus{border-color:var(--pu)}
.vid-result{margin-top:16px;text-align:center}
.vid-result video{max-width:100%;border-radius:8px;box-shadow:0 8px 32px rgba(0,0,0,.4)}
.vid-status{font-family:var(--font-mono);font-size:13px;color:rgba(255,255,255,.7);margin-top:10px}
.vid-warning{margin-top:10px;padding:8px 12px;background:rgba(217,119,6,.15);border:1px solid rgba(217,119,6,.3);border-radius:6px;font-family:var(--font-mono);font-size:10px;color:rgba(217,119,6,.9);text-align:center}

/* ═══ MOODBOARD ═══ */
.mb-wrap{border:1.5px solid var(--bd);border-radius:10px;overflow:hidden;margin-bottom:18px}
.mb-header{padding:12px 16px;background:var(--s2);border-bottom:1px solid var(--bd);display:flex;align-items:center;justify-content:space-between}
.mb-drop{border:2px dashed var(--bd);border-radius:8px;padding:30px 20px;text-align:center;cursor:pointer;transition:all .15s;background:var(--sf);min-height:120px}
.mb-drop:hover,.mb-drop.drag{border-color:var(--or);background:rgba(232,93,4,.03)}
.mb-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(120px,1fr));gap:8px;margin-top:10px}
.mb-card{position:relative;border-radius:6px;overflow:hidden;border:1px solid var(--bd);aspect-ratio:1;cursor:pointer;transition:all .12s}
.mb-card:hover{border-color:var(--or);box-shadow:0 2px 8px rgba(0,0,0,.1)}
.mb-card img{width:100%;height:100%;object-fit:cover;display:block}
.mb-card-del{position:absolute;top:4px;right:4px;width:18px;height:18px;background:rgba(0,0,0,.6);color:#fff;border:none;border-radius:50%;font-size:12px;cursor:pointer;display:flex;align-items:center;justify-content:center;opacity:0;transition:opacity .15s}
.mb-card:hover .mb-card-del{opacity:1}
.mb-extract{margin-top:14px;padding:14px;background:rgba(232,93,4,.04);border:1px solid rgba(232,93,4,.15);border-radius:8px}
.mb-extract-title{font-family:var(--font-mono);font-size:12px;color:var(--or);font-weight:700;margin-bottom:6px}
.mb-extract-text{font-family:var(--font-mono);font-size:12px;color:var(--tx);line-height:1.7;white-space:pre-wrap}
.mb-pinterest{margin-bottom:12px;display:flex;gap:8px;align-items:center}
.mb-pinterest input{flex:1;padding:8px 12px;border:1.5px solid var(--bd);border-radius:6px;font-family:var(--font-body);font-size:13px;outline:none;background:var(--card)}
.mb-pinterest input:focus{border-color:var(--or)}

/* ═══ EDIT TOOLS DROPDOWN ═══ */
.edit-dropdown{position:relative;display:inline-block}
.edit-dropdown-btn{display:inline-flex;align-items:center;gap:4px;padding:8px 14px;border:1.5px solid var(--bl);background:rgba(14,165,233,.06);color:var(--bl);font-family:var(--font-mono);font-size:12px;font-weight:700;border-radius:6px;cursor:pointer;transition:all .12s}
.edit-dropdown-btn:hover{background:rgba(14,165,233,.15)}
.edit-dropdown-menu{display:none;position:absolute;bottom:100%;left:0;margin-bottom:4px;background:var(--card);border:1.5px solid var(--bd);border-radius:8px;box-shadow:0 8px 24px rgba(0,0,0,.15);min-width:200px;z-index:100;overflow:hidden}
.edit-dropdown.open .edit-dropdown-menu{display:block}
.edit-menu-item{display:flex;align-items:center;gap:8px;padding:10px 14px;font-family:var(--font-body);font-size:13px;color:var(--tx);cursor:pointer;transition:background .1s;border-bottom:1px solid rgba(0,0,0,.04)}
.edit-menu-item:last-child{border-bottom:none}
.edit-menu-item:hover{background:rgba(14,165,233,.06)}
.edit-menu-item .emi-icon{font-size:15px;width:20px;text-align:center}
.edit-menu-item .emi-label{font-weight:600;font-size:12px}
.edit-menu-item .emi-desc{font-size:10px;color:var(--mu);margin-top:1px}

/* ═══ PRODUCT PLACEMENT ═══ */
.pp-overlay{position:fixed;inset:0;background:rgba(0,0,0,.92);z-index:997;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:20px}
.pp-config{background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.15);border-radius:12px;padding:20px;max-width:700px;width:100%;backdrop-filter:blur(8px)}
.pp-row{display:flex;gap:12px;align-items:flex-start;margin-bottom:14px;flex-wrap:wrap}
.pp-img-box{border:2px dashed rgba(255,255,255,.2);border-radius:8px;overflow:hidden;cursor:pointer;display:flex;align-items:center;justify-content:center;background:rgba(255,255,255,.05)}
.pp-img-box img{width:100%;height:100%;object-fit:cover}

/* ═══ MODIFY (Brush Inpainting) ═══ */
.mod-overlay{position:fixed;inset:0;background:rgba(0,0,0,.9);z-index:999;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:20px}
.mod-toolbar{display:flex;align-items:center;gap:12px;padding:10px 16px;background:rgba(255,255,255,.1);border-radius:8px;margin-bottom:12px;backdrop-filter:blur(4px)}
.mod-toolbar label{font-family:var(--font-mono);font-size:12px;color:rgba(255,255,255,.7)}
.mod-toolbar input[type=range]{width:100px;accent-color:#EF4444}
.mod-toolbar-btn{padding:6px 14px;border:1px solid rgba(255,255,255,.3);background:rgba(255,255,255,.1);color:#fff;font-family:var(--font-mono);font-size:12px;border-radius:6px;cursor:pointer;transition:all .12s}
.mod-toolbar-btn:hover{background:rgba(255,255,255,.25)}
.mod-toolbar-btn.primary{background:rgba(14,165,233,.6);border-color:rgba(14,165,233,.8)}
.mod-toolbar-btn.primary:hover{background:rgba(14,165,233,.8)}
.mod-canvas-wrap{position:relative;border-radius:8px;overflow:hidden;box-shadow:0 8px 32px rgba(0,0,0,.4)}
.mod-canvas-wrap canvas{display:block;cursor:crosshair}
.mod-prompt-row{display:flex;gap:8px;margin-top:12px;width:100%;max-width:700px}
.mod-prompt-input{flex:1;padding:10px 14px;border:1.5px solid rgba(255,255,255,.3);background:rgba(255,255,255,.1);color:#fff;font-family:var(--font-body);font-size:14px;border-radius:8px;outline:none;backdrop-filter:blur(4px)}
.mod-prompt-input::placeholder{color:rgba(255,255,255,.4)}
.mod-prompt-input:focus{border-color:rgba(14,165,233,.6)}
.mod-warning{margin-top:10px;padding:8px 14px;background:rgba(217,119,6,.15);border:1px solid rgba(217,119,6,.3);border-radius:6px;font-family:var(--font-mono);font-size:11px;color:rgba(217,119,6,.9);text-align:center}

/* ═══ HISTORY GALLERY ═══ */
.hist-bar{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:14px;flex-wrap:wrap}
