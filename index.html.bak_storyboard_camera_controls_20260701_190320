var SB_SP_MAP = {'SP-ALLEY':'SP-POLY','SP-ALLEY43':'SP-POLY','SP-BAR':'SP-LS-BAR','SP-LS':'SP-LS-BAR','SP-FAC-IN':'SP-FACIN','SP-FAC-OUT':'SP-FACOUT','SP-BORDER':'SP-BORDER-CHK','SP-WASTE':'SP-GRAY'};
function sbCodeOf(s){ var m=(s||'').match(/\[(SP-[A-Z0-9-]+|\uC5F4\uCC28)\]/i); return m?m[1].toUpperCase():''; }
function resolveShotLoc(shot){
  if(!shot) return '';
  if(shot.loc) return shot.loc;
  var names=(currentProject&&(currentProject.spaceNames||currentProject.locations))||[];
  if(!names.length) return '';
  var src=(shot.sceneName||'')+' '+(shot.frame||'')+' '+(shot.desc||'');
  var code=sbCodeOf(src);
  if(code){
    var want=(SB_SP_MAP[code]||code);
    for(var i=0;i<names.length;i++){ if(sbCodeOf(names[i])===want) return names[i]; }
    for(var j=0;j<names.length;j++){ var c=sbCodeOf(names[j]); if(c && (c.indexOf(code)===0||code.indexOf(c)===0)) return names[j]; }
  }
  var low=src.toLowerCase();
  for(var k=0;k<names.length;k++){ var base=names[k].replace(/\[[^\]]+\]/,'').trim().toLowerCase(); var toks=base.split(/[\s\u00B7,\-\/]+/).filter(function(x){return x.length>=2;}); if(toks.some(function(tk){return low.indexOf(tk)!==-1;})) return names[k]; }
  return '';
}

function sbFrameHas(raw, terms) {
  raw = raw || '';
  const upper = raw.toUpperCase();
  return terms.some(function(t) {
    return raw.indexOf(t) !== -1 || upper.indexOf(String(t).toUpperCase()) !== -1;
  });
}

function getSBCameraSpec(shot, preset) {
  const raw = (shot && shot.frame) || '';
  const lensMatch = raw.match(/(\d{2,3})\s*mm/i);
  let shotSize = (shot && shot.shot) || '';
  if (!shotSize) {
    if (sbFrameHas(raw, ['익스트림 클로즈업', 'EXTREME CLOSE', 'ECU'])) shotSize = 'extreme close-up';
    else if (sbFrameHas(raw, ['미디엄 클로즈업', 'MEDIUM CLOSE', 'MCU'])) shotSize = 'medium close-up';
    else if (sbFrameHas(raw, ['클로즈업', 'CLOSE-UP', 'CLOSE UP', 'CU'])) shotSize = 'close-up';
    else if (sbFrameHas(raw, ['익스트림 와이드', 'EXTREME WIDE', 'EWS'])) shotSize = 'extreme wide shot';
    else if (sbFrameHas(raw, ['와이드', 'WIDE', 'WS'])) shotSize = 'wide shot';
    else if (sbFrameHas(raw, ['풀샷', 'FULL SHOT', 'FS'])) shotSize = 'full shot';
    else if (sbFrameHas(raw, ['투샷', 'TWO SHOT', 'TWO-SHOT'])) shotSize = 'two-shot';
    else if (sbFrameHas(raw, ['미디엄', 'MEDIUM', 'MS'])) shotSize = 'medium shot';
    else if (sbFrameHas(raw, ['인서트', 'INSERT', 'INS'])) shotSize = 'insert / detail shot';
    else if (sbFrameHas(raw, ['OTS', 'OVER THE SHOULDER'])) shotSize = 'over-the-shoulder shot';
    else if (sbFrameHas(raw, ['백샷', 'BACK SHOT', 'BACKSHOT'])) shotSize = 'back shot';
    else if (sbFrameHas(raw, ['POV'])) shotSize = 'POV shot';
    else shotSize = '';
  }

  let lens = lensMatch ? (lensMatch[1] + 'mm') : ((shot && shot.lens) || '');

  let angle = (shot && shot.angle) || '';
  if (sbFrameHas(raw, ['부감', '오버헤드', '탑샷', 'TOP SHOT', 'OVERHEAD', 'BIRD'])) angle = 'overhead / bird-eye high angle';
  else if (sbFrameHas(raw, ['하이앵글', 'HIGH ANGLE'])) angle = 'high angle, looking down';
  else if (sbFrameHas(raw, ['로우앵글', 'LOW ANGLE'])) angle = 'low angle, looking up';
  else if (sbFrameHas(raw, ['정면', 'FRONT'])) angle = 'frontal camera position';
  else if (sbFrameHas(raw, ['측면', '사이드', 'SIDE'])) angle = 'side profile camera position';
  else if (sbFrameHas(raw, ['후면', '백샷', 'BACK SHOT', 'BACKSHOT'])) angle = 'rear / back camera position';

  let movement = '';
  if (sbFrameHas(raw, ['스냅 줌', 'SNAP ZOOM'])) movement = 'snap zoom energy frozen at the decisive frame';
  else if (sbFrameHas(raw, ['푸시인', 'PUSH IN', 'PUSH-IN', '느린 푸시'])) movement = 'slow push-in / dolly forward';
  else if (sbFrameHas(raw, ['트래킹 백', 'TRACKING BACK', 'DOLLY BACK'])) movement = 'slow tracking back / dolly backward';
  else if (sbFrameHas(raw, ['트래킹', 'TRACKING', 'DOLLY'])) movement = 'tracking / dolly movement';
  else if (sbFrameHas(raw, ['핸드헬드', 'HANDHELD'])) movement = 'subtle handheld camera';
  else if (sbFrameHas(raw, ['회전', 'ORBIT'])) movement = 'orbiting camera';
  else if (sbFrameHas(raw, ['고정', 'FIXED', 'LOCKED'])) movement = 'locked tripod';
  else if (sbFrameHas(raw, ['교차', 'CUTBACK', '컷백'])) movement = 'cross-cut framing rhythm';
  else if (sbFrameHas(raw, ['슬로모', 'SLOWMO', 'SLOW MOTION'])) movement = 'slow-motion decisive instant';

  let aperture = '';
  if (/extreme close|insert|detail/.test(shotSize)) aperture = 'f/2.0';
  else if (/close|medium close/.test(shotSize)) aperture = 'f/2.8';
  else if (/extreme wide|wide|full/.test(shotSize)) aperture = 'f/8';
  if (sbFrameHas(raw, ['액션', '질주', '돌파', '폭발', 'ACTION'])) aperture = 'f/4';

  const controls = (shot && typeof sbCameraControls !== 'undefined' && sbCameraControls[shot.id]) ? sbCameraControls[shot.id] : {};
  const body = controls.body || 'ARRI ALEXA 35';
  if (controls.camera) angle = controls.camera;
  if (controls.lens) lens = controls.lens;
  if (controls.aperture) aperture = controls.aperture;
  if (controls.movement) movement = controls.movement;

  const parts = [];
  if (shotSize) parts.push(shotSize);
  if (angle) parts.push(angle);
  if (lens) parts.push('ARRI Signature Prime ' + lens);
  if (aperture) parts.push(aperture);
  if (movement) parts.push(movement);
  const parsed = 'Frame intent: ' + (raw || '(not specified)') + '\n' +
    'Parsed camera directive: ' + (parts.length ? parts.join('; ') : '(no explicit camera directive parsed from storyboard frame)') + '.\n' +
    'The parsed directive is authoritative. Do NOT add generic eye-level, 35mm, or default aperture unless explicitly written in the storyboard frame.';
  return {
    body: body,
    frame: raw,
    shotSize: shotSize,
    angle: angle,
    lens: lens,
    aperture: aperture,
    movement: movement,
    summary: parsed,
    video: parts.length ? parts.join(', ') : raw
  };
}

// 📷 쇼트 프레임 정보 기반 자동 카메라 포지션 생성 (사용자 미입력 시)
function autoCameraPos(shot) {
  const rawFrame = shot.frame || '';
  const frame = rawFrame.toUpperCase();
  const desc = (shot.desc || '').toLowerCase();
  const variants = [];
  const spec = (typeof getSBCameraSpec === 'function') ? getSBCameraSpec(shot, {}) : null;
  const lens = (spec && spec.lens) ? spec.lens : 'storyboard-specified lens';

  if (sbFrameHas(rawFrame, ['익스트림 클로즈업', 'ECU', '초근접'])) {
    variants.push(lens + ' macro at eye/object level, 20-30cm distance, razor-thin depth of field, foreground edge bokeh');
  } else if (sbFrameHas(rawFrame, ['클로즈업', 'CU', '미디엄 클로즈업', 'MCU'])) {
    variants.push(lens + ' at face level, 70cm-1.2m distance, intimate portrait compression, asymmetric negative space');
  } else if (sbFrameHas(rawFrame, ['인서트', 'INSERT', 'INS'])) {
    variants.push(lens + ' insert framing, 45° top-side angle at 50cm, tactile surface detail visible, table/hand edge in foreground');
  } else if (sbFrameHas(rawFrame, ['OTS', '어깨'])) {
    variants.push(lens + ' over-the-shoulder camera, foreground shoulder 25% of frame, focus falls on opposite subject/object');
  } else if (sbFrameHas(rawFrame, ['투샷', 'TWO SHOT', 'TWO-SHOT'])) {
    variants.push(lens + ' two-shot at chest level, 1.8m distance, subjects separated by foreground practical object');
  } else if (sbFrameHas(rawFrame, ['미디엄', 'MS'])) {
    variants.push(lens + ' at chest level, 1.5m distance, subject on right third, foreground obstruction from wall edge or doorframe');
  } else if (sbFrameHas(rawFrame, ['익스트림 와이드', '와이드', '풀샷', 'WIDE', 'WS', 'FULL SHOT', 'FS'])) {
    variants.push(lens + ' wide camera 3-6m from subject, environment fills most of frame, foreground architecture creates depth layers');
  } else if (sbFrameHas(rawFrame, ['POV'])) {
    variants.push(lens + ' first-person POV at eye-level, handheld micro-tremor, slight forward lean');
  } else {
    variants.push('Use only the camera placement implied by the storyboard frame text; no generic eye-level / 35mm fallback.');
  }

  if (sbFrameHas(rawFrame, ['로우앵글', 'LOW ANGLE'])) {
    variants.push(' + camera below subject eye line, looking up 18-30°');
  } else if (sbFrameHas(rawFrame, ['하이앵글', '부감', 'HIGH ANGLE', 'OVERHEAD'])) {
    variants.push(' + camera above subject, looking down 25-60°');
  } else if (sbFrameHas(rawFrame, ['측면', '사이드', 'SIDE'])) {
    variants.push(' + side-profile blocking, lateral composition');
  } else if (sbFrameHas(rawFrame, ['백샷', 'BACK SHOT'])) {
    variants.push(' + rear camera position, subject back facing camera');
  }

  if (desc.indexOf('손') !== -1 || desc.indexOf('hand') !== -1) {
    variants.push(' + emphasize hand action with shallow DOF f/2.0');
  }
  if (desc.indexOf('걸음') !== -1 || desc.indexOf('이동') !== -1 || desc.indexOf('지나간') !== -1) {
    variants.push(' + tracking parallel to subject motion, dolly speed matched to walk');
  }
  if (desc.indexOf('멈춤') !== -1 || desc.indexOf('정지') !== -1) {
    variants.push(' + locked tripod, no camera movement, capture micro-stillness');
  }

  return variants.join('');
}
function buildStoryboardTimeline() {
  const inner = document.getElementById('sbTimelineInner');
  if (!inner) return;

  // 새 구조 감지: shot에 .ep 필드가 있으면 EP > Scene > Shots 계층
  const hasEpField = SB_SHOTS.length > 0 && typeof SB_SHOTS[0].ep !== 'undefined';
  const epTitles = (currentProject && currentProject.epTitles) || {};

  let html = '';

  if (hasEpField) {
    // 새 구조: EP별로 그룹화 + 각 EP 내부에서 Scene 섹션
    const eps = {};
    SB_SHOTS.forEach(s => {
      if (!eps[s.ep]) eps[s.ep] = {};
      const sceneKey = s.scene + '|' + (s.sceneName || '');
      if (!eps[s.ep][sceneKey]) eps[s.ep][sceneKey] = [];
      eps[s.ep][sceneKey].push(s);
    });
    const epNums = Object.keys(eps).map(Number).sort((a,b)=>a-b);

    epNums.forEach(ep => {
      const epPrefix = (currentProject && currentProject.sbEpLabel) ? currentProject.sbEpLabel : 'EP';
      const epLabel = (epTitles[ep] && ep < 0) ? epTitles[ep] : (epPrefix + ' ' + ('0'+ep).slice(-2) + ' ' + (epTitles[ep] || ''));
      const sceneEntries = Object.keys(eps[ep]).sort((a,b) => {
        return parseInt(a.split('|')[0]) - parseInt(b.split('|')[0]);
      });
      html += `<div class="sb-scene" data-scene="${ep}" data-ep="${ep}">`;
      html += `<div class="sb-scene-hdr">${epLabel}<br><span style="font-size:10px;color:var(--mu);font-weight:400">${sceneEntries.length} 씬 · ${Object.values(eps[ep]).reduce((a,b)=>a+b.length,0)} 쇼트</span></div>`;
      // Scene 섹션 단위 그룹 (ep 안에 여러 scene)
      sceneEntries.forEach(sceneKey => {
        const parts = sceneKey.split('|');
        const sceneIdx = parseInt(parts[0]);
        const sceneName = parts[1] || '';
        const shots = eps[ep][sceneKey];
        html += `<div class="sb-subscene-hdr" data-subscene="${sceneIdx}">S${sceneIdx} · ${sceneName} <span class="cnt">(${shots.length}쇼트)</span></div>`;
        shots.forEach(shot => {
          html += renderShotCard(shot, ep);
        });
      });
      html += `</div>`;
    });
    inner.innerHTML = html;
    updateSBProgress();
    // 대용량 기본 필터
    if (SB_SHOTS.length >= 100 && epNums.length > 1) {
      const firstEp = epNums[0];
      const epChips = document.querySelectorAll('#sbEpChips .chip');
      let targetBtn = null;
      epChips.forEach(c => { if (c.textContent.indexOf('EP' + ('0'+firstEp).slice(-2)) === 0) targetBtn = c; });
      if (targetBtn && typeof filterSBEp === 'function') filterSBEp(firstEp, targetBtn);
    }
    return;
  }

  // 구 구조: scene = 에피소드 (하위 호환)
  const scenes = {};
  SB_SHOTS.forEach(s => { if(!scenes[s.scene]) scenes[s.scene] = []; scenes[s.scene].push(s); });
  const sceneNums = Object.keys(scenes).map(Number).sort((a,b)=>a-b);
  sceneNums.forEach(sc => {
    const shots = scenes[sc] || [];
    const preset = SCENE_PRESETS[String(sc)] || {};
    const sbEpLabel = (currentProject && currentProject.sbEpLabel) || 'EP';
    const scLabel = sbEpLabel + ' ' + ('0'+sc).slice(-2);
    html += `<div class="sb-scene" data-scene="${sc}">`;
    html += `<div class="sb-scene-hdr">${scLabel}<br><span style="font-size:10px;color:var(--mu);font-weight:400">${preset.loc||''} / ${(preset.time||'').split('(')[0].trim()}</span></div>`;
    shots.forEach(shot => {
      const imgKey = shot.id;
      const hasImg = sbGenImages[imgKey];
      const ms2 = getSBRefMatchSummary(shot.scene, shot.id);
      const badge2 = '<span title="' + ms2.labels.join(' · ') + '" style="display:inline-flex;gap:4px;font-family:var(--font-mono);font-size:9px;color:var(--mu);margin-left:6px">' +
        (ms2.character ? '<span style="color:var(--or)">👤'+ms2.character+'</span>' : '') +
        (ms2.costume ? '<span style="color:var(--pu)">👗'+ms2.costume+'</span>' : '') +
        (ms2.background ? '<span style="color:var(--bl)">🏞'+ms2.background+'</span>' : '') +
        (ms2.prop ? '<span style="color:var(--gr)">📦'+ms2.prop+'</span>' : '') + '</span>';
      html += `<div class="sb-shot" data-scene="${sc}" id="sb-shot-${shot.id.replace(/[^a-z0-9]/gi,'-')}">`;
      html += `<div class="sb-shot-hdr"><span class="sb-shot-id">${shot.id}</span>${badge2}<span class="sb-shot-pri ${shot.pri}">${shot.pri==='must'?'필수':'선택'}</span></div>`;
