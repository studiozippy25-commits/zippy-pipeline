function premiereTimecode(seconds, fps) {
  fps = Math.max(1, Math.round(fps || 30));
  const total = Math.round(Number(seconds || 0) * fps);
  const ff = total % fps;
  const totalSeconds = Math.floor(total / fps);
  const ss = totalSeconds % 60;
  const mm = Math.floor(totalSeconds / 60) % 60;
  const hh = Math.floor(totalSeconds / 3600);
  return [hh, mm, ss, ff].map(function(n){return String(n).padStart(2, '0');}).join(':');
}
function premiereSrtTime(seconds) {
  const ms = Math.round((Number(seconds || 0) % 1) * 1000);
  const totalSeconds = Math.floor(Number(seconds || 0));
