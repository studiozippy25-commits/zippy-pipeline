const DEFAULT_GTI_BRIDGE_URL = 'http://127.0.0.1:8799';
function normalizeGtiBridgeUrl(url) {
  const raw = String(url || DEFAULT_GTI_BRIDGE_URL).trim() || DEFAULT_GTI_BRIDGE_URL;
  return raw.replace(/\/+$/, '');
}
function getGtiBridgeUrl() {
  try { return normalizeGtiBridgeUrl(localStorage.getItem('zippy_gti_bridge') || DEFAULT_GTI_BRIDGE_URL); } catch(e) { return DEFAULT_GTI_BRIDGE_URL; }
}
function rememberGtiBridgeUrl(url) {
  const normalized = normalizeGtiBridgeUrl(url);
  try { localStorage.setItem('zippy_gti_bridge', normalized); } catch(e) {}
  return normalized;
}
function getGtiBridgeCandidateUrls() {
  const primary = getGtiBridgeUrl();
  const urls = [primary, DEFAULT_GTI_BRIDGE_URL, 'http://localhost:8799'];
  if (/localhost/i.test(primary)) urls.push(primary.replace(/localhost/ig, '127.0.0.1'));
  if (/127\.0\.0\.1/.test(primary)) urls.push(primary.replace(/127\.0\.0\.1/g, 'localhost'));
  const seen = {};
  return urls.map(normalizeGtiBridgeUrl).filter(function(url) {
    if (!url || seen[url]) return false;
    seen[url] = true;
    return true;
  });
}
