function mapLabelToTask(label) {
  const l = (label||'').toLowerCase();
  if (l.includes('relight') || l.includes('조명')) return 'relight';
  if (l.includes('angle') || l.includes('앵글')) return 'angle';
  if (l.includes('outpaint') || l.includes('확장')) return 'outpaint';
