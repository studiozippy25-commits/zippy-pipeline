    if (sbFrameHas(raw, ['익스트림 클로즈업', 'EXTREME CLOSE', 'ECU'])) shotSize = 'extreme close-up';
    else if (sbFrameHas(raw, ['미디엄 클로즈업', 'MEDIUM CLOSE', 'MCU'])) shotSize = 'medium close-up';
    else if (sbFrameHas(raw, ['클로즈업', 'CLOSE-UP', 'CLOSE UP', 'CU'])) shotSize = 'close-up';
    else if (sbFrameHas(raw, ['익스트림 와이드', 'EXTREME WIDE', 'EWS'])) shotSize = 'extreme wide shot';
    else if (sbFrameHas(raw, ['와이드', 'WIDE', 'WS'])) shotSize = 'wide shot';
    else if (sbFrameHas(raw, ['풀샷', 'FULL SHOT', 'FS'])) shotSize = 'full shot';
    else if (sbFrameHas(raw, ['투샷', 'TWO SHOT', 'TWO-SHOT'])) shotSize = 'two-shot';
    else if (sbFrameHas(raw, ['미디엄', 'MEDIUM', 'MS'])) shotSize = 'medium shot';
    else if (sbFrameHas(raw, ['인서트', 'INSERT', 'INS'])) shotSize = 'insert / detail shot';
    else if (sbFrameHas(raw, ['OTS', 'OVER THE SHOULDER'])) shotSize = 'over-the-shoulder shot';
    else if (sbFrameHas(raw, ['백샷', 'BACK SHOT', 'BACKSHOT'])) shotSize = 'back shot';
    else if (sbFrameHas(raw, ['POV'])) shotSize = 'POV shot';
    else shotSize = '';
  }

  let lens = lensMatch ? (lensMatch[1] + 'mm') : ((shot && shot.lens) || '');

  let angle = (shot && shot.angle) || '';
  if (sbFrameHas(raw, ['부감', '오버헤드', '탑샷', 'TOP SHOT', 'OVERHEAD', 'BIRD'])) angle = 'overhead / bird-eye high angle';
  else if (sbFrameHas(raw, ['하이앵글', 'HIGH ANGLE'])) angle = 'high angle, looking down';
  else if (sbFrameHas(raw, ['로우앵글', 'LOW ANGLE'])) angle = 'low angle, looking up';
  else if (sbFrameHas(raw, ['정면', 'FRONT'])) angle = 'frontal camera position';
  else if (sbFrameHas(raw, ['측면', '사이드', 'SIDE'])) angle = 'side profile camera position';
  else if (sbFrameHas(raw, ['후면', '백샷', 'BACK SHOT', 'BACKSHOT'])) angle = 'rear / back camera position';

  let movement = '';
  if (sbFrameHas(raw, ['스냅 줌', 'SNAP ZOOM'])) movement = 'snap zoom energy frozen at the decisive frame';
  else if (sbFrameHas(raw, ['푸시인', 'PUSH IN', 'PUSH-IN', '느린 푸시'])) movement = 'slow push-in / dolly forward';
  else if (sbFrameHas(raw, ['트래킹 백', 'TRACKING BACK', 'DOLLY BACK'])) movement = 'slow tracking back / dolly backward';
  else if (sbFrameHas(raw, ['트래킹', 'TRACKING', 'DOLLY'])) movement = 'tracking / dolly movement';
  else if (sbFrameHas(raw, ['핸드헬드', 'HANDHELD'])) movement = 'subtle handheld camera';
  else if (sbFrameHas(raw, ['회전', 'ORBIT'])) movement = 'orbiting camera';
  else if (sbFrameHas(raw, ['고정', 'FIXED', 'LOCKED'])) movement = 'locked tripod';
  else if (sbFrameHas(raw, ['교차', 'CUTBACK', '컷백'])) movement = 'cross-cut framing rhythm';
  else if (sbFrameHas(raw, ['슬로모', 'SLOWMO', 'SLOW MOTION'])) movement = 'slow-motion decisive instant';

  let aperture = '';
  const apertureMatch = raw.match(/\bf\s*\/?\s*(1\.4|1\.8|2(?:\.0)?|2\.8|4|5\.6|8|11|16)\b/i);
  if (apertureMatch) aperture = 'f/' + apertureMatch[1].replace(/\.0$/, '');

  const controls = (shot && typeof sbCameraControls !== 'undefined' && sbCameraControls[shot.id]) ? sbCameraControls[shot.id] : {};
  const body = controls.body || '';
  if (controls.camera) angle = controls.camera;
  if (controls.lens) lens = controls.lens;
  if (controls.aperture) aperture = controls.aperture;
  if (controls.movement) movement = controls.movement;

  const parts = [];
  if (shotSize) parts.push(shotSize);
  if (angle) parts.push(angle);
  if (lens) parts.push('ARRI Signature Prime ' + lens);
  if (aperture) parts.push(aperture);
  if (movement) parts.push(movement);
  const parsed = 'Frame intent: ' + (raw || '(not specified)') + '\n' +
    'Parsed camera directive: ' + (parts.length ? parts.join('; ') : '(no explicit camera directive parsed from storyboard frame)') + '.\n' +
    'The parsed directive is authoritative. Do NOT add generic eye-level, 35mm, or default aperture unless explicitly written in the storyboard frame.';
  return {
    body: body,
    frame: raw,
    shotSize: shotSize,
    angle: angle,
    lens: lens,
    aperture: aperture,
    movement: movement,
    summary: parsed,
    video: parts.length ? parts.join(', ') : raw
  };
}

