function hydrateSBTimelineImages(root, opts) {
  const options = opts || {};
  const scope = root || document.getElementById('sbTimelineInner');
  if (!scope) return;
  const nodes = Array.from(scope.querySelectorAll('img[data-sb-img-key],img[data-sb-seq-key]'));
  let i = 0;
  function visible(el) {
    if (!options.visibleOnly) return true;
    const group = el.closest('.sb-scene');
    return !group || group.style.display !== 'none';
  }
  function step() {
    let n = 0;
    while (i < nodes.length && n < 12) {
      const img = nodes[i++];
      if (!visible(img)) {
        if (options.unloadHidden) {
          img.removeAttribute('src');
          delete img.dataset.hydratedB64Len;
        }
        continue;
      }
      let b64 = '';
      const key = img.getAttribute('data-sb-img-key');
      if (key && typeof sbGenImages !== 'undefined') b64 = sbGenImages[key] || '';
      const seqKey = img.getAttribute('data-sb-seq-key');
      if (!b64 && seqKey && typeof sbSeqImages !== 'undefined') {
        const idx = Number(img.getAttribute('data-sb-seq-index') || 0);
        const arr = sbSeqImages[seqKey];
        if (arr && arr[idx]) b64 = arr[idx];
      }
      if (b64 && (options.force || !img.getAttribute('src') || img.dataset.hydratedB64Len !== String(b64.length))) {
        img.src = 'data:image/png;base64,' + b64;
        img.dataset.hydratedB64Len = String(b64.length);
      }
      n++;
    }
    if (i < nodes.length) requestAnimationFrame(step);
  }
  requestAnimationFrame(step);
}

function hydrateVisibleSBTimelineImagesSoon(root) {
  const scope = root || document.getElementById('sbTimelineInner');
