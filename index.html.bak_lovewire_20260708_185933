async function requestLocalVideo(payload, onProgress, options) {
  const signal = options && options.signal;
  const base = getLocalVideoGatewayBase();
  const headers = getLocalVideoGatewayHeaders();
  throwIfVideoAborted(signal);
  if (onProgress) onProgress('ComfyUI 연결 확인 중...');
  const healthRes = await fetch(base + '/health', { headers, signal });
  const healthData = await healthRes.json().catch(() => ({}));
  throwIfVideoAborted(signal);
  if (!healthRes.ok || healthData.comfy_ok !== true) {
    if (healthRes.ok && healthData.comfy_ok == null) {
      throw new Error('Local 5080 Gateway 응답 형식이 구버전입니다. Downloads 폴더의 임시 server.mjs로 덮어쓰지 말고, Windows 최종 폴더 ZIPPY_BRIDGE_FINAL_RECOVERED/02_Local_5080/zippy-local-5080/server.mjs 상태를 확인하세요.');
    }
    throw new Error(healthData.comfy_error || healthData.error || healthData.hint || ('ComfyUI 연결 실패: HTTP ' + healthRes.status));
  }
  if (onProgress) onProgress('Local 5080 Gateway 전송 중... ComfyUI 응답 대기');
  let waitSeconds = 0;
  const ticker = onProgress ? setInterval(function(){
    waitSeconds += 5;
    onProgress('ComfyUI 처리 대기 중... (' + waitSeconds + '초) · ComfyUI 큐/콘솔을 확인하세요');
  }, 5000) : null;
  let createData;
  try {
    const createRes = await fetch(base + '/v1/videos/generations', {
      method: 'POST',
      headers,
      body: JSON.stringify(payload),
      signal
    });
    throwIfVideoAborted(signal);
    if (!createRes.ok) {
      const errData = await createRes.json().catch(() => ({}));
      throw new Error([errData.stage, errData.error || errData.message || ('HTTP ' + createRes.status), errData.hint].filter(Boolean).join(' · '));
    }
    createData = await createRes.json();
  } finally {
    if (ticker) clearInterval(ticker);
  }
  if (createData.video_url || createData?.video?.url) return createData.video_url || createData.video.url;
  const requestId = createData.request_id || createData.id;
  if (!requestId) throw new Error('로컬 게이트웨이 응답에 video_url/request_id가 없습니다');
  for (let i = 0; i < 120; i++) {
    await waitWithVideoAbort(5000, signal);
    if (onProgress) onProgress('로컬 렌더링 중... (' + ((i + 1) * 5) + '초 경과)');
    const pollRes = await fetch(base + '/v1/videos/' + encodeURIComponent(requestId), { headers, signal });
    if (!pollRes.ok) continue;
    const pollData = await pollRes.json();
    const status = pollData.status || pollData.state;
    if (status === 'done' || status === 'succeeded' || status === 'success') return pollData.video_url || pollData?.video?.url;
    if (status === 'failed' || status === 'error') throw new Error(pollData.error || pollData.message || '로컬 영상 생성 실패');
  }
  throw new Error('로컬 렌더링 시간 초과');
}
function makeVideoAbortError() {
  try { return new DOMException('Video generation aborted', 'AbortError'); }
  catch(e) { const err = new Error('Video generation aborted'); err.name = 'AbortError'; return err; }
}
function throwIfVideoAborted(signal) {
  if (signal && signal.aborted) throw makeVideoAbortError();
}
function waitWithVideoAbort(ms, signal) {
  return new Promise(function(resolve, reject) {
    if (signal && signal.aborted) return reject(makeVideoAbortError());
    const timer = setTimeout(resolve, ms);
    if (signal) {
      signal.addEventListener('abort', function() {
        clearTimeout(timer);
        reject(makeVideoAbortError());
      }, { once: true });
    }
  });
}
function isVideoAbortError(e) {
  return !!(e && (e.name === 'AbortError' || /aborted|abort|중단/i.test(e.message || String(e))));
