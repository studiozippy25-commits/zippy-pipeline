function selectProject(key) {
  currentProjectKey = key;
  currentProject = PROJECTS[key];
  if (!currentProject) return;

  // 프로젝트 전환 시 에셋 라이브러리/레퍼런스 캐시 초기화 (프로젝트 간 키비주얼 누출 방지)
  if (typeof assetLib !== 'undefined') {
    Object.keys(assetLib).forEach(function(k){ assetLib[k] = []; });
  }
  if (typeof sbRefs !== 'undefined') {
    Object.keys(sbRefs).forEach(function(k){ sbRefs[k] = null; });
  }

  // Show workspace, hide landing
  document.getElementById('landingPage').style.display = 'none';
  document.getElementById('workspace').classList.add('active');

  // Update header
  document.getElementById('wsProjectName').textContent = currentProject.icon + ' ' + currentProject.name;
  document.querySelector('.hdr h1').textContent = currentProject.name;

  // Update location chips
  const locContainer = document.querySelector('[data-g="loc"]')?.parentElement;
  if (locContainer) {
    locContainer.innerHTML = currentProject.locations.map(function(loc, i) {
      return '<button class="chip' + (i===0?' on':'') + '" data-g="loc" onclick="pickSingle(this,\'loc\')">' + loc + '</button>';
    }).join('');
  }

  // Update light chips
  if (currentProject.customLights.length > 0) {
    const lightContainer = document.querySelector('[data-g="light"]')?.parentElement;
    if (lightContainer) {
      lightContainer.innerHTML = currentProject.customLights.map(function(l, i) {
        return '<button class="chip' + (i===0?' on':'') + '" data-g="light" onclick="toggleChip(this)">' + l + '</button>';
      }).join('');
    }
  }

  // Update custom emotions section
  const emoSection = document.querySelector('#hist-filters')?.closest('.cfg-sec') || null;
  // Find the PoT emotions label and update
  const potEmoLabel = document.querySelectorAll('[data-g="emo"]')[0]?.closest('.chips')?.previousElementSibling;

  // Update Asset Library space names
  ['a','b','c','d'].forEach(function(letter, i) {
    const nameEl = document.getElementById('asset-space-' + letter + '-name');
    if (nameEl && currentProject.spaceNames[i]) {
      nameEl.value = currentProject.spaceNames[i];
    } else if (nameEl) {
      nameEl.value = '';
    }
  });

  // Show/hide storyboard tab
  const sbTab = document.getElementById('tabSB');
  if (sbTab) sbTab.style.display = currentProject.hasStoryboard ? '' : 'none';

  // Update history DB name
  if (typeof HIST_DB_NAME_BASE !== 'undefined') {
    // Will use project-specific DB on next openHistDB call
    histDB = null; // Reset DB connection
  }

  // Default ratio
  if (currentProject.defaultRatio) {
    document.querySelectorAll('[data-v]').forEach(function(btn) {
      if (btn.closest('#seg-ratio') && btn.dataset.v === currentProject.defaultRatio) {
        btn.parentElement.querySelectorAll('.seg-btn').forEach(function(b) { b.classList.remove('on'); });
        btn.classList.add('on');
      }
    });
  }

  // Load character presets
  if (typeof DRAMA_PRESETS !== 'undefined') {
    Object.keys(DRAMA_PRESETS).forEach(k => delete DRAMA_PRESETS[k]);
  }
  if (currentProject.characterPresets) {
    if (typeof DRAMA_PRESETS !== 'undefined') {
      Object.assign(DRAMA_PRESETS, currentProject.characterPresets);
    }
    // Update preset buttons
    const presetBtnContainer = document.querySelector('[onclick*="applyDramaPreset"]')?.parentElement;
    if (presetBtnContainer && Object.keys(currentProject.characterPresets).length > 0) {
      presetBtnContainer.innerHTML = Object.entries(currentProject.characterPresets).map(function(entry) {
        const key = entry[0], val = entry[1];
        const isLead = val.extra && val.extra.length > 50;
        const color = isLead ? 'var(--or)' : 'var(--bl)';
        return '<button onclick="applyDramaPreset(\'' + key + '\')" style="padding:8px 16px;border:1.5px solid ' + color + ';background:var(--card);color:' + color + ';font-family:var(--font-mono);font-size:12px;border-radius:4px;cursor:pointer;font-weight:700">' + key + '</button>';
      }).join('');
    }
  } else {
    // No characterPresets — clear buttons
    const presetBtnContainer = document.querySelector('[onclick*="applyDramaPreset"]')?.parentElement;
    if (presetBtnContainer) presetBtnContainer.innerHTML = '';
  }

  // Load scene presets
  if (typeof SCENE_PRESETS !== 'undefined') {
    // Backup original SCENE_PRESETS on first call
    if (typeof window.__SCENE_PRESETS_DEFAULT === 'undefined') {
      window.__SCENE_PRESETS_DEFAULT = Object.assign({}, SCENE_PRESETS);
    }
    Object.keys(SCENE_PRESETS).forEach(k => delete SCENE_PRESETS[k]);
  }
  if (currentProject.scenePresets && Object.keys(currentProject.scenePresets).length > 0) {
    if (typeof SCENE_PRESETS !== 'undefined') {
      Object.assign(SCENE_PRESETS, currentProject.scenePresets);
    }
    // Update scene preset dropdown
    const sel = document.getElementById('scenePresetSel');
    if (sel) {
      sel.innerHTML = '<option value="">— 씬 선택 —</option>';
      Object.keys(currentProject.scenePresets).forEach(function(k) {
        const p = currentProject.scenePresets[k];
        const opt = document.createElement('option');
        opt.value = k;
        opt.textContent = 'S' + k + '  ' + (p.loc||'') + ' / ' + (p.time||'').split('(')[0].trim();
        sel.appendChild(opt);
      });
    }
  } else if (typeof SCENE_PRESETS !== 'undefined' && typeof window.__SCENE_PRESETS_DEFAULT !== 'undefined') {
    // Restore default SCENE_PRESETS (e.g. PoT hardcoded data)
    Object.assign(SCENE_PRESETS, window.__SCENE_PRESETS_DEFAULT);
    const sel = document.getElementById('scenePresetSel');
    if (sel) {
      sel.innerHTML = '<option value="">— 씬 선택 —</option>';
      Object.keys(SCENE_PRESETS).forEach(function(k) {
        const p = SCENE_PRESETS[k];
        const opt = document.createElement('option');
        opt.value = k;
        opt.textContent = 'S' + k + '  ' + (p.loc||'') + ' / ' + (p.time||'').split('(')[0].trim();
        sel.appendChild(opt);
      });
    }
  } else {
    const sel = document.getElementById('scenePresetSel');
    if (sel) sel.innerHTML = '<option value="">— 프리셋 없음 —</option>';
  }

  // Load storyboard data
  if (typeof SB_SHOTS !== 'undefined') {
    // Backup original SB_SHOTS on first call
    if (typeof window.__SB_SHOTS_DEFAULT === 'undefined') {
      window.__SB_SHOTS_DEFAULT = SB_SHOTS.slice();
    }
    SB_SHOTS.length = 0;
    if (currentProject.storyboardShots && currentProject.storyboardShots.length > 0) {
      currentProject.storyboardShots.forEach(function(s) { SB_SHOTS.push(s); });
    } else {
      // No project-specific shots → fall back to the built-in legacy sample
      // (구형 8분판 스토리보드, 1~16씬). 특정 프로젝트 데이터가 아님.
      window.__SB_SHOTS_DEFAULT.forEach(function(s) { SB_SHOTS.push(s); });
    }
  }

  // Build episode selector chips
  var sbEpSelector = document.getElementById('sbEpSelector');
  var sbEpChips = document.getElementById('sbEpChips');
  if (sbEpSelector && sbEpChips && currentProject.storyboardShots && currentProject.storyboardShots.length > 0) {
    var epSet = {};
    var hasEpField = currentProject.storyboardShots.length > 0 && typeof currentProject.storyboardShots[0].ep !== 'undefined';
    currentProject.storyboardShots.forEach(function(s) {
      var key = hasEpField ? s.ep : s.scene;
      epSet[key] = (epSet[key]||0)+1;
    });
    var epNums = Object.keys(epSet).map(Number).sort(function(a,b){return a-b;});
    if (epNums.length > 6) {
      sbEpSelector.style.display = 'block';
      var html = '<button class="chip on" style="font-size:11px;padding:6px 12px" onclick="filterSBEp(0,this)">전체 (' + currentProject.storyboardShots.length + ')</button>';
      epNums.forEach(function(ep) {
        html += '<button class="chip" style="font-size:11px;padding:6px 12px" onclick="filterSBEp('+ep+',this)">'+sbGroupChipLabel(ep)+' <span style="opacity:.5;font-size:10px">('+epSet[ep]+')</span></button>';
      });
      sbEpChips.innerHTML = html;
    } else {
      sbEpSelector.style.display = 'none';
    }
  } else if (sbEpSelector) {
    sbEpSelector.style.display = 'none';
  }

  // Update storyboard title
  var sbTitleEl = document.getElementById('sbTitle');
  if (sbTitleEl && currentProject.storyboardShots) {
    var maxScene = 0;
    currentProject.storyboardShots.forEach(function(s) { if (s.scene > maxScene) maxScene = s.scene; });
    sbTitleEl.textContent = 'STORYBOARD — ' + currentProject.name + ' · ' + maxScene + (currentProject.episodeLabel || '씬') + ' · ' + currentProject.storyboardShots.length + '쇼트';
  } else if (sbTitleEl) {
    sbTitleEl.textContent = 'STORYBOARD — 타임라인';
  }

  // Build storyboard reference UI dynamically
  buildSBRefUI();
