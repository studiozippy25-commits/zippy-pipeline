/* ═══ MODIFY (Brush Inpainting) ═══ */
let modImgB64 = null;
let modImgMime = 'image/png';
let modIsDrawing = false;
let modIsEraser = false;
let modOrigW = 0, modOrigH = 0;

function openModOverlay(imgB64, mime) {
  modImgB64 = imgB64;
  modImgMime = mime || 'image/png';
  modIsEraser = false;
  document.getElementById('modEraserBtn').textContent = '지우개';
  document.getElementById('modOverlay').style.display = 'flex';
  document.getElementById('modPrompt').value = '';

  const img = new Image();
  img.onload = function() {
    modOrigW = img.width;
    modOrigH = img.height;
    // Scale to fit screen
    const maxW = Math.min(700, window.innerWidth - 60);
    const maxH = Math.min(500, window.innerHeight - 250);
    let w = img.width, h = img.height;
    if (w > maxW) { h = h * maxW / w; w = maxW; }
    if (h > maxH) { w = w * maxH / h; h = maxH; }
    w = Math.round(w); h = Math.round(h);

    const bg = document.getElementById('modCanvasBg');
    const mask = document.getElementById('modCanvasMask');
    bg.width = w; bg.height = h;
    mask.width = w; mask.height = h;

    const bgCtx = bg.getContext('2d');
    bgCtx.drawImage(img, 0, 0, w, h);

    const maskCtx = mask.getContext('2d');
    maskCtx.clearRect(0, 0, w, h);

    // Drawing events
    mask.onmousedown = function(e) { modIsDrawing = true; drawModBrush(e, maskCtx); };
    mask.onmousemove = function(e) { if (modIsDrawing) drawModBrush(e, maskCtx); };
    mask.onmouseup = function() { modIsDrawing = false; };
    mask.onmouseleave = function() { modIsDrawing = false; };
    // Touch support
    mask.ontouchstart = function(e) { e.preventDefault(); modIsDrawing = true; drawModBrush(e.touches[0], maskCtx, mask); };
    mask.ontouchmove = function(e) { e.preventDefault(); if (modIsDrawing) drawModBrush(e.touches[0], maskCtx, mask); };
    mask.ontouchend = function() { modIsDrawing = false; };
  };
  img.src = 'data:' + modImgMime + ';base64,' + imgB64;
}

function drawModBrush(e, ctx, canvasEl) {
  const canvas = canvasEl || document.getElementById('modCanvasMask');
  const rect = canvas.getBoundingClientRect();
  const x = (e.clientX || e.pageX) - rect.left;
  const y = (e.clientY || e.pageY) - rect.top;
  const size = parseInt(document.getElementById('modBrushSize').value) || 25;

  ctx.beginPath();
  if (modIsEraser) {
    ctx.globalCompositeOperation = 'destination-out';
    ctx.arc(x, y, size / 2, 0, Math.PI * 2);
    ctx.fill();
    ctx.globalCompositeOperation = 'source-over';
  } else {
    ctx.fillStyle = 'rgba(239, 68, 68, 0.7)';
    ctx.arc(x, y, size / 2, 0, Math.PI * 2);
    ctx.fill();
  }
}

function clearModMask() {
  const mask = document.getElementById('modCanvasMask');
  const ctx = mask.getContext('2d');
  ctx.clearRect(0, 0, mask.width, mask.height);
}

function toggleModEraser() {
  modIsEraser = !modIsEraser;
  document.getElementById('modEraserBtn').textContent = modIsEraser ? '브러시' : '지우개';
  document.getElementById('modEraserBtn').style.background = modIsEraser ? 'rgba(239,68,68,.3)' : '';
}

function closeModOverlay() {
  document.getElementById('modOverlay').style.display = 'none';
  modImgB64 = null;
}

async function executeModify() {
  const prompt = document.getElementById('modPrompt').value.trim();
  if (!prompt) { document.getElementById('modPrompt').focus(); return; }
  if (!modImgB64) { alert('이미지가 없습니다'); return; }

