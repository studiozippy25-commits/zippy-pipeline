  const panel = document.getElementById('mc-panel-'+idx);
  if(!panel) return;
  panel.innerHTML = `
    <div style="display:flex;align-items:center;gap:8px;margin-bottom:10px">
      <label style="font-family:var(--font-mono);font-size:12px;color:var(--mu);display:flex;align-items:center;gap:6px;cursor:pointer">
        <input type="checkbox" ${c.enabled?'checked':''} onchange="toggleMcCut(${idx},this.checked)" style="width:16px;height:16px;accent-color:var(--bl)">
        <span>컷 ${idx+1} 활성</span>
      </label>
    </div>
    <div id="mc-content-${idx}" style="${c.enabled?'':'opacity:.35;pointer-events:none'}">
      <div style="font-family:var(--font-mono);font-size:11px;color:var(--mu);margin-bottom:6px">샷 사이즈</div>
      <div class="mc-shot-row">
        ${MC_SHOTS.map(s=>`<button class="mc-shot-btn ${c.shot===s?'on':''}" onclick="setMcShot(${idx},'${s}',this)">${s}</button>`).join('')}
      </div>
      <div style="display:flex;gap:16px;align-items:flex-start">
        <canvas id="mc-sphere-${idx}" width="120" height="120" class="mc-mini-sphere"></canvas>
        <div style="flex:1">
          <div class="ca-row"><span class="ca-label">Pan</span><input type="range" class="ca-slider" id="mc-pan-${idx}" min="-180" max="180" value="${c.pan}" step="5" oninput="updateMcCut(${idx})"><span class="ca-val" id="mc-pan-val-${idx}">${c.pan}°</span></div>
          <div class="ca-row"><span class="ca-label">Tilt</span><input type="range" class="ca-slider" id="mc-tilt-${idx}" min="-90" max="90" value="${c.tilt}" step="5" oninput="updateMcCut(${idx})"><span class="ca-val" id="mc-tilt-val-${idx}">${c.tilt}°</span></div>
          <div class="ca-row"><span class="ca-label">Dist</span><input type="range" class="ca-slider" id="mc-dist-${idx}" min="1" max="10" value="${c.dist}" step="1" oninput="updateMcCut(${idx})"><span class="ca-val" id="mc-dist-val-${idx}">${c.dist}m</span></div>
          <div class="ca-presets" style="margin-top:6px">
            <button class="ca-pre" onclick="setMcAngle(${idx},0,10,3)">정면</button>
            <button class="ca-pre" onclick="setMcAngle(${idx},45,10,3)">우45</button>
            <button class="ca-pre" onclick="setMcAngle(${idx},-45,10,3)">좌45</button>
            <button class="ca-pre" onclick="setMcAngle(${idx},180,10,3)">뒷면</button>
            <button class="ca-pre" onclick="setMcAngle(${idx},0,45,3)">하이</button>
            <button class="ca-pre" onclick="setMcAngle(${idx},0,-30,3)">로우</button>
          </div>
        </div>
      </div>
      <div class="ca-output" id="mc-output-${idx}" style="margin-top:8px"></div>
    </div>
  `;
  updateMcCut(idx);
}
function switchMcTab(idx) {
  mcActiveTab = idx;
  document.querySelectorAll('.mc-tab').forEach((t,i)=>t.classList.toggle('on',i===idx));
  document.querySelectorAll('.mc-panel').forEach((p,i)=>p.classList.toggle('on',i===idx));
  document.querySelectorAll('.mc-sum-card').forEach((c,i)=>c.classList.toggle('active',i===idx));
}
function toggleMcCut(idx, enabled) {
  MC_CUTS[idx].enabled = enabled;
  const content = document.getElementById('mc-content-'+idx);
  if(content) { content.style.opacity = enabled ? '' : '.35'; content.style.pointerEvents = enabled ? '' : 'none'; }
  // Update tab indicator
  document.querySelectorAll('.mc-tab')[idx]?.classList.toggle('has-data', enabled);
  updateMcCount();
  updateMcSummary();
}
function setMcShot(idx, shot, btn) {
  MC_CUTS[idx].shot = shot;
  const row = btn.parentElement;
  row.querySelectorAll('.mc-shot-btn').forEach(b=>b.classList.remove('on'));
  btn.classList.add('on');
  updateMcSummary();
}
function setMcAngle(idx, pan, tilt, dist) {
  document.getElementById('mc-pan-'+idx).value = pan;
  document.getElementById('mc-tilt-'+idx).value = tilt;
  document.getElementById('mc-dist-'+idx).value = dist;
  updateMcCut(idx);
}
function updateMcCut(idx) {
  const pan = parseInt(document.getElementById('mc-pan-'+idx)?.value||0);
  const tilt = parseInt(document.getElementById('mc-tilt-'+idx)?.value||0);
  const dist = parseInt(document.getElementById('mc-dist-'+idx)?.value||3);
  MC_CUTS[idx].pan = pan;
  MC_CUTS[idx].tilt = tilt;
  MC_CUTS[idx].dist = dist;
  const pv = document.getElementById('mc-pan-val-'+idx);
  const tv = document.getElementById('mc-tilt-val-'+idx);
  const dv = document.getElementById('mc-dist-val-'+idx);
  if(pv) pv.textContent = pan+'°';
  if(tv) tv.textContent = tilt+'°';
  if(dv) dv.textContent = dist+'m';
  const out = document.getElementById('mc-output-'+idx);
  if(out) out.textContent = MC_CUTS[idx].shot + ' | ' + getMcAngleDesc(pan,tilt,dist);
  drawMcSphere(idx);
  updateMcSummary();
}
function getMcAngleDesc(pan,tilt,dist) {
  let p='front';
  if(pan>150||pan<-150)p='behind';
  else if(pan>90)p='rear-R '+pan+'°';
  else if(pan<-90)p='rear-L '+pan+'°';
  else if(pan>30)p='R '+pan+'°';
  else if(pan<-30)p='L '+pan+'°';
  else if(pan>5)p='slight-R';
  else if(pan<-5)p='slight-L';
  else p='front';
  let t='eye';
  if(tilt>30)t='high '+tilt+'°';
  else if(tilt>5)t='s-high';
  else if(tilt>-5)t='eye';
  else if(tilt>-30)t='s-low';
  else t='low '+tilt+'°';
  return p+', '+t+', '+dist+'m';
}
function getMcAnglePromptFull(pan,tilt,dist) {
  let panDir = 'directly in front (0°)';
  if(pan > 150 || pan < -150) panDir = 'behind the subject';
  else if(pan > 90) panDir = 'rear-right (' + pan + '°)';
  else if(pan < -90) panDir = 'rear-left (' + pan + '°)';
  else if(pan > 30) panDir = 'front-right (' + pan + '°)';
  else if(pan < -30) panDir = 'front-left (' + pan + '°)';
  else if(pan > 5) panDir = 'slightly right (' + pan + '°)';
  else if(pan < -5) panDir = 'slightly left (' + pan + '°)';
  let tiltDir = 'eye level';
  if(tilt > 60) tiltDir = 'extreme top-down (' + tilt + '° tilt)';
  else if(tilt > 30) tiltDir = 'high angle (' + tilt + '° tilt)';
  else if(tilt > 5) tiltDir = 'slight high angle (' + tilt + '° tilt)';
  else if(tilt > -5) tiltDir = 'eye level';
  else if(tilt > -30) tiltDir = 'slight low angle (' + tilt + '° tilt)';
  else tiltDir = 'low angle (' + tilt + '° tilt)';
  let distDesc = 'medium distance (~' + dist + 'm)';
  if(dist <= 1) distDesc = 'extreme close (~0.5m)';
  else if(dist <= 2) distDesc = 'close (~' + dist + 'm)';
  else if(dist <= 4) distDesc = 'medium (~' + dist + 'm)';
  else if(dist <= 6) distDesc = 'far (~' + dist + 'm)';
  else distDesc = 'very far (~' + dist + 'm+)';
  return 'Camera: ' + panDir + ', ' + tiltDir + ', ' + distDesc;
}
function drawMcSphere(idx) {
  const canvas = document.getElementById('mc-sphere-'+idx);
  if(!canvas)return;
  const ctx=canvas.getContext('2d');
  const W=canvas.width,H=canvas.height,cx=W/2,cy=H/2,R=45;
  const pan=MC_CUTS[idx].pan, tilt=MC_CUTS[idx].tilt, dist=MC_CUTS[idx].dist;
  ctx.clearRect(0,0,W,H);
  ctx.strokeStyle='rgba(100,116,139,.25)';ctx.lineWidth=1;
  ctx.beginPath();ctx.arc(cx,cy,R,0,Math.PI*2);ctx.stroke();
  ctx.strokeStyle='rgba(100,116,139,.12)';
  ctx.beginPath();ctx.ellipse(cx,cy,R,R*.28,0,0,Math.PI*2);ctx.stroke();
  ctx.beginPath();ctx.ellipse(cx,cy,R*.28,R,0,0,Math.PI*2);ctx.stroke();
  ctx.fillStyle='rgba(100,116,139,.4)';ctx.beginPath();ctx.arc(cx,cy,3,0,Math.PI*2);ctx.fill();
  const panRad=(pan-90)*Math.PI/180;
  const tiltRad=tilt*Math.PI/180;
  const ds=0.5+(dist/10)*0.5;
  const camX=cx+Math.cos(panRad)*Math.cos(tiltRad)*R*ds;
  const camY=cy-Math.sin(tiltRad)*R*ds;
  ctx.strokeStyle='rgba(14,165,233,.25)';ctx.lineWidth=1;ctx.setLineDash([2,2]);
  ctx.beginPath();ctx.moveTo(cx,cy);ctx.lineTo(camX,camY);ctx.stroke();ctx.setLineDash([]);
  const sz=5+(10-dist)*0.3;
  ctx.fillStyle='#0EA5E9';ctx.beginPath();ctx.arc(camX,camY,sz,0,Math.PI*2);ctx.fill();
  ctx.strokeStyle='#fff';ctx.lineWidth=1.5;ctx.beginPath();ctx.arc(camX,camY,sz,0,Math.PI*2);ctx.stroke();
}
function updateMcCount() {
  const cnt = MC_CUTS.filter(c=>c.enabled).length;
  const el = document.getElementById('mc-count');
  if(el) el.textContent = cnt + ' / 4 컷 활성';
}
function updateMcSummary() {
  for(let i=0;i<4;i++){
    const el = document.getElementById('mc-sum-'+i);
    if(!el) continue;
    if(MC_CUTS[i].enabled) {
      el.textContent = MC_CUTS[i].shot + ' | ' + getMcAngleDesc(MC_CUTS[i].pan,MC_CUTS[i].tilt,MC_CUTS[i].dist);
    } else {
      el.textContent = '—';
    }
  }
  updateMcCount();
}
function getEnabledCuts() {
  return MC_CUTS.filter(c=>c.enabled).map(c=>({
    shot:c.shot, pan:c.pan, tilt:c.tilt, dist:c.dist,
    anglePrompt: getMcAnglePromptFull(c.pan,c.tilt,c.dist)
  }));
}
// Keep backward compat
function getCineAnglePrompt() {
  const cuts = getEnabledCuts();
  if(cuts.length===0) return '';
  return cuts[0].anglePrompt;
}
