const igHistory = [];
let igLastB64 = null;
let igLastMime = 'image/png';

async function generateIGImage() {
  const prompt = (document.getElementById('igPrompt')?.value || '').trim();
  if (!prompt) { alert('프롬프트를 입력하세요'); document.getElementById('igPrompt')?.focus(); return; }
  const ratio = document.getElementById('igRatio')?.value || '16:9';
  const resVal = document.getElementById('igRes')?.value || '1K';

  const btn = document.getElementById('igGenBtn');
  const stopBtn = document.getElementById('igStopBtn');
  const status = document.getElementById('igStatus');
  const resultWrap = document.getElementById('igResultWrap');
  btn.disabled = true; btn.textContent = '생성 중...';
  if (stopBtn) stopBtn.style.display = 'inline-block';
  window.__igAborted = false;
  window.__igAbortController = new AbortController();
  status.style.display = 'block';
  status.textContent = '이미지 생성 요청 중...';

  // 레퍼런스 이미지 (업로드된 무드보드 이미지)
  const refs = (typeof mbImages !== 'undefined' ? mbImages : []).map(im => ({b64: im.b64, mime: im.mime}));

  // Aspect ratio hint 추가
  const ratioMap = {'16:9':'wide cinematic 16:9 aspect ratio','9:16':'vertical 9:16 portrait aspect ratio','1:1':'square 1:1 aspect ratio','4:3':'4:3 aspect ratio','3:4':'3:4 portrait aspect ratio','2:3':'2:3 portrait aspect ratio','3:2':'3:2 landscape aspect ratio'};
  // Moodboard safety guide (적용: 레퍼런스가 있을 때)
  const moodGuide = refs.length > 0 ?
    '\n\nREFERENCE HANDLING:\nReference images may include concept moodboards or grid sheets containing multiple sample photos with text labels. ' +
    'CRITICAL — Do NOT replicate any grid/collage layout from references. Do NOT reproduce any text, captions, or labels visible in references. ' +
    'Extract ONLY: overall mood, color palette, lighting quality, material/texture characteristics, and atmospheric tone. ' +
    'Generate a SINGLE complete cinematic frame, NOT a collage or multi-panel image.\n' : '';
  const fullPrompt = prompt + moodGuide + '\n\nFRAME: ' + (ratioMap[ratio] || ratio) + '. Single complete frame, no border, no watermark, no text overlay.';

  try {
    const { imgB64 } = await callImageGen({
      images: refs,
      prompt: fullPrompt,
      resVal: resVal,
      onProgress: function(msg){ status.textContent = msg; }
    });
    if (!imgB64) throw new Error('이미지 없음');
    igLastB64 = imgB64; igLastMime = 'image/png';
    document.getElementById('igResult').src = 'data:image/png;base64,' + imgB64;
    resultWrap.style.display = 'block';
    status.style.display = 'none';
    igHistory.unshift({b64: imgB64, prompt: prompt, time: new Date().toLocaleTimeString()});
    renderIGHistory();
    if (typeof saveToHistory === 'function') saveToHistory(imgB64, 'ImageGen', prompt.slice(0, 50));
  } catch(e) {
    status.textContent = '실패: ' + e.message;
    status.style.background = 'rgba(239,68,68,.06)'; status.style.color = 'var(--er)';
  } finally {
    btn.disabled = false; btn.textContent = '▶ 이미지 생성';
    if (stopBtn) stopBtn.style.display = 'none';
    window.__igAborted = false;
  }
