  epGroups.forEach(function(group) {
    var epVal = parseInt(group.getAttribute('data-ep') || group.getAttribute('data-scene'));
    if (epNum === 0 || epVal === epNum) {
      group.style.display = '';
      var shots = group.querySelectorAll('.sb-shot');
