async function executeModify() {
  const prompt = document.getElementById('modPrompt').value.trim();
  if (!prompt) { document.getElementById('modPrompt').focus(); return; }
  if (!modImgB64) { alert('이미지가 없습니다'); return; }

  if (getImgMode() === 'cloud') {
    const key = document.getElementById('apiKey').value.trim();
    if (!key) { alert('Gemini API Key를 입력하세요 (또는 로컬 모드로 전환 — FLUX.1 Fill 사용)'); return; }
  }

  // Generate mask image (red areas on white bg)
  const mask = document.getElementById('modCanvasMask');
  const maskCanvas = document.createElement('canvas');
  maskCanvas.width = mask.width;
  maskCanvas.height = mask.height;
  const mCtx = maskCanvas.getContext('2d');
  mCtx.fillStyle = '#000000';
  mCtx.fillRect(0, 0, maskCanvas.width, maskCanvas.height);
  mCtx.drawImage(mask, 0, 0);
  const maskB64 = maskCanvas.toDataURL('image/png').split(',')[1];

  const btn = document.getElementById('modExecBtn');
  btn.disabled = true;
  btn.textContent = '수정 중...';

  try {
    const fullPrompt = `IMAGE EDITING INSTRUCTION:
The first image is the original photograph.
The second image is a mask — the RED/BRIGHT areas indicate the ONLY region you must modify.
All areas that are BLACK in the mask must remain COMPLETELY UNCHANGED — pixel-perfect preservation.

MODIFICATION: ${prompt}

CRITICAL RULES:
- ONLY modify the red-masked region
- Keep everything outside the mask identical to the original
- Maintain the same lighting, perspective, and style
- Output a single complete image (not cropped)
- Photorealistic quality, no artifacts at mask boundaries`;
    // 로컬 모드: callImageGen이 mask 파라미터를 통해 FLUX.1 Fill 워크플로우로 라우팅
    // 클라우드 모드: Gemini에 이미지+마스크+프롬프트 전달
    let newB64, newMime = 'image/png';
    if (getImgMode() === 'local') {
      const r = await callImageGen({
        images:[{b64:modImgB64, mime:modImgMime}],
        mask:{b64:maskB64, mime:'image/png'},
        prompt: prompt, // FLUX.1 Fill은 변경 지시만 받음 (마스크가 영역 지정)
        task:'inpaint',
        onProgress:(msg)=>{ btn.textContent = msg; }
      });
      newB64 = r.imgB64; newMime = r.mime || 'image/png';
    } else {
      // Gemini: 이미지 2개 (원본+마스크) + fullPrompt
      const r = await callGemini({
        images:[
          {b64:modImgB64, mime:modImgMime},
          {b64:maskB64, mime:'image/png'}
        ],
        prompt: fullPrompt, textOnly:false
      });
      newB64 = r.imgB64; newMime = r.mime || 'image/png';
    }
    if (!newB64) throw new Error('이미지 생성 실패');

    // Save to history
    saveToHistory(newB64, 'Modify-브러시수정', prompt.substring(0, 50));

    // Close overlay and show result
    closeModOverlay();

    // Show result in a modal-like display
    const resultDiv = document.createElement('div');
    resultDiv.className = 'hist-modal';
    resultDiv.style.display = 'flex';
    resultDiv.style.flexDirection = 'column';
    resultDiv.style.gap = '12px';
    resultDiv.onclick = function(e) { if (e.target === resultDiv) resultDiv.remove(); };
    resultDiv.innerHTML = `
      <button class="hist-modal-close" onclick="this.parentElement.remove()">✕</button>
      <div style="font-family:var(--font-mono);font-size:13px;color:rgba(255,255,255,.7);margin-bottom:4px">MODIFY 결과 — ${prompt.substring(0,40)}${prompt.length>40?'...':''}</div>
      <img src="data:${newMime};base64,${newB64}" style="max-width:90vw;max-height:75vh;border-radius:8px;box-shadow:0 8px 32px rgba(0,0,0,.4)">
      <div style="display:flex;gap:8px">
        <button class="hist-modal-btn" onclick="(function(){const a=document.createElement('a');a.href='data:${newMime};base64,${newB64}';a.download='modify_'+Date.now()+'.png';a.click()})()">⬇ 다운로드</button>
        <button class="hist-modal-btn" onclick="openModOverlay('${newB64}','${newMime}');this.closest('.hist-modal').remove()">⟳ 추가 수정</button>
      </div>
    `;
    document.body.appendChild(resultDiv);

  } catch (e) {
    alert('MODIFY 실패: ' + e.message);
  } finally {
    btn.disabled = false;
    btn.textContent = '수정 실행';
  }
}

/* ═══ HISTORY GALLERY (IndexedDB) ═══ */
const HIST_DB_NAME_BASE = 'studioZIPPY';
function getHistDBName() { return HIST_DB_NAME_BASE + '_' + (currentProjectKey || 'default') + '_History'; }
const HIST_DB_VER = 2;
const HIST_STORE = 'images';
let histDB = null;
let histModalData = null;

function openHistDB() {
  return new Promise((resolve, reject) => {
    if (histDB) { resolve(histDB); return; }
    const req = indexedDB.open(getHistDBName(), HIST_DB_VER);
    req.onupgradeneeded = e => {
      const db = e.target.result;
      if (!db.objectStoreNames.contains(HIST_STORE)) {
        const store = db.createObjectStore(HIST_STORE, {keyPath:'id',autoIncrement:true});
        store.createIndex('date','date');
        store.createIndex('step','step');
        store.createIndex('dedupeKey','dedupeKey', {unique:false});
      } else {
        const store = e.target.transaction.objectStore(HIST_STORE);
        if (!store.indexNames.contains('date')) store.createIndex('date','date');
        if (!store.indexNames.contains('step')) store.createIndex('step','step');
        if (!store.indexNames.contains('dedupeKey')) store.createIndex('dedupeKey','dedupeKey', {unique:false});
      }
    };
    req.onsuccess = e => {
      histDB = e.target.result;
      histDB.onversionchange = function() {
        try { histDB.close(); } catch(err) {}
        histDB = null;
      };
      resolve(histDB);
    };
    req.onerror = e => reject(e.target.error);
  });
}

async function saveToHistory(imgB64, step, desc) {
  try {
    const db = await openHistDB();
    const meta = (arguments.length > 3 && arguments[3] && typeof arguments[3] === 'object') ? arguments[3] : null;
    const dedupeKey = meta && meta.dedupeKey ? String(meta.dedupeKey) : '';
    if (dedupeKey) {
      const exists = await new Promise(resolve => {
        const tx = db.transaction(HIST_STORE, 'readonly');
        const store = tx.objectStore(HIST_STORE);
        const req = store.indexNames.contains('dedupeKey') ? store.index('dedupeKey').get(dedupeKey) : store.getAll();
        req.onsuccess = () => {
          if (Array.isArray(req.result)) resolve((req.result || []).some(function(item) { return item && item.dedupeKey === dedupeKey; }));
          else resolve(Boolean(req.result));
        };
        req.onerror = () => resolve(false);
      });
      if (exists) return null;
    }
    const tx = db.transaction(HIST_STORE, 'readwrite');
    const store = tx.objectStore(HIST_STORE);
    const now = new Date();
    const record = {
      b64: imgB64,
      mime: 'image/png',
      step: step,
      desc: desc || '',
      date: now.toISOString().split('T')[0],
      time: now.toTimeString().split(' ')[0].substring(0,5),
      timestamp: now.getTime()
    };
    if (meta) {
      record.meta = meta;
      if (dedupeKey) record.dedupeKey = dedupeKey;
    }
    store.add(record);
    await new Promise((resolve, reject) => {
      tx.oncomplete = resolve;
      tx.onerror = () => reject(tx.error);
      tx.onabort = () => reject(tx.error);
    });
    zippyNasSaveImage('history_' + (step || 'image'), (step || 'image') + '_' + record.timestamp, imgB64, 'image/png', record);
    return record;
  } catch(e) { console.warn('History save failed:', e); }
}

async function loadHistory() {
  try {
    const db = await openHistDB();
    return new Promise((resolve, reject) => {
      const tx = db.transaction(HIST_STORE, 'readonly');
      const store = tx.objectStore(HIST_STORE);
      const req = store.getAll();
      req.onsuccess = () => resolve(req.result || []);
      req.onerror = () => reject(req.error);
    });
  } catch(e) { return []; }
}

async function deleteFromHistory(id) {
  try {
    const db = await openHistDB();
    const tx = db.transaction(HIST_STORE, 'readwrite');
    tx.objectStore(HIST_STORE).delete(id);
    await new Promise(r => { tx.oncomplete = r; });
    refreshHistory();
  } catch(e) { console.warn('Delete failed:', e); }
}

async function clearHistory() {
  if (!confirm('히스토리의 모든 이미지를 삭제합니다. 계속할까요?')) return;
  try {
    const db = await openHistDB();
    const tx = db.transaction(HIST_STORE, 'readwrite');
    tx.objectStore(HIST_STORE).clear();
    await new Promise(r => { tx.oncomplete = r; });
    refreshHistory();
  } catch(e) { console.warn('Clear failed:', e); }
}

let histFilter = 'all';
const histRenderImages = {};

function histEsc(v) {
  return String(v == null ? '' : v).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}

function renderHistThumb(id, style) {
  const styleAttr = style ? ' style="' + histEsc(style) + '"' : '';
  return '<img alt="" data-hist-img-id="' + histEsc(id) + '" loading="lazy"' + styleAttr + '>';
}

function hydrateHistoryImages(root) {
  const scope = root || document.getElementById('hist-content') || document;
  const nodes = Array.from(scope.querySelectorAll('img[data-hist-img-id]'));
  let i = 0;
  function step() {
    let n = 0;
    while (i < nodes.length && n < 12) {
      const img = nodes[i++];
      const id = img.getAttribute('data-hist-img-id');
      const item = histRenderImages[id];
      if (item && item.b64 && img.dataset.hydratedB64Len !== String(item.b64.length)) {
        img.src = 'data:' + (item.mime || 'image/png') + ';base64,' + item.b64;
        img.dataset.hydratedB64Len = String(item.b64.length);
      }
      n++;
    }
    if (i < nodes.length) requestAnimationFrame(step);
  }
  requestAnimationFrame(step);
}

function filterHistory(f, btn) {
  histFilter = f;
  document.querySelectorAll('#hist-filters .chip').forEach(c => c.classList.remove('on'));
  if(btn) btn.classList.add('on');
  refreshHistory();
}

async function refreshHistory() {
  let items = await loadHistory();
  if (histFilter !== 'all') items = items.filter(i => (i.step||'').includes(histFilter));
  const content = document.getElementById('hist-content');
  const stats = document.getElementById('hist-stats');
  if (!content) return;

  if (items.length === 0) {
    content.innerHTML = '<div class="hist-empty">생성된 이미지가 없습니다.<br><span style="font-size:12px;opacity:.6">이미지를 생성하면 자동으로 여기에 저장됩니다.</span></div>';
    if(stats) stats.innerHTML = '이미지 <strong>0</strong>장 · <strong>0 MB</strong>';
    return;
  }

  // Calculate size
  let totalBytes = 0;
  items.forEach(it => totalBytes += (it.b64?.length || 0) * 0.75);
  const mb = (totalBytes / 1024 / 1024).toFixed(1);
  if(stats) stats.innerHTML = '이미지 <strong>' + items.length + '</strong>장 · <strong>' + mb + ' MB</strong>';

  // Group by date
  const groups = {};
  items.sort((a,b) => b.timestamp - a.timestamp);
  Object.keys(histRenderImages).forEach(function(k) { delete histRenderImages[k]; });
  items.forEach(it => {
    const d = it.date || 'unknown';
    if (!groups[d]) groups[d] = [];
    groups[d].push(it);
    histRenderImages[String(it.id)] = it;
  });

  let html = '';
  for (const [date, imgs] of Object.entries(groups)) {
    html += '<div class="hist-date-group">';
    html += '<div class="hist-date-label">' + histEsc(date) + ' (' + imgs.length + '장)</div>';
    html += '<div class="hist-grid">';
    imgs.forEach(img => {
      html += '<div class="hist-card" onclick="openHistModal('+img.id+')">';
      html += renderHistThumb(img.id);
      html += '<div class="hist-card-info">';
      html += '<div class="hist-card-step">' + histEsc(img.step||'') + '</div>';
      html += '<div class="hist-card-time">' + histEsc(img.time||'') + '</div>';
      html += '<div class="hist-card-desc">' + histEsc(img.desc||'') + '</div>';
      html += '<div class="hist-card-actions">';
      html += '<button class="hist-card-btn" onclick="event.stopPropagation();downloadHistImg('+img.id+')">⬇ 저장</button>';
      html += '<button class="hist-card-btn" onclick="event.stopPropagation();sendHistToAsset('+img.id+')">→ Asset</button>';
      html += '<button class="hist-card-btn" onclick="event.stopPropagation();sendHistToStoryboard('+img.id+')">→ 스토리보드</button>';
      html += '<button class="hist-card-btn del" onclick="event.stopPropagation();deleteFromHistory('+img.id+')">✕</button>';
      html += '</div></div></div>';
    });
    html += '</div></div>';
  }
  content.innerHTML = html;
  hydrateHistoryImages(content);
}

