/* ComfyUI API: /prompt → /history → /view → base64 */
async function runComfyWorkflow(workflow, signal=null, onProgress=null) {
  const hosts = getComfyHostCandidates();
  if (!hosts.length) throw new Error('ComfyUI 호스트 후보가 없습니다');
  const clientId = window.comfyClientId || ('zippy_' + Date.now());
  window.comfyClientId = clientId;
  const payload = JSON.stringify({prompt: workflow, client_id: clientId});
  let lastError = null;
  const tried = [];

  const runWorkflowOnHost = async function(host) {
    const submitRes = await fetch(host + '/prompt', {
      method:'POST', headers:getLocal5080GatewayHeaders({json:true}),
      body: payload, signal
    });
    if (!submitRes.ok) {
      const txt = await submitRes.text().catch(()=>'');
      throw new Error('ComfyUI 제출 실패: ' + txt.substring(0, 300));
    }
    const submitData = await submitRes.json();
    const promptId = submitData.prompt_id;
    if (!promptId) throw new Error('prompt_id 없음');
    if (onProgress) onProgress('대기열 진입...');

    const maxWait = 300000; // 5분
    const pollStart = Date.now();
    let historyEntry = null;
    while (Date.now() - pollStart < maxWait) {
      if (signal && signal.aborted) throw new Error('사용자 중단');
      await new Promise(r => setTimeout(r, 1500));
      const histRes = await fetch(host + '/history/' + promptId, {headers:getLocal5080GatewayHeaders(), signal});
      if (!histRes.ok) continue;
      const histData = await histRes.json();
      if (histData && histData[promptId]) {
        historyEntry = histData[promptId];
      if (historyEntry.status?.completed) break;
        if (historyEntry.status?.status_str === 'error') {
          const msgs = historyEntry.status?.messages || [];
          const reason = summarizeComfyStatusMessages(msgs);
          throw new Error('ComfyUI 오류: ' + (reason ? reason : JSON.stringify(msgs).substring(0, 300)));
        }
      }
      if (onProgress) {
        const elapsed = Math.floor((Date.now()-pollStart)/1000);
        onProgress('생성 중... ' + elapsed + 's');
      }
    }
    if (!historyEntry || !historyEntry.status?.completed) throw new Error('타임아웃 (5분)');

    const outputs = historyEntry.outputs || {};
    let imgInfo = null;
    for (const nodeId in outputs) {
      if (outputs[nodeId].images && outputs[nodeId].images.length) {
        imgInfo = outputs[nodeId].images[0];
        break;
      }
    }
    if (!imgInfo) throw new Error('출력 이미지 없음');
    const params = new URLSearchParams({
      filename: imgInfo.filename, subfolder: imgInfo.subfolder || '', type: imgInfo.type || 'output'
    });
    const imgRes = await fetch(host + '/view?' + params.toString(), {headers:getLocal5080GatewayHeaders(), signal});
    if (!imgRes.ok) throw new Error('이미지 다운로드 실패');
    const blob = await imgRes.blob();
    return await new Promise((resolve, reject) => {
      const reader = new FileReader();
      reader.onloadend = () => resolve({imgB64: reader.result.split(',')[1], mime: blob.type || 'image/png', textOut: ''});
      reader.onerror = reject;
      reader.readAsDataURL(blob);
    });
  };

  for (const host of hosts) {
    tried.push(host);
    try {
      return await runWorkflowOnHost(host);
    } catch (e) {
      if (e && (e.name === 'AbortError' || /abort/i.test(e.message || ''))) throw e;
      if (signal && signal.aborted) throw e;
      lastError = e;
    }
  }
  throw new Error('ComfyUI 실행 실패 (' + tried.join(' → ') + '). ' + ((lastError && lastError.message) || 'Failed to fetch'));
}

/* 통합 이미지 생성/편집 디스패처
 * task: 'txt2img' | 'edit' | 'relight' | 'angle' | 'shot-size' | 'style2real' | 'inpaint' | 'outpaint' | 'product-placement'
 * images: [{b64, mime}] 배열 (편집 대상)
 * mask: {b64, mime} (인페인팅용, 선택)
 */
async function callImageGen({images=[], prompt, task='txt2img', mask=null, resVal='1K', signal=null, width=null, height=null, onProgress=null, negative=''}) {
  prompt = enforceLiveActionPrompt(prompt);
  negative = enforceLiveActionNegative(negative);
  const mode = getImgMode();
  if (mode === 'cloud') {
    return await callGemini({images, prompt, textOnly: false, resVal, signal});
  }
  if (mode === 'gpt') {
    return await callGtiBridge({images, prompt, signal, onProgress});
  }
  if (mode === 'gptapi') {
    return await callGPTImage({images, prompt, signal});
  }
  // LOCAL: ComfyUI 경로
  const taskType = (task === 'txt2img') ? 'txt2img'
    : (task === 'inpaint' || task === 'outpaint' || task === 'brush') ? 'inpaint'
    : 'img2img';
  const selectedModelId = getLocalModel(taskType);
  const fallbackModels = getLocalModelFallbacks(taskType, selectedModelId);
  const size = width || getLocalImgSize();
  const H = height || size;
  const seed = Math.floor(Math.random() * 0xffffffff);
  const ctx = { prompt, negative, width: size, height: H, seed, images: [], loras: [], denoise: 0.85 };
  // 이미지 업로드
  if (images && images.length && taskType !== 'txt2img') {
    if (onProgress) onProgress('이미지 업로드 중...');
    for (const img of images) {
      const fn = await uploadImageToComfy(img.b64, img.mime || 'image/png', signal);
      ctx.images.push({filename: fn});
    }
  }
  // 마스크 업로드
  if (mask && taskType === 'inpaint') {
    ctx.mask_filename = await uploadImageToComfy(mask.b64, mask.mime || 'image/png', signal);
  }
  // 태스크별 LoRA 자동 추가
  if (TASK_LORAS[task]) ctx.loras = TASK_LORAS[task];

  let lastError = null;
  let attempt = 0;
  for (const modelId of fallbackModels) {
    attempt += 1;
    const builder = WF_BUILDERS[modelId];
    if (!builder) {
      lastError = new Error('워크플로우 빌더 없음: ' + modelId);
      continue;
    }
    const useCtx = {
      ...ctx,
      loras: TASK_LORAS[task] && modelId.startsWith('qwen-edit') ? ctx.loras : []
    };
    if (onProgress && modelId !== selectedModelId) onProgress('Comfy 모델 변경 시도 (' + attempt + '/' + fallbackModels.length + '): ' + modelId);
    try {
      const workflow = builder(useCtx);
      return await runComfyWorkflow(workflow, signal, onProgress);
    } catch (err) {
      if (err && (err.name === 'AbortError' || /abort/i.test(err.message || ''))) throw err;
      lastError = err;
      if (!shouldFallbackModelOnComfyError(err.message)) break;
      continue;
    }
  }
  throw lastError || new Error('ComfyUI 작업 실패');
}

