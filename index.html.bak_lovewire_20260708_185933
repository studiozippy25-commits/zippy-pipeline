function drawSphere() {
  var canvas = document.getElementById('posCanvas');
  if (!canvas) return;
  var ctx = canvas.getContext('2d');
  var W = canvas.width, H = canvas.height;
  var cx = W/2, cy = H/2, R = W*0.42;

  ctx.clearRect(0, 0, W, H);

  // 배경 그라데이션
  var bg = ctx.createRadialGradient(cx-R*0.25, cy-R*0.25, R*0.05, cx, cy, R);
  bg.addColorStop(0, '#dce0f0'); bg.addColorStop(0.7, '#c8cce0'); bg.addColorStop(1, '#b4b8d0');
  ctx.beginPath(); ctx.arc(cx, cy, R, 0, Math.PI*2);
  ctx.fillStyle = bg; ctx.fill();
  ctx.strokeStyle = '#c0c4da'; ctx.lineWidth = 1.2; ctx.stroke();

  // 고정 뷰 행렬: 정면(0°)이 구 앞쪽 중앙, 살짝 위에서 내려다보는 각도
  var VA = 0 * Math.PI/180, VE = 22 * Math.PI/180;
  var cosA=Math.cos(VA), sinA=Math.sin(VA), cosE=Math.cos(VE), sinE=Math.sin(VE);

  function proj(lon_deg, lat_deg) {
    var lo=lon_deg*Math.PI/180, la=lat_deg*Math.PI/180;
    var x0=Math.cos(la)*Math.sin(lo), y0=Math.sin(la), z0=Math.cos(la)*Math.cos(lo);
    var x1=x0*cosA+z0*sinA, y1=y0, z1=-x0*sinA+z0*cosA;
    var x2=x1, y2=y1*cosE-z1*sinE, z2=y1*sinE+z1*cosE;
    return {sx:cx+x2*R, sy:cy-y2*R, depth:z2};
  }

  ctx.save();
  ctx.beginPath(); ctx.arc(cx, cy, R-1, 0, Math.PI*2); ctx.clip();

  // 경도선
  for (var lon=0; lon<360; lon+=30) {
    ctx.beginPath();
    for (var la=-90; la<=90; la+=6) {
      var p=proj(lon,la);
      if (la===-90) ctx.moveTo(p.sx,p.sy); else ctx.lineTo(p.sx,p.sy);
    }
    ctx.strokeStyle='rgba(100,110,160,0.15)'; ctx.lineWidth=0.4; ctx.stroke();
  }
  // 위도선
  [-60,-30,0,30,60].forEach(function(lat) {
    ctx.beginPath();
    for (var lo2=0; lo2<=360; lo2+=5) {
      var p=proj(lo2,lat);
      if (lo2===0) ctx.moveTo(p.sx,p.sy); else ctx.lineTo(p.sx,p.sy);
    }
    ctx.strokeStyle = lat===0 ? 'rgba(80,90,160,0.28)' : 'rgba(100,110,160,0.12)';
    ctx.lineWidth = lat===0 ? 0.7 : 0.3; ctx.stroke();
  });

  // 앵글별 위도링 + 포지션 도트
  var dotsToDraw = [];
  drawnDotPositions = [];
  var distFactor = DIST_STEPS[Math.max(0,Math.min(3,dialDistVal))].factor;
  ELEVATIONS.forEach(function(elev) {
    var elevSel = [...selectedCombinations].some(function(k){ return k.startsWith(elev.key+':'); });
    var col = ELEV_COLORS[elev.key];
    if (elevSel) {
      ctx.beginPath();
      for (var lo3=0; lo3<=360; lo3+=4) {
        var p=proj(lo3, elev.deg);
        if (lo3===0) ctx.moveTo(p.sx,p.sy); else ctx.lineTo(p.sx,p.sy);
      }
      ctx.strokeStyle = col; ctx.lineWidth = 1.2;
      ctx.globalAlpha = 0.35; ctx.stroke(); ctx.globalAlpha = 1;
    }
    POSITIONS.forEach(function(az) {
      var isSel = selectedCombinations.has(elev.key+':'+az);
      var pt = proj(az, elev.deg);
      // 선택된 점만 거리 스케일 적용
      var dsx = isSel ? cx + (pt.sx - cx) * distFactor : pt.sx;
      var dsy = isSel ? cy + (pt.sy - cy) * distFactor : pt.sy;
      dotsToDraw.push({sx:dsx, sy:dsy, pt:pt, col:col, isSel:isSel, elevSel:elevSel, az:az, elevDeg:elev.deg, elevKey:elev.key});
    });
  });

  dotsToDraw.sort(function(a,b){return a.pt.depth-b.pt.depth;});

  // FOV 라인 (선택된 것만)
  dotsToDraw.forEach(function(d) {
    if (!d.isSel || d.pt.depth < -0.1) return;
    var sdx=cx-d.sx, sdy=cy-d.sy, dLen=Math.sqrt(sdx*sdx+sdy*sdy)||1;
    sdx/=dLen; sdy/=dLen;
    var perpX=-sdy*R*0.12, perpY=sdx*R*0.12;
    ctx.beginPath();
    ctx.moveTo(d.sx, d.sy);
    ctx.lineTo(cx+perpX, cy+perpY);
    ctx.lineTo(cx-perpX, cy-perpY);
    ctx.closePath();
    ctx.fillStyle = d.col; ctx.globalAlpha = 0.10; ctx.fill(); ctx.globalAlpha = 1;
  });

  // 도트 렌더링
  dotsToDraw.forEach(function(d) {
    var r = d.isSel ? 7 : d.elevSel ? 3.5 : 2.5;
    var alpha = d.isSel ? 1 : (d.elevSel ? 0.45 : (d.pt.depth > 0 ? 0.18 : 0.08));
    ctx.globalAlpha = alpha;
    if (d.isSel && d.pt.depth > 0) { ctx.shadowColor = d.col; ctx.shadowBlur = 10; }
    ctx.beginPath(); ctx.arc(d.sx, d.sy, r, 0, Math.PI*2);
    ctx.fillStyle = d.isSel ? d.col : (d.elevSel ? d.col : '#9098b8');
    ctx.fill();
    if (d.isSel) { ctx.strokeStyle = '#fff'; ctx.lineWidth = 1.5; ctx.stroke(); }
    ctx.shadowBlur = 0; ctx.globalAlpha = 1;
    drawnDotPositions.push({sx:d.sx, sy:d.sy, depth:d.pt.depth, elevKey:d.elevKey, az:d.az});
  });

  ctx.restore();

  // 선택된 카메라 점마다 FOV 부채꼴 표시
  var zs = ZOOM_STEPS[Math.max(0,Math.min(5,dialZoomVal))];
  var fovRad = (zs.fov * Math.PI / 180) / 2;
  drawnDotPositions.forEach(function(d) {
    if (!selectedCombinations.has(d.elevKey+':'+d.az)) return;
    if (d.depth < -0.08) return;
    var angle = Math.atan2(cy - d.sy, cx - d.sx); // 피사체 방향
    var sr = 40;
    ctx.beginPath();
    ctx.moveTo(d.sx, d.sy);
    ctx.arc(d.sx, d.sy, sr, angle - fovRad, angle + fovRad);
    ctx.closePath();
    ctx.fillStyle = 'rgba(0,85,179,0.13)'; ctx.fill();
    ctx.strokeStyle = 'rgba(0,102,204,0.6)'; ctx.lineWidth = 0.9; ctx.stroke();
  });

  // 피사체 중심 ★
  ctx.beginPath(); ctx.arc(cx, cy, 6, 0, Math.PI*2);
  ctx.fillStyle = '#e8eaf2'; ctx.fill();
  ctx.strokeStyle = '#9098b8'; ctx.lineWidth = 1.2; ctx.stroke();
  ctx.fillStyle = '#5566aa'; ctx.font = 'bold 7px Space Mono,monospace';
  ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
  ctx.fillText('★', cx, cy);
}

