let selectedLookGrade = '';
let selectedLookLens = '';
let selectedLookArt = '';
function switchLookTab(tab) {
  document.getElementById('look-grade').style.display = tab==='grade' ? '' : 'none';
  document.getElementById('look-lens').style.display = tab==='lens' ? '' : 'none';
  var artEl = document.getElementById('look-art');
  if(artEl) artEl.style.display = tab==='art' ? '' : 'none';
  document.querySelectorAll('.look-tab').forEach(t => {
    var isOn = (tab==='grade' && t.textContent.includes('Color')) || (tab==='lens' && t.textContent.includes('Lens')) || (tab==='art' && t.textContent.includes('Art'));
    t.classList.toggle('on', isOn);
  });
}
function pickLook(el, type) {
  const wasOn = el.classList.contains('on');
  document.querySelectorAll('.look-card[data-look="'+type+'"]').forEach(c => c.classList.remove('on'));
  if (!wasOn) {
    el.classList.add('on');
    if (type==='grade') selectedLookGrade = el.dataset.en;
    else if (type==='lens') selectedLookLens = el.dataset.en;
    else if (type==='art') selectedLookArt = el.dataset.en;
  } else {
    if (type==='grade') selectedLookGrade = '';
    else if (type==='lens') selectedLookLens = '';
    else if (type==='art') selectedLookArt = '';
  }
  updateLookDisplay();
}
function updateLookDisplay() {
  const el = document.getElementById('look-selected');
  if (!el) return;
  const parts = [];
  if (selectedLookGrade) parts.push('Grade: ' + document.querySelector('.look-card[data-look="grade"].on .look-card-name')?.textContent);
  if (selectedLookLens) parts.push('Lens: ' + document.querySelector('.look-card[data-look="lens"].on .look-card-name')?.textContent);
  if (selectedLookArt) parts.push('Art: ' + document.querySelector('.look-card[data-look="art"].on .look-card-name')?.textContent);
  el.textContent = parts.length ? parts.join(' + ') : '';
}
function getLookPrompt() {
  const parts = [];
  if (selectedLookGrade) parts.push(selectedLookGrade);
  if (selectedLookLens) parts.push(selectedLookLens);
  if (selectedLookArt) parts.push(selectedLookArt);
  return parts.join('. ');
}
function applyPreset(shot, angle, lens) {
  document.querySelectorAll('[data-g="shot"]').forEach(c => c.classList.remove('on'));
  const sc = [...document.querySelectorAll('[data-g="shot"]')].find(c => c.textContent.trim().split('\n')[0].trim() === shot);
  if (sc) sc.classList.add('on');
  document.querySelectorAll('[data-g="angle"]').forEach(c => c.classList.remove('on'));
  const ac = [...document.querySelectorAll('[data-g="angle"]')].find(c => c.textContent.trim().split('\n')[0].trim() === angle);
  if (ac) ac.classList.add('on');
  document.querySelectorAll('[data-g="lens"]').forEach(c => c.classList.remove('on'));
  const lc = [...document.querySelectorAll('[data-g="lens"]')].find(c => c.textContent.replace('★','').trim().split('\n')[0].trim() === lens);
  if (lc) lc.classList.add('on');
  autoSelectAper(lens);
  updateBreadcrumb();
}
function selectPreset(lens) {
  document.querySelectorAll('.lens-tab').forEach(t => t.classList.remove('on'));
  const target = [...document.querySelectorAll('.lens-tab')].find(t => t.dataset.lens === lens);
  if (target) { target.classList.add('on'); autoSelectAper(lens); }
  updateVarCount();
}
function selectAllLens(){
  document.querySelectorAll('.lens-tab').forEach(t=>t.classList.add('on'));
  updateVarCount();
}
function updateVarCount(){
  const shots=[...document.querySelectorAll('[data-vg="shot"].on')].length;
  const angles=selectedCombinations.size||1;
  const lenses=[...document.querySelectorAll('.lens-tab.on')].length;
  const perTab=shots*angles;
  document.getElementById('varComboCount').textContent=perTab;
  document.getElementById('lensCount').textContent=lenses;
  document.getElementById('totalCount').textContent=perTab*lenses;
}

