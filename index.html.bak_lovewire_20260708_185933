// Sphere click handler
document.addEventListener('DOMContentLoaded', function() {
  setTimeout(function() {
    const canvas = document.getElementById('relightSphere');
    if (!canvas) return;
    canvas.addEventListener('click', function(e) {
      const rect = canvas.getBoundingClientRect();
      const x = ((e.clientX - rect.left) / rect.width) * 2 - 1;  // -1 to 1
      const y = ((e.clientY - rect.top) / rect.height) * 2 - 1;  // -1 to 1
      relightDirX = Math.max(-1, Math.min(1, x));
      relightDirY = Math.max(-1, Math.min(1, y));
      drawRelightSphere();
      updateRelightUI();
    });
    drawRelightSphere();
  }, 200);
});

function drawRelightSphere() {
  const canvas = document.getElementById('relightSphere');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const W = canvas.width, H = canvas.height;
  const cx = W/2, cy = H/2, R = 70;

  ctx.clearRect(0, 0, W, H);

  // Dark sphere background
  const grad = ctx.createRadialGradient(cx, cy, 0, cx, cy, R);
  grad.addColorStop(0, '#333');
  grad.addColorStop(1, '#111');
  ctx.fillStyle = grad;
  ctx.beginPath();
  ctx.arc(cx, cy, R, 0, Math.PI * 2);
  ctx.fill();

  // Light effect on sphere based on direction
  const lx = cx + relightDirX * R * 0.7;
  const ly = cy + relightDirY * R * 0.7;
  const temp = parseInt(document.getElementById('relightTemp')?.value || 0);
  const intensity = parseInt(document.getElementById('relightInt')?.value || 3);

  // Light color based on temperature
  let lr, lg, lb;
  if (temp < 0) { lr = 180 + temp * 0.5; lg = 200 + temp * 0.3; lb = 255; }
  else { lr = 255; lg = 220 - temp * 0.3; lb = 180 - temp * 1.2; }

  const lightGrad = ctx.createRadialGradient(lx, ly, 0, lx, ly, R * (0.5 + intensity * 0.15));
  lightGrad.addColorStop(0, 'rgba('+lr+','+lg+','+lb+','+(0.3 + intensity * 0.12)+')');
  lightGrad.addColorStop(1, 'rgba('+lr+','+lg+','+lb+',0)');
  ctx.fillStyle = lightGrad;
  ctx.beginPath();
  ctx.arc(cx, cy, R, 0, Math.PI * 2);
  ctx.fill();

  // Sphere outline
  ctx.strokeStyle = 'rgba(217,119,6,.4)';
  ctx.lineWidth = 1.5;
  ctx.beginPath();
  ctx.arc(cx, cy, R, 0, Math.PI * 2);
  ctx.stroke();

  // Cross lines
  ctx.strokeStyle = 'rgba(255,255,255,.1)';
  ctx.lineWidth = 0.5;
  ctx.beginPath();
  ctx.moveTo(cx - R, cy); ctx.lineTo(cx + R, cy);
  ctx.moveTo(cx, cy - R); ctx.lineTo(cx, cy + R);
  ctx.stroke();

  // Light source dot
  ctx.fillStyle = 'rgba('+lr+','+lg+','+lb+',0.9)';
  ctx.beginPath();
  ctx.arc(lx, ly, 8, 0, Math.PI * 2);
  ctx.fill();
  ctx.strokeStyle = '#fff';
  ctx.lineWidth = 2;
  ctx.beginPath();
  ctx.arc(lx, ly, 8, 0, Math.PI * 2);
  ctx.stroke();

  // Sun icon
  ctx.fillStyle = '#fff';
  ctx.font = 'bold 10px sans-serif';
  ctx.textAlign = 'center';
  ctx.textBaseline = 'middle';
  ctx.fillText('☀', lx, ly);

  // Subject dot at center
  ctx.fillStyle = 'rgba(255,255,255,.3)';
  ctx.beginPath();
  ctx.arc(cx, cy, 4, 0, Math.PI * 2);
  ctx.fill();
}

function updateRelightUI() {
  const temp = parseInt(document.getElementById('relightTemp')?.value || 0);
  const intensity = parseInt(document.getElementById('relightInt')?.value || 3);

  // Direction label
  let dirH = relightDirX > 0.3 ? '우측' : relightDirX < -0.3 ? '좌측' : '정면';
  let dirV = relightDirY > 0.3 ? '하단' : relightDirY < -0.3 ? '상단' : '중앙';
  document.getElementById('relightDirLabel').textContent = dirH + ' ' + dirV;

  // Temperature label
  const tempLabels = ['차가운 블루', '쿨톤', '약간 쿨', '중립', '약간 웜', '웜톤', '따뜻한 앰버'];
  const tempIdx = Math.round((temp + 100) / 200 * 6);
  document.getElementById('relightTempLabel').textContent = tempLabels[Math.min(6, Math.max(0, tempIdx))];

  // Intensity label
  const intLabels = ['', '매우 소프트', '소프트', '보통', '하드', '매우 하드'];
