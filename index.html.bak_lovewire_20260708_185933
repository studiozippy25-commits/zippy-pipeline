async function callGtiBridge({images=[], prompt, signal=null, onProgress=null}) {
  const size = document.getElementById('gptImgSize')?.value || 'auto';
  const sourceImages = Array.isArray(images) ? images.filter(function(im) { return im && im.b64; }) : [];
  if (onProgress && sourceImages.length) onProgress('GTI 레퍼런스 압축 중... ' + sourceImages.length + '개');
  let bridgeImages = await prepareImageRefsForJsonBridge(sourceImages, {
    maxRefs: sourceImages.length > 8 ? 6 : 4,
    maxSide: sourceImages.length > 8 ? 512 : 640,
    quality: sourceImages.length > 8 ? 0.66 : 0.72,
    byteBudget: sourceImages.length > 8 ? 5 * 1024 * 1024 : 4 * 1024 * 1024,
    singleRefMaxBytes: sourceImages.length > 8 ? 1200 * 1024 : 1536 * 1024,
