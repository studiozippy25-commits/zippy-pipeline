  } else if (sbFrameHas(rawFrame, ['클로즈업', 'CU', '미디엄 클로즈업', 'MCU'])) {
    variants.push(lens + ' at face level, 70cm-1.2m distance, intimate portrait compression, asymmetric negative space');
  } else if (sbFrameHas(rawFrame, ['인서트', 'INSERT', 'INS'])) {
    variants.push(lens + ' insert framing, 45° top-side angle at 50cm, tactile surface detail visible, table/hand edge in foreground');
  } else if (sbFrameHas(rawFrame, ['OTS', '어깨'])) {
