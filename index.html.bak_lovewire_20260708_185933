function summarizeComfyStatusMessages(messages) {
  if (!Array.isArray(messages) || messages.length === 0) return '';
  const lines = [];
  for (let i = 0; i < messages.length; i++) {
    const entry = messages[i];
    if (!Array.isArray(entry) || entry.length < 2) {
      try { lines.push(JSON.stringify(entry)); } catch(e) {}
      continue;
    }
    const evtType = String(entry[0] || '').trim();
    const payload = entry[1];
    if (evtType === 'execution_error' && payload && typeof payload === 'object') {
      const nodeId = payload.node_id || payload.nodeId || '';
      const title = nodeId ? ('node ' + nodeId) : 'node ?';
      const emsg = payload.exception_message || payload.exception_type || payload.message || payload.type || '';
      if (emsg) {
        lines.push('execution_error [' + title + '] ' + String(emsg).slice(0, 500));
        continue;
      }
    }
    if (typeof payload === 'string') {
      lines.push(evtType + ': ' + payload);
      continue;
    }
    try {
      const txt = JSON.stringify(payload).replace(/\\\"/g, '"').slice(0, 500);
      if (txt) lines.push(evtType + ': ' + txt);
    } catch(e) {}
  }
  return lines.join(' | ');
}
