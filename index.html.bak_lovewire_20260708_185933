}

function isProofOfTasteNoFaceDetailShot(shot) {
  const text = ((shot && shot.frame) || '') + ' ' + ((shot && shot.desc) || '');
  const upper = text.toUpperCase();
  const detail = /ECU|CU|INS|INSERT|MACRO|클로즈업|인서트|초근접|매크로/.test(upper);
  const tactile = /손|손가락|펜|카드|문구|QR|종이|메뉴|오디오|서랍|자물쇠|쇼카드|블로터|LP|그릇|반상|식재료|우산|문자|폰|발|발걸음|손잡이/.test(text);
  const face = /얼굴|표정|눈|시선|미소|웃|입술|눈물|반응|상반신|바스트|초상|portrait|face/i.test(text);
  return !!(detail && tactile && !face);
}

function isProofOfTasteLateShot(shot) {
  if (!shot) return false;
  const scene = Number(shot.scene);
  return Number.isFinite(scene) && scene >= 17;
}

function isProofOfTasteFaceCriticalShot(shot) {
  const text = ((shot && shot.frame) || '') + ' ' + ((shot && shot.desc) || '') + ' ' + ((shot && shot.func) || '');
  return /ECU|CU|클로즈업|얼굴|표정|눈|시선|미소|웃|입술|눈물|반응|상반신|바스트|초상|portrait|face|대사|정면/i.test(text);
}

function hasProofOfTasteVisibleCharacterCue(shot) {
  const text = ((shot && shot.frame) || '') + ' ' + ((shot && shot.desc) || '') + ' ' + ((shot && shot.func) || '');
  if (/@\s*(정우|하윤|오준|이나경|박준)|유정우|서하윤|정우|하윤|오준|이나경|박준/.test(text)) return true;
  if (/두 사람|둘이|투샷|시선이 만난|같은 방향|정면 시선/.test(text)) return true;
  return false;
}

function compactProofOfTasteRefs(images, maxRefs, shot) {
  const limit = Math.max(1, maxRefs || 5);
  const buckets = {face:[], character:[], costume:[], background:[], prop:[], other:[]};
  const seen = {};
  (images || []).forEach(function(img) {
    if (!img || !img.b64) return;
    const sig = (img._type || 'ref') + '|' + (img._label || '') + '|' + String(img.b64).slice(0, 96);
    if (seen[sig]) return;
    seen[sig] = true;
    const t = buckets[img._type] ? img._type : 'other';
    buckets[t].push(img);
  });
  const picked = [];
  const noFaceDetail = isProofOfTasteNoFaceDetailShot(shot);
  const hasVisibleCharacter = hasProofOfTasteVisibleCharacterCue(shot);
  function take(type, cap) {
    (buckets[type] || []).slice(0, cap).forEach(function(img) {
      if (picked.length < limit) picked.push(img);
    });
  }
  if (noFaceDetail) {
    take('prop', Math.min(2, limit));
    take('background', 1);
    take('other', 1);
    return picked.slice(0, Math.min(limit, 3));
  }
  if (isProofOfTasteLateShot(shot)) {
    if (hasVisibleCharacter) {
      if (isProofOfTasteFaceCriticalShot(shot)) take('face', 1);
      else take('character', 1);
      take('background', 1);
      if (picked.length < limit) take('prop', 1);
      if (picked.length < limit) take('costume', 1);
      if (picked.length < limit) take('other', 1);
      return picked.slice(0, Math.min(limit, 3));
    }
    take('background', 1);
    take('prop', 1);
    take('other', 1);
    return picked.slice(0, Math.min(limit, 2));
  }
  if (!hasVisibleCharacter) {
    take('background', 2);
    take('prop', 2);
    take('other', 1);
    return picked.slice(0, Math.min(limit, 3));
  }
  take('face', 1);
  take('character', 1);
  take('costume', 1);
  take('background', 1);
  take('prop', 1);
  take('other', 1);
  return picked.slice(0, Math.min(limit, 4));
}

function estimateImageRefBytes(ref) {
  if (!ref || !ref.b64) return 0;
  return Math.ceil(String(ref.b64).length * 0.75);
}

function dataUrlFromImageRef(ref) {
  if (!ref || !ref.b64) return '';
  return 'data:' + (ref.mime || 'image/png') + ';base64,' + ref.b64;
}

function canvasToJpegRef(ref, img, maxSide, quality) {
  const naturalW = img.naturalWidth || img.width || 0;
  const naturalH = img.naturalHeight || img.height || 0;
  if (!naturalW || !naturalH) return ref;
  const scale = Math.min(1, maxSide / Math.max(naturalW, naturalH));
  const w = Math.max(1, Math.round(naturalW * scale));
  const h = Math.max(1, Math.round(naturalH * scale));
  const canvas = document.createElement('canvas');
  canvas.width = w;
  canvas.height = h;
  const ctx = canvas.getContext('2d', { alpha: false });
  ctx.fillStyle = '#ffffff';
  ctx.fillRect(0, 0, w, h);
  ctx.drawImage(img, 0, 0, w, h);
  const dataUrl = canvas.toDataURL('image/jpeg', quality);
  const comma = dataUrl.indexOf(',');
  if (comma < 0) return ref;
  const next = Object.assign({}, ref, {
    b64: dataUrl.slice(comma + 1),
    mime: 'image/jpeg',
    _compressed: true,
    _sourceMime: ref.mime || 'image/png'
  });
  return estimateImageRefBytes(next) < estimateImageRefBytes(ref) ? next : ref;
}

async function compressImageRefForGeneration(ref, opts) {
  if (!ref || !ref.b64) return null;
  const options = opts || {};
  const maxSide = options.maxSide || 768;
  const quality = options.quality || 0.76;
  const currentBytes = estimateImageRefBytes(ref);
  if (currentBytes <= (options.skipBelowBytes || 350000)) return ref;
  if (typeof Image === 'undefined' || typeof document === 'undefined') return ref;
  try {
    const img = new Image();
    const loaded = new Promise(function(resolve, reject) {
      img.onload = function() { resolve(); };
      img.onerror = function() { reject(new Error('reference decode failed')); };
    });
    img.src = dataUrlFromImageRef(ref);
    await loaded;
    return canvasToJpegRef(ref, img, maxSide, quality);
  } catch(e) {
    return ref;
  }
}

async function prepareProofOfTasteRefsForGeneration(images, shot, opts) {
  const options = opts || {};
  const noFaceDetail = isProofOfTasteNoFaceDetailShot(shot);
  const compacted = compactProofOfTasteRefs(images || [], options.maxRefs || (noFaceDetail ? 3 : 4), shot);
  const byteBudget = options.byteBudget || (8 * 1024 * 1024);
  const out = [];
  let used = 0;
  for (const ref of compacted) {
    const compressed = await compressImageRefForGeneration(ref, {
      maxSide: options.maxSide || (noFaceDetail ? 640 : 768),
      quality: options.quality || 0.76,
      skipBelowBytes: options.skipBelowBytes || 280000
    });
    if (!compressed || !compressed.b64) continue;
    let finalRef = compressed;
    let bytes = estimateImageRefBytes(finalRef);
    if (bytes > byteBudget) {
      finalRef = await compressImageRefForGeneration(finalRef, {
        maxSide: options.fallbackMaxSide || 512,
        quality: options.fallbackQuality || 0.68,
        skipBelowBytes: 0
      });
      bytes = estimateImageRefBytes(finalRef);
    }
    if (out.length && used + bytes > byteBudget) continue;
    if (!out.length && bytes > byteBudget) continue;
    out.push(finalRef);
    used += bytes;
  }
  return out;
}

function isStringLimitError(err) {
  const text = ((err && err.name) || '') + ' ' + ((err && err.message) || String(err || ''));
  return /Invalid string length|RangeError/i.test(text);
}

function imageRefTypeLabel(img) {
  if (!img) return 'Reference';
  if (img._type === 'character') return '인물 (Character)';
  if (img._type === 'face') return '얼굴 (Face)';
  if (img._type === 'costume') return '의상 (Outfit)';
  if (img._type === 'background') return '배경 (Background)';
  if (img._type === 'prop') return '소품 (Prop)';
  return 'Reference';
}

function buildImageRefManifestForPrompt(images) {
  const refs = (images || []).filter(function(im) { return im && im._type && im._label; });
  if (!refs.length) return '';
  let manifestPrefix = 'REFERENCE IMAGES (in order):\n';
  refs.forEach(function(im, idx) {
    manifestPrefix += '  ' + (idx + 1) + '. ' + imageRefTypeLabel(im) + ': ' + (im._label || '') + '\n';
  });
  return manifestPrefix + '\n';
}

async function prepareImageRefsForJsonBridge(images, opts) {
  const options = opts || {};
  const source = Array.isArray(images) ? images.filter(function(ref) { return ref && ref.b64; }) : [];
  const maxRefs = Math.max(0, Number(options.maxRefs || 4));
  if (!source.length || maxRefs <= 0) return [];
  const byteBudget = Number(options.byteBudget || (4 * 1024 * 1024));
  const singleRefMaxBytes = Number(options.singleRefMaxBytes || Math.min(byteBudget, 2 * 1024 * 1024));
  const hardInputMaxBytes = Number(options.hardInputMaxBytes || (24 * 1024 * 1024));
  const sourceLimit = Math.min(source.length, Math.max(maxRefs * 3, 8));
  const out = [];
  let used = 0;
  for (let i = 0; i < sourceLimit && out.length < maxRefs; i++) {
    const original = source[i];
    if (!original || !original.b64) continue;
    if (estimateImageRefBytes(original) > hardInputMaxBytes) {
      console.warn('GTI reference skipped before bridge: too large', original._label || original.name || i);
      continue;
    }
    let ref = original;
    try {
      ref = await compressImageRefForGeneration(original, {
        maxSide: options.maxSide || 640,
        quality: options.quality || 0.72,
        skipBelowBytes: options.skipBelowBytes || 220000
      }) || original;
    } catch(e) {
      ref = original;
    }
    let bytes = estimateImageRefBytes(ref);
    if (bytes > singleRefMaxBytes) {
      try {
        ref = await compressImageRefForGeneration(ref, {
          maxSide: options.fallbackMaxSide || 384,
          quality: options.fallbackQuality || 0.6,
          skipBelowBytes: 0
        }) || ref;
      } catch(e) {}
      bytes = estimateImageRefBytes(ref);
    }
    if (!ref || !ref.b64 || bytes > singleRefMaxBytes) {
      console.warn('GTI reference skipped before bridge: over budget', original._label || original.name || i);
      continue;
    }
    if (used + bytes > byteBudget) continue;
    out.push(ref);
    used += bytes;
  }
  return out;
}

function buildSBRefManifest(images) {
  if (!images || images.length === 0) return '';
  let refManifest = '\nREFERENCE IMAGES (in order):\n';
  images.forEach((img, idx) => {
    const typeLabel = img._type === 'character' ? '인물 (Character)' : img._type === 'background' ? '배경 (Background/Location)' : img._type === 'prop' ? '소품 (Prop)' : img._type === 'costume' ? '의상 (Costume)' : img._type === 'face' ? '얼굴 (Face)' : 'Reference';
    refManifest += `  ${idx+1}. ${typeLabel}: ${img._label || ''}\n`;
  });
  refManifest += '\n';
  return refManifest;
}

function buildProofOfTasteFallbackPrompt(shot, preset, sbCam, spaceDna, costumeDna, charDnaBlock, projNegative) {
  const noFaceDetail = isProofOfTasteNoFaceDetailShot(shot);
  return [
    'CINEMATIC STORYBOARD FRAME — Proof of Taste fallback render',
    'SHOT: ' + (shot.id || ''),
    noFaceDetail ? 'NO FACE VISIBLE: this is a tactile insert/detail shot. Render only hands, object, and surface details. Do not show a face or invent a portrait.' : 'FACE LOCK: if face reference sheets are provided, they are the only authority for facial identity. Do not copy faces from outfit, prop, food, place, or moodboard references.',
    'CAMERA: ' + (sbCam && sbCam.summary ? sbCam.summary : (shot.frame || '')),
    'LOCATION: ' + (resolveShotLoc(shot) || preset.loc || ''),
    'TIME: ' + (shot.time || preset.time || ''),
    'ACTION: ' + (shot.desc || ''),
    'FUNCTION: ' + (shot.func || ''),
    'SUBJECT DNA: ' + (charDnaBlock || '(no visible character)'),
    'COSTUME: ' + (costumeDna || '(default from references and character DNA)'),
    'SPACE DNA: ' + (spaceDna || resolveShotLoc(shot) || preset.loc || ''),
    'STYLE: restrained Korean live-action romance film still, physical set, natural light, Kodak Vision3 500T, visible pores, fabric weave, real props, muted Seongsu palette, one complete frame.',
    'REFERENCE HANDLING: use only the provided few references; do not copy grid layouts or readable text. Generate a single cinematic frame.',
    'NEGATIVE: ' + (projNegative || '') + ', no collage, no text overlay, no logo, no watermark, no CGI, no anime, no plastic skin, no Instagram food styling.'
  ].join('\n');
}

