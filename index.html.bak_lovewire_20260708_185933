const DEFAULT_LOCAL_COMFY_PATH = '/comfy';
function isLegacyComfyDirectUrl(value) {
  const raw = String(value || '').trim();
  if (!raw) return false;
  try {
    const u = new URL(raw);
    const host = String(u.hostname || '').replace(/^\[|\]$/g, '');
    return ['127.0.0.1', 'localhost', '::1'].includes(host) && u.port === '8000';
  } catch(e) {
    return /^(https?:\/\/)?(127\.0\.0\.1|localhost):8000(?:\/|$)/i.test(raw);
  }
}
function normalizeLocal5080GatewayValue(value) {
  const raw = String(value || '').trim();
  if (!raw || isLegacyComfyDirectUrl(raw)) return DEFAULT_LOCAL_VIDEO_GATEWAY;
  let normalized = raw.replace(/\/+$/, '');
  normalized = normalized.replace(/\/comfy$/i, '');
  return normalized || DEFAULT_LOCAL_VIDEO_GATEWAY;
}
function isZippy5080Gateway(value) {
  try { return new URL(normalizeLocal5080GatewayValue(value)).hostname === 'zippy-5080.studiozippy.co.kr'; } catch(e) { return false; }
}
function getComfyGatewayFetchBase(value) {
