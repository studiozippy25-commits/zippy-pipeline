function updateCineAngleS3() {
  const pan = parseInt(document.getElementById('ca-pan-s3').value);
  const tilt = parseInt(document.getElementById('ca-tilt-s3').value);
  const dist = parseInt(document.getElementById('ca-dist-s3').value);
  document.getElementById('ca-pan-s3-val').textContent = pan + '°';
  document.getElementById('ca-tilt-s3-val').textContent = tilt + '°';
  document.getElementById('ca-dist-s3-val').textContent = dist + 'm';
  const output = document.getElementById('ca-output-s3');
  if(output) output.textContent = getCineAnglePromptS3();
  drawCineAngleSphereS3();
}
function setCineAngleS3(pan, tilt, dist) {
  document.getElementById('ca-pan-s3').value = pan;
  document.getElementById('ca-tilt-s3').value = tilt;
  document.getElementById('ca-dist-s3').value = dist;
  updateCineAngleS3();
}
function getCineAnglePromptS3() {
  const pan = parseInt(document.getElementById('ca-pan-s3')?.value || 0);
  const tilt = parseInt(document.getElementById('ca-tilt-s3')?.value || 0);
  const dist = parseInt(document.getElementById('ca-dist-s3')?.value || 3);
  let panDir = 'front';
  if(pan > 150 || pan < -150) panDir = 'behind the subject';
  else if(pan > 90) panDir = 'rear-right (' + pan + '°)';
  else if(pan < -90) panDir = 'rear-left (' + pan + '°)';
  else if(pan > 30) panDir = 'front-right (' + pan + '°)';
  else if(pan < -30) panDir = 'front-left (' + pan + '°)';
  else if(pan > 5) panDir = 'slightly right (' + pan + '°)';
  else if(pan < -5) panDir = 'slightly left (' + pan + '°)';
  else panDir = 'directly in front (0°)';
  let tiltDir = 'eye level';
  if(tilt > 60) tiltDir = 'extreme top-down (' + tilt + '°)';
  else if(tilt > 30) tiltDir = 'high angle (' + tilt + '°)';
  else if(tilt > 5) tiltDir = 'slight high angle (' + tilt + '°)';
  else if(tilt > -5) tiltDir = 'eye level';
  else if(tilt > -30) tiltDir = 'slight low angle (' + tilt + '°)';
  else if(tilt > -60) tiltDir = 'low angle (' + tilt + '°)';
  else tiltDir = 'extreme worm eye (' + tilt + '°)';
  let distDesc = 'medium distance (~' + dist + 'm)';
  if(dist <= 1) distDesc = 'extreme close (~0.5m)';
  else if(dist <= 2) distDesc = 'close (~' + dist + 'm)';
  else if(dist <= 4) distDesc = 'medium (~' + dist + 'm)';
  else if(dist <= 6) distDesc = 'far (~' + dist + 'm)';
  else distDesc = 'very far (~' + dist + 'm+)';
  return 'Camera: ' + panDir + ', ' + tiltDir + ', ' + distDesc;
}
function drawCineAngleSphereS3() {
  const canvas = document.getElementById('ca-sphere-s3');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const W = canvas.width, H = canvas.height;
  const cx = W/2, cy = H/2, R = 60;
  const pan = parseInt(document.getElementById('ca-pan-s3').value) || 0;
  const tilt = parseInt(document.getElementById('ca-tilt-s3').value) || 0;
  const dist = parseInt(document.getElementById('ca-dist-s3').value) || 3;
  ctx.clearRect(0, 0, W, H);
  ctx.strokeStyle = 'rgba(100,116,139,.3)';
  ctx.lineWidth = 1;
  ctx.beginPath(); ctx.arc(cx, cy, R, 0, Math.PI * 2); ctx.stroke();
  ctx.strokeStyle = 'rgba(100,116,139,.15)';
  ctx.beginPath(); ctx.ellipse(cx, cy, R, R * 0.3, 0, 0, Math.PI * 2); ctx.stroke();
  ctx.beginPath(); ctx.ellipse(cx, cy, R * 0.3, R, 0, 0, Math.PI * 2); ctx.stroke();
  ctx.strokeStyle = 'rgba(100,116,139,.1)';
  ctx.beginPath(); ctx.moveTo(cx-R,cy); ctx.lineTo(cx+R,cy); ctx.moveTo(cx,cy-R); ctx.lineTo(cx,cy+R); ctx.stroke();
  ctx.fillStyle = 'rgba(100,116,139,.5)';
  ctx.beginPath(); ctx.arc(cx, cy, 4, 0, Math.PI * 2); ctx.fill();
  const panRad = (pan - 90) * Math.PI / 180;
  const tiltRad = tilt * Math.PI / 180;
  const distScale = 0.5 + (dist / 10) * 0.5;
  const camX = cx + Math.cos(panRad) * Math.cos(tiltRad) * R * distScale;
  const camY = cy - Math.sin(tiltRad) * R * distScale;
  ctx.strokeStyle = 'rgba(14,165,233,.3)'; ctx.lineWidth = 1.5; ctx.setLineDash([3,3]);
  ctx.beginPath(); ctx.moveTo(cx,cy); ctx.lineTo(camX,camY); ctx.stroke(); ctx.setLineDash([]);
  const camSize = 6 + (10 - dist) * 0.4;
  ctx.fillStyle = '#0EA5E9';
  ctx.beginPath(); ctx.arc(camX, camY, camSize, 0, Math.PI * 2); ctx.fill();
  ctx.strokeStyle = '#fff'; ctx.lineWidth = 2;
  ctx.beginPath(); ctx.arc(camX, camY, camSize, 0, Math.PI * 2); ctx.stroke();
  ctx.fillStyle = '#fff'; ctx.font = 'bold 7px "IBM Plex Mono", monospace';
  ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
  ctx.fillText('CAM', camX, camY);
}
document.addEventListener('DOMContentLoaded', function() { setTimeout(drawCineAngleSphereS3, 150); });

