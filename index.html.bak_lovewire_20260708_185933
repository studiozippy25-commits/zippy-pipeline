function setSBActiveEp(epNum) {
  var n = Number(epNum);
  if (!Number.isFinite(n)) n = 0;
  if (!window.__sbActiveEpByProject) window.__sbActiveEpByProject = {};
  window.__sbActiveEpByProject[sbActiveEpProjectKey()] = n;
  try { localStorage.setItem(sbActiveEpProjectKey(), String(n)); } catch(e) {}
}

function getSBActiveEp(epNums, fallbackEp) {
  var key = sbActiveEpProjectKey();
  var raw = window.__sbActiveEpByProject && Object.prototype.hasOwnProperty.call(window.__sbActiveEpByProject, key)
    ? window.__sbActiveEpByProject[key]
    : null;
  if (raw == null) {
    try { raw = localStorage.getItem(key); } catch(e) { raw = null; }
  }
  var n = Number(raw);
  if (Number.isFinite(n)) {
    if (n === 0) return 0;
    if ((epNums || []).indexOf(n) !== -1) return n;
  }
  return fallbackEp;
}

