  if (btn) btn.disabled = true;
  let ok = 0, fail = 0;
  for (let i = 0; i < items.length; i++) {
    if (vbBatchAbort) { vbSetStatus('vbBatchStat', '중지됨 · ' + ok + '/' + items.length, 'var(--wn)'); break; }
    vbSetStatus('vbBatchStat', (i + 1) + '/' + items.length + ' · ' + items[i].charName, 'var(--mu)');
