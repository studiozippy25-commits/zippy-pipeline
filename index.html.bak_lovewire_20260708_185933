}
function getMatchingSpaceAssets(locName) {
  const loc = (locName||'').toLowerCase();
  if (!loc || !currentProject) return [];
  const locNames = currentProject.spaceNames || currentProject.locations || [];
  for (let i = 0; i < locNames.length; i++) {
    const projLoc = (locNames[i]||'').toLowerCase();
    if (!projLoc) continue;
    const tokens = projLoc.replace(/\([^)]+\)/g,'').split(/[\s·,\-/]+/).filter(t=>t.length>=2);
    if (projLoc === loc || loc.includes(projLoc) || projLoc.includes(loc) || tokens.some(t=>loc.includes(t))) {
      const k = 'space-' + (i+1);
      if (assetLib[k] && assetLib[k].length > 0) return assetLib[k];
    }
  }
  return [];
}

function getMatchingSpaceSheetAssets(locName, shot) {
  if (!currentProject || !currentProject.defaultSpaceSheets) return [];
  const entries = Object.keys(currentProject.defaultSpaceSheets);
  const loc = (locName || '').toLowerCase();
  const shotId = shot && shot.id ? String(shot.id) : '';
  const ep = shot && typeof shot.ep !== 'undefined' ? Number(shot.ep) : null;
  const text = ((shot && ((shot.desc || '') + ' ' + (shot.frame || '') + ' ' + (shot.sceneName || ''))) || '').toLowerCase();
  const out = [];

  function addByLabel(label) {
    const idx = entries.indexOf(label);
    if (idx === -1) return;
    const key = 'spacesheet-' + (idx + 1);
    if (!assetLib[key] || assetLib[key].length === 0) return;
    assetLib[key].forEach(function(a) {
      out.push({b64: a.b64, mime: a.mime, name: label + ' 공간시트'});
    });
  }

  if (ep === 7 && /^SH(30[8-9]|31[0-7])$/.test(shotId)) addByLabel('EP7 VR·LAST SHOT 교차 구도');
  if (ep === 12 && /^SH(63[4-9]|64[0-7])$/.test(shotId)) addByLabel('EP12 최심부·N시 송출 구도');

  entries.forEach(function(label, idx) {
    if (out.some(function(a){ return a.name === label + ' 공간시트'; })) return;
    const normalizedLabel = label.toLowerCase().replace(/ep\d+[^\s]*/g, '');
    const tokens = normalizedLabel.split(/[\s·,\-/()]+/).filter(function(t){
      return t.length >= 2 && ['공간시트','구도','내부','방'].indexOf(t) === -1;
    });
    if (tokens.length === 0) return;
    const hitCount = tokens.filter(function(t){ return loc.indexOf(t) !== -1 || text.indexOf(t) !== -1; }).length;
    if (hitCount >= Math.min(2, tokens.length)) {
      const key = 'spacesheet-' + (idx + 1);
      if (assetLib[key] && assetLib[key].length > 0) {
        assetLib[key].forEach(function(a) {
          out.push({b64: a.b64, mime: a.mime, name: label + ' 공간시트'});
        });
      }
    }
  });
  return out.slice(0, 2);
}

