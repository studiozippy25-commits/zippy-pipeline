function shouldGlobalZoomImage(img) {
  if (!img || !img.src) return false;
  if (['globalLbImg','sbLbImg','histModalImg','ipImageViewerImg'].includes(img.id)) return false;
  if (img.closest('#globalLightbox,#sbLightbox,#histModal,#ipImageViewer,.hist-modal')) return false;
  if (img.closest('button,a,label,input,textarea,select')) return false;
  if (img.getAttribute('onclick')) return false;
  const clickableParent = img.closest('[onclick]');
  if (clickableParent) {
    const code = clickableParent.getAttribute('onclick') || '';
    if (/open(?:SB)?Lightbox|openLightbox|openIGLightbox|openHistModal|ipOpenImageViewer/i.test(code)) return false;
  }
  return true;
}

function installGlobalImageZoom() {
  if (window.__zippyGlobalImageZoomBound) return;
  window.__zippyGlobalImageZoomBound = true;
  document.addEventListener('click', function(e) {
    const img = e.target && e.target.closest ? e.target.closest('img') : null;
    if (!shouldGlobalZoomImage(img)) return;
    e.preventDefault();
    e.stopPropagation();
    openLightbox(img.currentSrc || img.src);
  }, true);
  document.addEventListener('mouseover', function(e) {
    const img = e.target && e.target.closest ? e.target.closest('img') : null;
    if (shouldGlobalZoomImage(img)) img.style.cursor = 'zoom-in';
  }, true);
}

if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', installGlobalImageZoom);
} else {
  installGlobalImageZoom();
}

