    if (match) items.push({ charName:vbCleanCharName(match[1]), text:match[2].trim() });
  });
  if (!items.length) { vbSetStatus('vbBatchStat', '"캐릭터: 대사" 형식 줄 없음', 'var(--er)'); return; }
  const out = vb$('vbBatchOut');
