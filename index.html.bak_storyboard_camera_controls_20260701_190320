    if (charNames.length === 0 || (currentProject && currentProject.hasCostumes === false)) {
      costContainer.innerHTML = '';
      if (costHeader) costHeader.style.display = 'none';
    } else {
      if (costHeader) costHeader.style.display = 'block';
      let html = '';
      charNames.forEach(function(name, i) {
        const baseName = name.split(/[\s(（]/)[0];
        const key = 'cos' + (i + 1);
        const cap = key.charAt(0).toUpperCase() + key.slice(1);
        html += '<div style="text-align:center"><div style="font-family:var(--font-mono);font-size:10px;color:var(--mu);margin-bottom:4px" title="' + name + ' 의상">' + baseName + ' 의상</div><div id="sbRef' + cap + '" style="width:100px;height:120px;border:2px dashed var(--bd);border-radius:8px;display:flex;align-items:center;justify-content:center;cursor:pointer;overflow:hidden;background:var(--s2)" onclick="document.getElementById(\'sbRef' + cap + 'Input\').click()"><span style="font-family:var(--font-mono);font-size:16px;color:var(--mu)">+</span></div><input type="file" id="sbRef' + cap + 'Input" accept="image/*" style="display:none" onchange="loadSBRef(\'' + key + '\',this.files)"></div>';
        if (!(key in sbRefs)) { sbRefs[key] = null; sbRefMimes[key] = 'image/png'; }
      });
      costContainer.innerHTML = html;
    }
  }

  // Auto-load default character references (인물 자동 등록)
  if (currentProject.defaultCharRefs) {
    loadDefaultCharRefs();
  }
  // Auto-load default face references (얼굴 6전도 자동 등록)
  if (currentProject.defaultFaceRefs) {
    loadDefaultFaceRefs();
  }
  // Auto-load default costume references (의상 자동 등록)
  if (currentProject.defaultCostumeRefs) {
    loadDefaultCostumeRefs();
  }
  // Auto-load default object references (소품 자동 등록)
  if (currentProject.defaultObjRefs) {
    loadDefaultObjRefs();
  }
  // Auto-load default space references from repo (if defined)
  if (currentProject.defaultSpaceRefs) {
    loadDefaultSpaceRefs();
    loadDefaultSpaceSheets();
  }
}

function loadSBRef(key, files) {
  if (!files || !files.length) return;
  const reader = new FileReader();
  reader.onload = function(e) {
    sbRefs[key] = e.target.result.split(',')[1];
    sbRefMimes[key] = files[0].type || 'image/png';
    const el = document.getElementById('sbRef' + key.charAt(0).toUpperCase() + key.slice(1));
    if (el) el.innerHTML = '<img src="' + e.target.result + '" style="width:100%;height:100%;object-fit:cover">';
  };
  reader.readAsDataURL(files[0]);
}

function importAssetToSB(type) {
  if (type === 'char') {
    // Import character assets from Asset Library
    if (assetLib.char.length > 0) {
      assetLib.char.forEach(function(a, i) {
        if (i < 3) {
          const key = 'char' + (i + 1);
          sbRefs[key] = a.b64;
          sbRefMimes[key] = a.mime;
          const el = document.getElementById('sbRef' + key.charAt(0).toUpperCase() + key.slice(1));
          if (el) el.innerHTML = '<img src="data:' + a.mime + ';base64,' + a.b64 + '" style="width:100%;height:100%;object-fit:cover">';
        }
      });
      alert('Asset Library에서 인물 ' + Math.min(assetLib.char.length, 3) + '개를 가져왔습니다.');
    } else {
      alert('Asset Library에 등록된 인물 에셋이 없습니다.');
    }
  } else if (type === 'space') {
    // Import space assets from Asset Library
    const spaceKeys = ['space-a', 'space-b', 'space-c', 'space-d'];
    const locKeys = ['loc1', 'loc2', 'loc3', 'loc4'];
    let count = 0;
    spaceKeys.forEach(function(sk, i) {
      if (assetLib[sk] && assetLib[sk].length > 0) {
        const a = assetLib[sk][0]; // Take first image from each space
        sbRefs[locKeys[i]] = a.b64;
        sbRefMimes[locKeys[i]] = a.mime;
        const el = document.getElementById('sbRef' + locKeys[i].charAt(0).toUpperCase() + locKeys[i].slice(1));
        if (el) el.innerHTML = '<img src="data:' + a.mime + ';base64,' + a.b64 + '" style="width:100%;height:100%;object-fit:cover">';
        count++;
      }
    });
    if (count > 0) alert('Asset Library에서 장소 ' + count + '개를 가져왔습니다.');
    else alert('Asset Library에 등록된 장소 에셋이 없습니다.');
  } else if (type === 'obj') {
    // Import prop assets from Asset Library (keyed by obj.key)
    const objAssets = (currentProject && currentProject.objectAssets) || [];
    let count = 0;
    objAssets.forEach(function(obj) {
      if (typeof assetLib !== 'undefined' && assetLib[obj.key] && assetLib[obj.key].length > 0) {
        const a = assetLib[obj.key][0];
        sbRefs[obj.key] = a.b64;
        sbRefMimes[obj.key] = a.mime;
        const el = document.getElementById('sbRef' + obj.key.charAt(0).toUpperCase() + obj.key.slice(1));
        if (el) el.innerHTML = '<img src="data:' + a.mime + ';base64,' + a.b64 + '" style="width:100%;height:100%;object-fit:cover">';
        count++;
      }
    });
    if (count > 0) alert('Asset Library에서 소품 ' + count + '개를 가져왔습니다.');
    else alert('Asset Library에 등록된 소품 에셋이 없습니다.');
  }
}

function getSBRefMatchSummary(sceneNum, shotId) {
  const refs = getSBRefsForShot(sceneNum, shotId);
  const summary = {character:0, face:0, costume:0, background:0, prop:0, labels:[]};
  refs.forEach(r => {
    if (r._type && summary[r._type] !== undefined) summary[r._type]++;
    if (r._label) summary.labels.push((r._type||'?') + ':' + r._label);
  });
  return summary;
}

