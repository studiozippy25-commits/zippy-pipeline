async function generateKlingJWT() {
  const ak = document.getElementById('klingAccessKey').value.trim();
  const sk = document.getElementById('klingSecretKey').value.trim();
  // JWT Header
  const header = {alg:'HS256',typ:'JWT'};
  // JWT Payload
  const now = Math.floor(Date.now()/1000);
  const payload = {iss:ak, exp:now+1800, nbf:now-5, iat:now};
  // Base64url encode
  function b64url(obj) {
    return btoa(JSON.stringify(obj)).replace(/\+/g,'-').replace(/\//g,'_').replace(/=+$/,'');
  }
  const headerB64 = b64url(header);
  const payloadB64 = b64url(payload);
  const msg = headerB64 + '.' + payloadB64;
  // HMAC-SHA256 sign
  const encoder = new TextEncoder();
  const keyData = encoder.encode(sk);
  const cryptoKey = await crypto.subtle.importKey('raw', keyData, {name:'HMAC',hash:'SHA-256'}, false, ['sign']);
  const sig = await crypto.subtle.sign('HMAC', cryptoKey, encoder.encode(msg));
  const sigB64 = btoa(String.fromCharCode(...new Uint8Array(sig))).replace(/\+/g,'-').replace(/\//g,'_').replace(/=+$/,'');
  return msg + '.' + sigB64;
}

