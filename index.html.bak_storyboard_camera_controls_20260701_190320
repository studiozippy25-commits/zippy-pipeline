async function callGemini({images, prompt, textOnly=false, resVal='1K', signal=null}){
  const model=getModel();
  const parts=[];
  images.forEach(img => {
    if (img._type && img._label) {
      const typeLabel = img._type === 'character' ? '인물 (Character)' : img._type === 'background' ? '배경 (Background)' : img._type === 'prop' ? '소품 (Prop)' : img._type === 'costume' ? '의상 (Costume)' : img._type === 'face' ? '얼굴 (Face)' : 'Reference';
      parts.push({text: `[REF] ${typeLabel}: ${img._label}`});
    }
    parts.push({inline_data:{mime_type:img.mime,data:img.b64}});
  });
  parts.push({text:prompt});
  const genCfg = textOnly
    ? {responseModalities:['TEXT']}
    : {responseModalities:['IMAGE','TEXT']};
  const body={contents:[{parts}],generationConfig:genCfg};
  const fetchOpts = {method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)};
  if (signal) fetchOpts.signal = signal;
  const res=await fetch(
    `https://pipeline.studiozippy25.workers.dev/proxy/gemini/${model}`,
    fetchOpts
  );
  if(!res.ok){const e=await res.json().catch(()=>({}));throw new Error(e?.error?.message||`HTTP ${res.status}`);}
  const data=await res.json();
  const rp=data?.candidates?.[0]?.content?.parts||[];
  let imgB64=null, textOut='';
  for(const p of rp){
    if(p.inlineData?.mimeType?.startsWith('image/')) imgB64=p.inlineData.data;
    if(p.text) textOut+=p.text;
  }
  return{imgB64,textOut};
}

// 이미지 없이 텍스트 프롬프트만으로 이미지 생성 (사물 6전도 텍스트 전용)
// 텍스트 전용 LLM 호출 — GPT-5.4 우선, 실패 시 Gemini fallback
async function callGeminiTextOnly(prompt) {
  // 1차: GPT-5.4 (가성비 텍스트 작업)
  try {
    const res = await fetch('https://pipeline.studiozippy25.workers.dev/proxy/openai/chat/completions', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        model: 'gpt-5.4',
        messages: [{ role: 'user', content: prompt }]
      })
    });
    if (res.ok) {
      const data = await res.json();
      const textOut = data?.choices?.[0]?.message?.content || '';
      if (textOut) return { imgB64: null, textOut };
    }
  } catch(e) { console.warn('GPT-5.4 fail, falling back to Gemini:', e.message); }

  // Fallback: Gemini
  const model = getModel();
  const body = {
    contents: [{parts:[{text: prompt}]}],
    generationConfig: {responseModalities: ['IMAGE','TEXT']}
  };
  const res = await fetch(
    `https://pipeline.studiozippy25.workers.dev/proxy/gemini/${model}`,
    {method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(body)}
  );
  if (!res.ok) { const e = await res.json().catch(()=>({})); throw new Error(e?.error?.message || `HTTP ${res.status}`); }
  const data = await res.json();
  const rp = data?.candidates?.[0]?.content?.parts || [];
  let imgB64 = null, textOut = '';
  for (const p of rp) {
    if (p.inlineData?.mimeType?.startsWith('image/')) imgB64 = p.inlineData.data;
    if (p.text) textOut += p.text;
  }
  return { imgB64, textOut };
}

