function premiereFcpFrameDuration(fps) {
  if (Math.abs(fps - 23.976) < .01) return '1001/24000s';
  if (Math.abs(fps - 29.97) < .01) return '1001/30000s';
  return '1/' + Math.round(fps || 30) + 's';
}
function premiereExtForMime(mime, fallback) {
  mime = String(mime || '').toLowerCase();
  if (mime.includes('jpeg')) return 'jpg';
  if (mime.includes('png')) return 'png';
  if (mime.includes('webp')) return 'webp';
  if (mime.includes('quicktime')) return 'mov';
  if (mime.includes('webm')) return 'webm';
  if (mime.includes('mp4')) return 'mp4';
  return fallback || 'bin';
}
function premiereSafeName(v) {
  return String(v || 'clip').replace(/[\\/:*?"<>|#%{}^~[\]`]+/g, '_').replace(/\s+/g, '_').replace(/^_+|_+$/g, '').slice(0, 80) || 'clip';
}
function premiereClipFileName(item, index) {
  const ext = item.ext || premiereExtForMime(item.mime, item.type === 'video' ? 'mp4' : 'png');
  return String(index + 1).padStart(3, '0') + '_' + premiereSafeName(item.name || item.label || item.id) + '.' + ext;
}
function premiereAddItem(item) {
  const s = premiereSettings();
  const type = item.type || ((item.mime || '').startsWith('video/') ? 'video' : 'image');
