  const hash = videoB64Hash(b64);
  const ext = videoMimeExt(mime);
  return {
    name: 'zippy_' + safeRole + '_' + safeRequest + '_' + ((index || 0) + 1) + '_' + hash + '.' + ext,
    mime: mime || 'image/png',
    b64: b64 || '',
    hash
  };
}
