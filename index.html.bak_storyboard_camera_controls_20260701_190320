  {enabled:false, pan:45, tilt:0, dist:3, shot:'CU'},
  {enabled:false, pan:-45, tilt:30, dist:5, shot:'WS'},
  {enabled:false, pan:180, tilt:10, dist:3, shot:'MS'}
];
let mcActiveTab = 0;
const MC_SHOTS = ['EWS','WS','FS','MS','MCU','CU','ECU','INS','OTS'];

function initMultiCut() {
  for(let i=0;i<4;i++) buildMcPanel(i);
  updateMcSummary();
}
function buildMcPanel(idx) {
