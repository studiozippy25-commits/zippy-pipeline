async function handleSBDocUpload(files) {
  if (!files || !files.length) return;
  const file = files[0];
  const status = document.getElementById('sbDocStatus');
  if (status) status.textContent = '읽는 중: ' + file.name;
  const ext = file.name.split('.').pop().toLowerCase();
  let text = '';
  try {
    if (ext === 'pdf') {
      if (typeof pdfjsLib === 'undefined') throw new Error('pdf.js 로드 실패');
      const buf = await file.arrayBuffer();
      const pdf = await pdfjsLib.getDocument({data: buf}).promise;
      for (let i = 1; i <= pdf.numPages; i++) {
        const page = await pdf.getPage(i);
        const tc = await page.getTextContent();
        text += tc.items.map(it => it.str).join(' ') + '\n';
      }
    } else if (ext === 'docx') {
      if (typeof mammoth === 'undefined') throw new Error('mammoth.js 로드 실패');
      const buf = await file.arrayBuffer();
      const result = await mammoth.extractRawText({arrayBuffer: buf});
      text = result.value;
    } else if (ext === 'txt' || ext === 'md') {
      text = await file.text();
    } else {
      throw new Error('지원하지 않는 형식: .' + ext + ' (.pdf, .docx, .txt, .md만 가능)');
    }
    if (status) status.textContent = '파싱 중... (' + text.length + ' chars)';
    const parsedShots = parseSBDocText(text);
    if (parsedShots.length === 0) {
      if (status) status.textContent = '✕ 씬을 찾지 못했습니다';
      alert('문서에서 씬 구조를 자동 인식하지 못했습니다.\n\n인식 가능한 패턴:\n• "S 1", "S1", "SCENE 1" 등 씬 번호\n• "핵심 액션", "내용", "설명" 키워드\n• "WS / MS / CU" 등 프레임 표기\n\n쇼트 편집기에서 직접 입력해주세요.');
      return;
    }
    if (!confirm('총 ' + parsedShots.length + '개의 씬을 인식했습니다.\n\n현재 SB_SHOTS를 이 데이터로 교체할까요?\n(편집기에서 검수 후 수정 가능)')) return;
    SB_SHOTS.length = 0;
    parsedShots.forEach(s => SB_SHOTS.push(s));
    buildStoryboardTimeline();
    if (typeof renderSBEditor === 'function') {
      const wrap = document.getElementById('sbEditorWrap');
      if (wrap) { wrap.style.display = 'block'; renderSBEditor(); }
    }
    if (status) status.textContent = '✓ ' + parsedShots.length + '개 씬 적용됨';
  } catch (e) {
    if (status) status.textContent = '✕ ' + e.message;
    alert('문서 파싱 실패: ' + e.message);
  }
}

function parseSBDocText(text) {
  const shots = [];
  // Pattern 1: SCENE 1 / S 1 / S1 followed by content
  // Try splitting by scene markers
  const sceneRegex = /(?:^|\n)\s*(?:SCENE|Scene|S)\s*\.?\s*(\d{1,2})\s*(?:[·\.\-—,/|]|\s)/g;
  const positions = [];
  let m;
