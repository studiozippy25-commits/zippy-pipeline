function premiereSettings() {
  const aspect = document.getElementById('premiereAspect')?.value || '16:9';
  const fps = Number(document.getElementById('premiereFps')?.value || 29.97);
  const stillDuration = Math.max(1, Number(document.getElementById('premiereStillDuration')?.value || 5));
