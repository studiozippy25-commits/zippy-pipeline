function loadRefImg(uid, input) {
  const f = input.files[0]; if (!f) return;
  const r = new FileReader();
  r.onload = function(e) {
    refImgData[uid] = e.target.result;
    const thumb = document.getElementById(`ref-thumb-${uid}`);
    if (thumb) thumb.innerHTML = `<img src="${e.target.result}" style="width:100%;height:100%;object-fit:cover">`;
  };
  r.readAsDataURL(f);
}

