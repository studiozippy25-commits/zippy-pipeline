function sbCharReal(presetKey){
  var real = presetKey.indexOf('\u00B7')!==-1 ? presetKey.split('\u00B7').pop() : presetKey;
  return real.split('(')[0].split('\uFF08')[0].trim();
}
function sbCharKeywords(presetKey){
  var real = sbCharReal(presetKey);
  var kws=[real];
  if (SB_CHAR_ALIAS[real]) kws=kws.concat(SB_CHAR_ALIAS[real]);
  return kws.map(function(k){return (k||'').toLowerCase();}).filter(function(k){return k.length>=2;});
}
function getSBRefsForShot(sceneNum, shotId) {
  const refs = [];
  const preset = SCENE_PRESETS[String(sceneNum)] || {};
  // 쇼트가 지정되면 그 쇼트의 desc/frame만 사용 — 씬 전체 narrative 사용 X
  let matchText = '';
  let _targetShot = null;
  if (shotId && typeof SB_SHOTS !== 'undefined') {
    _targetShot = SB_SHOTS.find(s => s.id === shotId);
    if (_targetShot) {
      matchText = ((_targetShot.desc || '') + ' ' + (_targetShot.frame || '')).toLowerCase();
    }
  }
  // Fallback: 쇼트 정보가 없을 때만 씬 narrative 사용
  if (!matchText) {
    const sceneText = ((preset.scene || '') + ' ' + (preset.desc || '')).toLowerCase();
    let shotsText = '';
    if (typeof SB_SHOTS !== 'undefined') {
      SB_SHOTS.filter(s => s.scene === sceneNum).forEach(s => { shotsText += ' ' + (s.desc || '') + ' ' + (s.frame || ''); });
    }
    matchText = (sceneText + ' ' + shotsText).toLowerCase();
  }
  const sceneFullText = matchText;

  // ── 인물: 쇼트에 등장하는 캐릭터만 ──
  const charNames = getProjectCharNamesForRefs();
  let matchedCharIndices;
  if (_targetShot && Array.isArray(_targetShot.char) && _targetShot.char.length) {
    matchedCharIndices = [];
    charNames.forEach(function(name, i){ if (_targetShot.char.indexOf(name) !== -1) matchedCharIndices.push(i); });
  } else {
    const _matchedByReal = {};
    charNames.forEach(function(name, i) {
      const kws = sbCharKeywords(name);
      if (!kws.some(function(k){ return sceneFullText.indexOf(k) !== -1; })) return;
      const real = sbCharReal(name);
      if (!(real in _matchedByReal)) { _matchedByReal[real] = i; return; }
      const mm = name.match(/[\(（]([^\)）]+)[\)）]/);
      if (mm) { const toks = mm[1].toLowerCase().split(/[\s·,]+/).filter(function(t){return t.length>=1;}); if (toks.some(function(t){return sceneFullText.indexOf(t)!==-1;})) _matchedByReal[real] = i; }
    });
    matchedCharIndices = Object.keys(_matchedByReal).map(function(r){ return _matchedByReal[r]; });
  }
  // 매칭된 캐릭터가 없으면 0명 (establishing 쇼트 등)
  const charIdxToInclude = matchedCharIndices;
  charIdxToInclude.forEach(function(i) {
    const k = 'char' + (i + 1);
    const fk = 'face' + (i + 1);
    const label = (typeof sbCharReal==='function') ? sbCharReal(charNames[i] || ('Character ' + (i+1))) : (charNames[i]||'').split(/[\s(（]/)[0];
    // 얼굴 6전도 먼저 (정체성 락 우선)
    if (sbRefs[fk]) {
      refs.push({inline_data: {mime_type: sbRefMimes[fk], data: sbRefs[fk]}, _type:'face', _label: label + ' 얼굴'});
    }
    // 캐릭터 종합 시트
    if (sbRefs[k]) {
      refs.push({inline_data: {mime_type: sbRefMimes[k], data: sbRefs[k]}, _type:'character', _label: label});
    }
  });
  if (refs.length === 0 && assetLib.char.length > 0) {
    assetLib.char.forEach(function(a, i) {
      refs.push({inline_data: {mime_type: a.mime, data: a.b64}, _type:'character', _label:'Character ' + (i+1)});
    });
  }
  const charCount = refs.length;

  // ── 배경: 씬 장소와 매칭 (정확도 우선: 완전일치 → 부분일치) ──
  const loc = ((_targetShot && resolveShotLoc(_targetShot)) || preset.loc || '').toLowerCase();
  const locNames = (currentProject && (currentProject.spaceNames || currentProject.locations)) || [];
  let locMatched = false;
  if (loc) {
    // 1단계: 완전일치 (foo === foo) 또는 양방향 contains
    let bestIdx = -1;
    for (let i = 0; i < locNames.length; i++) {
      const projLoc = (locNames[i] || '').toLowerCase();
      if (projLoc === loc || (projLoc && (loc.includes(projLoc) || projLoc.includes(loc)))) {
        bestIdx = i; break;
      }
    }
    // 2단계: 토큰 매칭 (단, 괄호 표기는 일치 시에만)
    if (bestIdx === -1) {
      const sceneParen = (loc.match(/\([^)]+\)/) || [''])[0];
      for (let i = 0; i < locNames.length; i++) {
        const projLoc = (locNames[i] || '').toLowerCase();
        const projParen = (projLoc.match(/\([^)]+\)/) || [''])[0];
        // 둘 다 괄호 있으면 같아야 매칭, 한쪽만 있으면 통과, 둘 다 없으면 토큰 매칭
        if (sceneParen && projParen && sceneParen !== projParen) continue;
        const tokens = projLoc.replace(/\([^)]+\)/g, '').split(/[\s·,\-/]+/).filter(t => t.length >= 2);
        if (tokens.some(t => loc.includes(t))) { bestIdx = i; break; }
      }
    }
    if (bestIdx !== -1) {
      const key = 'loc' + (bestIdx + 1);
      if (sbRefs[key]) {
        refs.push({inline_data: {mime_type: sbRefMimes[key], data: sbRefs[key]}, _type:'background', _label: locNames[bestIdx]});
        locMatched = true;
      }
    }
  }
  if (!locMatched && refs.length === charCount) {
    const spaceAssets = (typeof getMatchingSpaceAssets === 'function') ? getMatchingSpaceAssets((_targetShot && resolveShotLoc(_targetShot)) || preset.loc) : [];
    spaceAssets.forEach(function(a) {
      refs.push({inline_data: {mime_type: a.mime, data: a.b64}, _type:'background', _label: preset.loc || 'Background'});
    });
  }
  const spaceSheetAssets = (typeof getMatchingSpaceSheetAssets === 'function') ? getMatchingSpaceSheetAssets((_targetShot && resolveShotLoc(_targetShot)) || preset.loc, _targetShot) : [];
  spaceSheetAssets.forEach(function(a) {
    refs.push({inline_data: {mime_type: a.mime, data: a.b64}, _type:'background', _label: a.name || '공간시트'});
  });

  // ── 소품: 명시 obj 태그 우선, 없으면 씬 설명 토큰 매칭 ──
  const objAssets = (currentProject && currentProject.objectAssets) || [];
  if (objAssets.length > 0) {
    const explicitObjKeys = (_targetShot && Array.isArray(_targetShot.obj)) ? _targetShot.obj : [];
    const hasExplicitObjKeys = explicitObjKeys.length > 0;
    const _PROP_STOP = ['독고탄','서유진','한민재','구태원','최상무','장학침','진홍','공각','카일라','박원장','빅토르','나심','손재주','문신돼지충','약물일진녀','청소부','알파리드','박관리자','독고하은','좌판아주머니','웨스터노이드','이루리','루리','정이든','이든','한소담','소담','최나온','나온','윤세하','세하','강도윤','도윤','백하린','하린','오태경','태경','서단아','단아','황도경','코치','노현성','선생님','쿠레나이','키이로','라켓','코트','사진','컨텍스트','단독','레퍼런스','무기','비히클','소품','주연','빌런','조연','세트','모드','버전','배리에이션','컬러','전체','일반','호버','정장'];
    objAssets.forEach(function(obj, i) {
      const key = obj.key;
      const cleanName = (obj.name || '').replace(/^\[[^\]]*\]\s*/,'').toLowerCase();
      const tokens = cleanName.split(/[\s·,\-/()]+/).filter(function(tk){ return tk.length >= 2 && _PROP_STOP.indexOf(tk)===-1; });
      const allowTokenMatch = !hasExplicitObjKeys && key.indexOf('obj-src04-') !== 0;
      const tokenMatched = allowTokenMatch && tokens.length > 0 && tokens.some(function(tk){ return sceneFullText.includes(tk); });
      const matched = explicitObjKeys.indexOf(key) !== -1 || tokenMatched;
      if (matched && sbRefs[key]) {
        refs.push({inline_data: {mime_type: sbRefMimes[key], data: sbRefs[key]}, _type:'prop', _label: obj.name});
      }
    });
  }
  if (assetLib.obj && assetLib.obj.length > 0) {
    assetLib.obj.forEach(function(a, i) {
      refs.push({inline_data: {mime_type: a.mime, data: a.b64}, _type:'prop', _label: 'Prop ' + (i+1)});
    });
  }

  // ── 의상: 씬에 등장하는 캐릭터별 의상 시트 자동 첨부 ──
  // (캐릭터 매칭 인덱스를 재사용 — 인물 슬롯과 1:1 대응)
  charIdxToInclude.forEach(function(i) {
    const cosKey = 'cos' + (i + 1);
    if (sbRefs[cosKey]) {
      const charName = (charNames[i] || '').split(/[\s(（]/)[0];
      refs.push({inline_data: {mime_type: sbRefMimes[cosKey], data: sbRefs[cosKey]}, _type:'costume', _label: charName + ' 의상'});
    }
  });
  return refs;
}

