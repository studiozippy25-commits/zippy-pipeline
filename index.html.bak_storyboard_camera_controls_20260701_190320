function getRelightPrompt() {
  const temp = parseInt(document.getElementById('relightTemp')?.value || 0);
  const intensity = parseInt(document.getElementById('relightInt')?.value || 3);

  let dirH = relightDirX > 0.3 ? 'from the right side' : relightDirX < -0.3 ? 'from the left side' : 'from the front';
  let dirV = relightDirY > 0.3 ? 'from below' : relightDirY < -0.3 ? 'from above' : 'at eye level';
  if (relightDirX > 0.3 && relightDirY < -0.3) dirH = 'from upper-right';
  if (relightDirX < -0.3 && relightDirY < -0.3) dirH = 'from upper-left';

  let tempDesc = 'neutral white';
  if (temp < -60) tempDesc = 'cold blue moonlight';
  else if (temp < -30) tempDesc = 'cool daylight';
  else if (temp < -10) tempDesc = 'slightly cool';
  else if (temp > 60) tempDesc = 'warm golden amber sunset';
  else if (temp > 30) tempDesc = 'warm tungsten';
  else if (temp > 10) tempDesc = 'slightly warm';

  let intDesc = 'medium';
  if (intensity <= 1) intDesc = 'very soft, diffused, almost shadowless';
  else if (intensity === 2) intDesc = 'soft, gentle shadows';
  else if (intensity === 4) intDesc = 'hard, defined shadows, dramatic contrast';
  else if (intensity >= 5) intDesc = 'extreme hard light, razor-sharp shadows, chiaroscuro';

  return 'Key light positioned ' + dirH + ' ' + dirV + '. Color temperature: ' + tempDesc + '. Light quality: ' + intDesc + '.';
}

